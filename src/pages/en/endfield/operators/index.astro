---
import {getCollection} from "astro:content";
import enGuides from "../../../../data/i18n/en-guides.json";
import EndfieldPlaceholder from "../../../../layouts/EndfieldPlaceholder.astro";
import {getImportedOperator} from "../../../../lib/endfield/operatorData";
import {getOperatorImageUrl} from "../../../../lib/endfield/operatorAssets";
import "../../../../styles/operator-guides.css";
import "../../../../styles/i18n.css";
const published=await getCollection("operator-guides",({data})=>["published","preview"].includes(data.status));
const operators=published.filter(x=>Object.hasOwn(enGuides,x.data.operator)).map(x=>({
 slug:x.data.operator,preview:x.data.status==="preview",game:getImportedOperator(x.data.operator)?.operator,
 name:x.data.displayName??x.data.operator,
 text:enGuides[x.data.operator as keyof typeof enGuides],
})).sort((a,b)=>a.name.localeCompare(b.name,"en"));
---
<EndfieldPlaceholder title="English Arknights: Endfield Operator Guides" kicker="ARKNIGHTS: ENDFIELD · OPERATORS" active="operators" lang="en" description="English operator guides by Ag0n1st, including Si, Typhoeus and Liino: builds, skills, official terminology, roles and team compositions.">
 <main class="op-page section-wrap">
  <span class="op-eyebrow">ARKNIGHTS: ENDFIELD / ENGLISH GUIDES</span>
  <h1 class="op-page-heading">Operator Guides<span class="title-period">.</span></h1>
  <p class="op-muted op-page-intro">Choose an operator for an English breakdown of their mechanics, skill priorities, recommended gear and featured teams.</p>
  <div class="op-grid" aria-label="English operator guides">
   {operators.map(op=><a class="op-card" href={`/en/endfield/operators/${op.slug}/`} aria-label={`View ${op.name} guide in English`}>
     <div class="op-card-art">{op.game?.coverUrl?<img class="op-card-cover" src={getOperatorImageUrl(op.slug,"cover",op.game.coverUrl)} alt={op.name+" character artwork"} loading="lazy" decoding="async"/>:<span class="op-image-placeholder">{op.name}</span>}</div>
     <div class="op-card-info"><h2>{op.name}</h2><div class="op-chip-row">
       <span class="op-chip is-pink">{op.game?.rarity}★</span><span class="op-chip">{op.game?.element}</span><span class="op-chip">{op.game?.class}</span>
       {op.preview && <span class="op-chip is-accent">Preview</span>}
     </div><p class="op-muted">{op.text.seoDescription}</p><div class="op-card-bottom"><span>Read English Guide</span><span aria-hidden="true">↗</span></div></div>
   </a>)}
  </div>
 </main>
</EndfieldPlaceholder>
