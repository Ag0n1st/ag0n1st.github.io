---
import { getCollection, type CollectionEntry, render } from "astro:content";
import EndfieldPlaceholder from "../../../../layouts/EndfieldPlaceholder.astro";
import OperatorGuide from "../../../../components/operator/OperatorGuide.astro";
import { getImportedOperator, getImportedOperatorExtras } from "../../../../lib/endfield/operatorData";
import { localizeOperatorGuide } from "../../../../lib/i18n/operatorGuide";
import { getOperatorImageUrl } from "../../../../lib/endfield/operatorAssets";
import "../../../../styles/operator-guides.css";

export async function getStaticPaths() {
  const entries=await getCollection("operator-guides",({data})=>
    data.status==="published" || data.status==="preview");
  return entries.map(entry=>({
    params:{slug:entry.data.operator},props:{entry}
  }));
}
interface Props {entry:CollectionEntry<"operator-guides">}
const {entry}=Astro.props;
const guide=localizeOperatorGuide(entry.data,"en");
const gameData=getImportedOperator(guide.operator);
const extraData=getImportedOperatorExtras(guide.operator);
const operatorName=guide.displayName ?? guide.operator;
const preview=guide.status==="preview";
const {Content}=await render(entry);
const translatedArticleTail:Record<string,string>={
  typhoeus:"In every encounter, Nature Infliction stacks, Hunting Arrows and SP management matter much more than simply pressing more skills. Mastering these three resources lets Typhoeus reach her potential even without additional potentials.",
  si:"Si combines strong personal Cryo Combo Skill damage with flexible support for Cryo and Heat teams."
};
---
<EndfieldPlaceholder
  title={operatorName+" Guide – Builds, Skills, Weapons & Teams"}
  kicker="ARKNIGHTS: ENDFIELD · OPERATORS"
  active="operators"
  lang="en"
  description={guide.overview.summary}
  noindex={preview}
  image={getOperatorImageUrl(guide.operator,"cover",gameData?.operator.coverUrl)}
>
  <OperatorGuide
    guide={guide}
    operatorName={operatorName}
    gameData={gameData}
    extraData={extraData}
    localized={undefined}
    lang="en"
    preview={preview}
  >
    {translatedArticleTail[guide.operator] && <p class="op-body-copy">{translatedArticleTail[guide.operator]}</p>}
  </OperatorGuide>
</EndfieldPlaceholder>
