     <div class="endfield-intro-actions">
       <a class="button button-primary" href="/en/endfield/operators/">Browse English Operator Guides ↗</a>
       <a class="button button-secondary" href="/en/endfield/">Explore Endfield ↗</a>
     </div>
   </section>
   <section class="endfield-section section-wrap">
     <span class="section-kicker">CHARACTER GUIDES</span>
     <h2>Arknights: Endfield</h2>
