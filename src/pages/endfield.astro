---
import "../styles/global.css";
import EndfieldNav from "../components/EndfieldNav.astro";
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090d" />
    <meta name="description" content="Arknights: Endfield Guides von Ag0n1st – Charaktere, System-Erklärungen, Speedruns, Checkliste und Patch-Countdown." />
    <title>Arknights: Endfield — Ag0n1st</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Ag0n1st – Startseite">
        <img class="wordmark-logo" src="/images/ag0n1st-logo.svg" alt="" aria-hidden="true" />
        <span>Ag0n1st</span>
      </a>

      <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="main-navigation"><span></span><span></span><span></span></button>

      <nav class="main-nav" id="main-navigation" aria-label="Hauptnavigation">
        <a href="/endfield/" aria-current="page">Arknights: Endfield</a>
        <a href="/nte/">Neverness to Everness</a>
        <a href="/about/">About Me</a>
      </nav>

      <a class="header-cta" href="https://twitch.tv/Ag0n1st" target="_blank" rel="noreferrer">
        Twitch <span aria-hidden="true">↗</span>
      </a>
    </header>

    <EndfieldNav active="overview" />

    <main class="endfield-page">
      <section class="endfield-intro section-wrap">
        <span class="section-kicker">ARKNIGHTS: ENDFIELD · AG0N1ST</span>
        <h1>Alles für deinen<br /><span class="endfield-heading-accent">nächsten Fortschritt</span><span class="title-period">.</span></h1>
        <p class="endfield-lead">Charakter-Guides, verständliche System-Erklärungen und praktische Tools – aufgebaut auf meinen Videos und ergänzt um Informationen, die du schnell wiederfinden möchtest.</p>
        <div class="endfield-intro-actions">
          <a class="button button-primary" href="/endfield/charaktere/">Charaktere entdecken <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/endfield/countdown/">Zum Patch-Countdown <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="endfield-section section-wrap">
        <div class="endfield-section-heading"><div><span class="section-kicker">01 / CHARAKTERE</span><h2>Charakter Guides<span class="title-period">.</span></h2></div><span class="endfield-section-note">Builds · Mechaniken · Teams</span></div>
        <p class="endfield-section-copy">Finde den passenden Guide für deinen Operator – von den wichtigsten Mechaniken bis hin zu Builds und Team-Synergien.</p>
        <a class="endfield-feature-link" href="/endfield/charaktere/"><span><strong>Alle Charaktere</strong><small>Zur Charakter-Übersicht</small></span><span class="endfield-link-arrow" aria-hidden="true">↗</span></a>
      </section>
      <section class="endfield-section section-wrap">
        <div class="endfield-section-heading"><div><span class="section-kicker">02 / FABRIK</span><h2>Fabrik Guides<span class="title-period">.</span></h2></div><span class="endfield-section-note">System · Blueprints · Optimierung</span></div>
        <p class="endfield-section-copy">Ein Bereich für verständliche Fabrik-Erklärungen und nachbaubare Lösungen. Dieser Teil wird nach und nach ergänzt.</p>
        <a class="endfield-feature-link" href="/endfield/fabrik/"><span><strong>Fabrik-Bereich</strong><small>Guides und Blueprints</small></span><span class="endfield-link-arrow" aria-hidden="true">↗</span></a>
      </section>
      <section class="endfield-section section-wrap">
        <div class="endfield-section-heading"><div><span class="section-kicker">03 / REKRUTIERUNG</span><h2>Rekrutierung verstehen<span class="title-period">.</span></h2></div></div>
        <p class="endfield-section-copy">Die wichtigsten Grundlagen und Entscheidungen des Rekrutierungssystems verständlich erklärt – mit ergänzendem Video-Guide.</p>
        <a class="endfield-feature-link" href="/endfield/rekrutierung/"><span><strong>Rekrutierungs-Guide</strong><small>System-Erklärung und Tipps</small></span><span class="endfield-link-arrow" aria-hidden="true">↗</span></a>
      </section>
      <section class="endfield-section section-wrap">
        <div class="endfield-section-heading"><div><span class="section-kicker">04 / VEREDELUNG</span><h2>Mehr aus deiner Ausrüstung holen<span class="title-period">.</span></h2></div></div>
        <p class="endfield-section-copy">Eine zentrale Anlaufstelle, um die Veredelung zu verstehen und ihre Möglichkeiten gezielt zu nutzen.</p>
        <a class="endfield-feature-link" href="/endfield/veredelung/"><span><strong>Veredelungs-Guide</strong><small>Mechaniken und sinnvolle Nutzung</small></span><span class="endfield-link-arrow" aria-hidden="true">↗</span></a>
      </section>
      <section class="endfield-section section-wrap">
        <div class="endfield-section-heading"><div><span class="section-kicker">05 / ESSENZEN</span><h2>Essenz-System im Überblick<span class="title-period">.</span></h2></div></div>
        <p class="endfield-section-copy">Die wichtigsten Informationen zum Essenz-System an einem Ort, damit du relevante Details später schnell nachschlagen kannst.</p>
        <a class="endfield-feature-link" href="/endfield/essenzen/"><span><strong>Essenz-Guide</strong><small>Grundlagen und Tipps</small></span><span class="endfield-link-arrow" aria-hidden="true">↗</span></a>
      </section>
      <section class="endfield-section section-wrap">
        <div class="endfield-section-heading"><div><span class="section-kicker">06 / SPEEDRUNS</span><h2>Meine Speedruns<span class="title-period">.</span></h2></div><span class="endfield-section-note">YouTube-Videos</span></div>
        <p class="endfield-section-copy">Bosses und Herausforderungen so schnell wie möglich – eine Sammlung meiner eigenen Runs. Keine Community-Rangliste, sondern meine Runs an einem Ort.</p>
        <a class="endfield-feature-link" href="/endfield/speedruns/"><span><strong>Alle Speedruns</strong><small>Videos und Playlist</small></span><span class="endfield-link-arrow" aria-hidden="true">↗</span></a>
      </section>
      <section class="endfield-section section-wrap">
        <div class="endfield-section-heading"><div><span class="section-kicker">07 / CHECKLISTE</span><h2>Den Überblick behalten<span class="title-period">.</span></h2></div></div>
        <p class="endfield-section-copy">Eine praktische tägliche Checkliste, deren Fortschritt lokal in deinem Browser gespeichert wird – ohne Login und ohne Benutzerkonto.</p>
        <a class="endfield-feature-link" href="/endfield/checkliste/"><span><strong>Checkliste öffnen</strong><small>Deine Aufgaben abhaken</small></span><span class="endfield-link-arrow" aria-hidden="true">↗</span></a>
      </section>
      <section class="endfield-section section-wrap endfield-countdown-teaser">
        <div class="endfield-section-heading"><div><span class="section-kicker">08 / PATCH-COUNTDOWN</span><h2>Das nächste Update rückt näher<span class="title-period">.</span></h2></div></div>
        <p class="endfield-section-copy">Der Countdown bis zur nächsten Version – sobald der offizielle Release-Zeitpunkt feststeht.</p>
        <a class="endfield-feature-link" href="/endfield/countdown/"><span><strong>Zum Patch-Countdown</strong><small>Release-Zeit live verfolgen</small></span><span class="endfield-link-arrow" aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer class="site-footer">
      <nav class="social-links" aria-label="Social Media">
        <a href="https://twitch.tv/Ag0n1st" target="_blank" rel="noreferrer" aria-label="Twitch">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2 1 6v15h5v3h4l3-3h4l6-6V2H4Zm17 12-4 4h-5l-3 3v-3H5V4h16v10ZM10 7h2v6h-2V7Zm5 0h2v6h-2V7Z"/></svg>
        </a>
        <a href="https://youtube.com/@Ag0n1st" target="_blank" rel="noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 7.1a3 3 0 0 0-2.1-2.1C19 4.5 12 4.5 12 4.5s-7 0-8.9.5A3 3 0 0 0 1 7.1 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.9A3 3 0 0 0 3.1 19c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23.5 12a31 31 0 0 0-.5-4.9ZM9.5 15.5v-7l6 3.5-6 3.5Z"/></svg>
        </a>
        <a href="https://linktr.ee/Ag0n1st" target="_blank" rel="noreferrer" aria-label="Alle Socials">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3ZM5 5h6v2H7v10h10v-4h2v6H5V5Z"/></svg>
        </a>
      </nav>
      <a class="footer-wordmark" href="/" aria-label="Ag0n1st Startseite"><img class="wordmark-logo" src="/images/ag0n1st-logo.svg" alt="Ag0n1st Logo" /></a>
      <span class="copyright">© 2025 Ag0n1st. All rights reserved.</span>
    </footer>
    <script>
      const menuButton = document.querySelector(".menu-toggle");
      const mainNav = document.querySelector(".main-nav");
      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isOpen));
        menuButton.setAttribute("aria-label", isOpen ? "Menü öffnen" : "Menü schließen");
        mainNav?.classList.toggle("is-open", !isOpen);
      });
      mainNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        menuButton?.setAttribute("aria-expanded", "false");
        menuButton?.setAttribute("aria-label", "Menü öffnen");
        mainNav?.classList.remove("is-open");
      }));
    </script>
  </body>
</html>
