import { getCollection } from "astro:content";
import "../styles/global.css";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

async function getLatestVideos() {
  const decode = (value: string) =>
    value
      .replace(/&amp;/g, "&")
      .replace(/&lt;/g, "<")
      .replace(/&gt;/g, ">")
      .replace(/&quot;/g, '"')
      .replace(/&#39;|&apos;/g, "'");

  const decodeJsonString = (value: string) => {
    try {
      return JSON.parse('"' + value + '"') as string;
    } catch {
      return decode(value);
    }
  };

  const parseFeed = (feed: string) => {
    const entries = [...feed.matchAll(/<entry>([\s\S]*?)<\/entry>/g)].slice(0, 6);
    return entries.map(([, entry]) => {
      const tag = (name: string) => {
        if (name === "yt:videoId") return entry.match(/<yt:videoId>(.*?)<\/yt:videoId>/s)?.[1] ?? "";
        if (name === "title") return entry.match(/<title>(.*?)<\/title>/s)?.[1] ?? "";
        if (name === "published") return entry.match(/<published>(.*?)<\/published>/s)?.[1] ?? "";
        return "";
      };
      const id = tag("yt:videoId");
      const title = decode(tag("title"));
      const published = tag("published");
      return {
        id,
        title,
        published,
        publishedLabel: "",
        thumbnail: "https://i.ytimg.com/vi/" + id + "/hqdefault.jpg",
        href: "https://www.youtube.com/watch?v=" + id,
      };
    }).filter((video) => video.id && video.title);
  };

  // Parse each YouTube videoRenderer as one JSON object. Looking for a videoId
  // and then searching ahead for the next title can accidentally pair two videos.
  const parseChannelPage = (html: string) => {
    const videos: Array<{
      id: string;
      title: string;
      published: string;
      publishedLabel: string;
      thumbnail: string;
      href: string;
    }> = [];
    const seen = new Set<string>();
    const rendererPattern = /"(?:videoRenderer|gridVideoRenderer)"\s*:\s*\{/g;

    for (const match of html.matchAll(rendererPattern)) {
      const objectStart = (match.index ?? 0) + match[0].lastIndexOf("{");
      let depth = 0;
      let inString = false;
      let escaped = false;
      let objectEnd = -1;

      for (let i = objectStart; i < html.length; i++) {
        const char = html[i];
        if (inString) {
          if (escaped) escaped = false;
          else if (char === "\\") escaped = true;
          else if (char === '"') inString = false;
          continue;
        }
        if (char === '"') inString = true;
        else if (char === "{") depth++;
        else if (char === "}") {
          depth--;
          if (depth === 0) {
            objectEnd = i + 1;
            break;
          }
        }
      }
      if (objectEnd < 0) continue;

      // Read metadata only within this renderer, so IDs and titles cannot cross-pair.
      const renderer = html.slice(objectStart, objectEnd);
      const id = renderer.match(/"videoId":"([a-zA-Z0-9_-]{11})"/)?.[1] ?? "";
      const titleMatch = renderer.match(/"title":\{"runs":\[\{"text":"((?:\\\\.|[^"\\\\])*)"/) ?? renderer.match(/"title":\{"simpleText":"((?:\\\\.|[^"\\\\])*)"/);
      if (!id || !titleMatch || seen.has(id)) continue;

      const title = decodeJsonString(titleMatch[1]);
      const timeMatch = renderer.match(/"publishedTimeText":\{"simpleText":"((?:\\.|[^"\\])*)"/);
      const publishedValue = timeMatch ? decodeJsonString(timeMatch[1]) : "";
      if (!title) continue;
      seen.add(id);
      videos.push({
        id,
        title,
        published: "",
        publishedLabel: publishedValue,
        thumbnail: "https://i.ytimg.com/vi/" + id + "/hqdefault.jpg",
        href: "https://www.youtube.com/watch?v=" + id,
      });
      if (videos.length >= 6) break;
    }
    return videos;
  };

  const getPublishedLabelForVideo = (html: string, targetId: string) => {
    const rendererPattern = /"(?:videoRenderer|gridVideoRenderer)"\s*:\s*\{/g;
    for (const match of html.matchAll(rendererPattern)) {
      const objectStart = (match.index ?? 0) + match[0].lastIndexOf("{");
      let depth = 0;
      let inString = false;
      let escaped = false;
      let objectEnd = -1;
      for (let i = objectStart; i < html.length; i++) {
        const char = html[i];
        if (inString) {
          if (escaped) escaped = false;
          else if (char === "\\") escaped = true;
          else if (char === '"') inString = false;
          continue;
        }
        if (char === '"') inString = true;
        else if (char === "{") depth++;
        else if (char === "}") {
          depth--;
          if (depth === 0) {
            objectEnd = i + 1;
            break;
          }
        }
      }
      if (objectEnd < 0) continue;
      const renderer = html.slice(objectStart, objectEnd);
      const id = renderer.match(/"videoId":"([a-zA-Z0-9_-]{11})"/)?.[1] ?? "";
      if (id !== targetId) continue;
      const timeMatch = renderer.match(/"publishedTimeText":\{"simpleText":"((?:\\.|[^"\\])*)"/);
      return timeMatch ? decodeJsonString(timeMatch[1]) : "";
    }
    return "";
  };

  try {
    // Resolve the channel ID from a known video uploaded by Ag0n1st.
    // On a video page, videoDetails.channelId belongs to that exact upload,
    // unlike generic channelId values on a channel page that may refer to recommendations.
    let videoPageChannelId = "";
    let referenceVideo: {
      id: string;
      title: string;
      published: string;
      publishedLabel: string;
      thumbnail: string;
      href: string;
    } | null = null;
    try {
      const videoResponse = await fetch("https://www.youtube.com/watch?v=wNVJkGzkfMg", {
        headers: { "User-Agent": "Mozilla/5.0" },
        signal: AbortSignal.timeout(10000),
        cache: "no-store",
      });
      if (videoResponse.ok) {
        const videoHtml = await videoResponse.text();
        // Extract each embedded JSON object with brace/string awareness. A broad
        // regex can accidentally pick up a chapter title (for example "18")
        // from elsewhere on the page instead of the actual video title.
        const extractObject = (key: string) => {
          const marker = '"' + key + '":{';
          const markerIndex = videoHtml.indexOf(marker);
          if (markerIndex < 0) return "";
          const objectStart = markerIndex + marker.length - 1;
          let depth = 0;
          let inString = false;
          let escaped = false;
          for (let i = objectStart; i < videoHtml.length; i++) {
            const char = videoHtml[i];
            if (inString) {
              if (escaped) escaped = false;
              else if (char === "\\") escaped = true;
              else if (char === '"') inString = false;
              continue;
            }
            if (char === '"') inString = true;
            else if (char === "{") depth++;
            else if (char === "}") {
              depth--;
              if (depth === 0) return videoHtml.slice(objectStart, i + 1);
            }
          }
          return "";
        };
        const details = extractObject("videoDetails");
        const titleRaw = details.match(/"title":"((?:\\\\.|[^"\\\\])*)"/)?.[1];
        const title = titleRaw ? decodeJsonString(titleRaw) : "";
        const microformat = extractObject("playerMicroformatRenderer");
        // YouTube can place the publication date in different parts of the
        // watch-page metadata. Search the full page as well as the microformat
        // object so the fallback card still gets a date when object parsing varies.
        const dateRaw =
          microformat.match(/"publishDate"\s*:\s*"(\d{4}-\d{2}-\d{2})"/)?.[1] ??
          microformat.match(/"uploadDate"\s*:\s*"(\d{4}-\d{2}-\d{2})"/)?.[1] ??
          videoHtml.match(/"publishDate"\s*:\s*"(\d{4}-\d{2}-\d{2})"/)?.[1] ??
          videoHtml.match(/"uploadDate"\s*:\s*"(\d{4}-\d{2}-\d{2})"/)?.[1] ??
          videoHtml.match(/"datePublished"\s*:\s*"(\d{4}-\d{2}-\d{2})"/)?.[1] ??
          videoHtml.match(/<meta[^>]+itemprop=["']datePublished["'][^>]+content=["'](\d{4}-\d{2}-\d{2})/i)?.[1] ??
          videoHtml.match(/<meta[^>]+content=["'](\d{4}-\d{2}-\d{2})[^>]+itemprop=["']datePublished["']/i)?.[1] ??
          "";
        // Some YouTube watch pages omit publishDate/uploadDate but still expose
        // a human-readable upload date in videoPrimaryInfoRenderer.dateText.
        const dateTextRaw =
          videoHtml.match(/"dateText"\s*:\s*\{\s*"simpleText"\s*:\s*"([^"]*)"/)?.[1] ??
          videoHtml.match(/"dateText"\s*:\s*\{\s*"runs"\s*:\s*\[\s*\{\s*"text"\s*:\s*"([^"]*)"/)?.[1] ??
          "";
        videoPageChannelId = details.match(/"channelId":"(UC[\w-]+)"/)?.[1] ?? "";
        if (title) {
          referenceVideo = {
            id: "wNVJkGzkfMg",
            title,
            published: dateRaw,
            publishedLabel: dateRaw
              ? new Date(dateRaw + "T12:00:00Z").toLocaleDateString("de-DE", { day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" })
              : dateTextRaw
                ? decodeJsonString(dateTextRaw)
                : "",
            thumbnail: "https://i.ytimg.com/vi/wNVJkGzkfMg/hqdefault.jpg",
            href: "https://www.youtube.com/watch?v=wNVJkGzkfMg",
          };
        }
      }
    } catch (error) {
      console.warn("Metadaten konnten nicht aus dem Referenzvideo gelesen werden:", error);
    }

    // If YouTube serves the watch page but omits its embedded metadata, use its
    // public oEmbed endpoint for the exact current title. oEmbed does not expose
    // publication dates, so the date remains sourced from the watch-page metadata.

    const channelResponse = await fetch("https://www.youtube.com/@Ag0n1st/videos", {
      headers: { "User-Agent": "Mozilla/5.0" },
      signal: AbortSignal.timeout(10000),
    });
    if (!channelResponse.ok) throw new Error("YouTube-Kanal konnte nicht geladen werden");
    const channelHtml = await channelResponse.text();
    // The watch page sometimes omits publishDate. In that case, get YouTube's
    // own relative upload label for this exact video from its channel renderer.
    if (referenceVideo && !referenceVideo.publishedLabel) {
      referenceVideo.publishedLabel = getPublishedLabelForVideo(channelHtml, referenceVideo.id);
    }
    // Prefer the ID from the known upload, then the channel's own metadata.
    const channelId =
      videoPageChannelId ||
      channelHtml.match(/itemprop="identifier" content="(UC[\w-]+)"/)?.[1] ||
      channelHtml.match(/"externalId":"(UC[\w-]+)"/)?.[1] ||
      channelHtml.match(/"channelId":"(UC[\w-]+)"/)?.[1];

    console.warn("YouTube-Diagnose:", JSON.stringify({
      channelId: channelId || null,
      referenceVideoFound: Boolean(referenceVideo),
      referenceTitleFound: Boolean(referenceVideo?.title),
      videoPageChannelIdFound: Boolean(videoPageChannelId),
      channelHtmlLength: channelHtml.length,
      channelRendererVideos: parseChannelPage(channelHtml).length,
      channelHtmlHasConsentScreen: /consent\\.youtube\\.com|Before you continue to YouTube|consentCookieIframe/i.test(channelHtml),
      channelHtmlHasVideoRenderer: channelHtml.includes('"videoRenderer"'),
      channelHtmlHasRichGrid: channelHtml.includes('"richGridRenderer"'),
      gridVideoRendererCount: (channelHtml.match(/"gridVideoRenderer"\\s*:/g) || []).length,
      videoIdCount: (channelHtml.match(/"videoId"\\s*:/g) || []).length,
      videoRendererSnippet: (() => {
        const index = channelHtml.indexOf('"gridVideoRenderer"');
        return index >= 0 ? channelHtml.slice(index, index + 900) : channelHtml.slice(channelHtml.indexOf('"richGridRenderer"'), channelHtml.indexOf('"richGridRenderer"') + 900);
      })().replace(/\\s+/g, " "),
    }));

    if (channelId) {
      // Retry transient RSS failures before falling back to the channel page.
      for (let attempt = 0; attempt < 3; attempt++) {
        try {
          const feedResponse = await fetch(
            "https://www.youtube.com/xml/feeds/videos.xml?channel_id=" + channelId,
            {
              headers: { "User-Agent": "Mozilla/5.0 (compatible; Ag0n1stWebsite/1.0)" },
              signal: AbortSignal.timeout(10000),
              cache: "no-store",
            },
          );
          const feedBody = await feedResponse.text();
          const videos = parseFeed(feedBody);
          if (videos.length > 0) return videos;
          console.warn("YouTube-Feed-Diagnose:", JSON.stringify({
            status: feedResponse.status,
            contentType: feedResponse.headers.get("content-type"),
            bodyLength: feedBody.length,
            bodyStart: feedBody.slice(0, 240).replace(/\\s+/g, " "),
            hasEntry: /<entry(?:\\s|>)/i.test(feedBody),
            hasVideoId: /<yt:videoId>/i.test(feedBody),
            requestedChannelId: channelId,
          }));
          if (!feedResponse.ok) throw new Error("YouTube-Feed antwortete mit HTTP " + feedResponse.status);
          throw new Error("YouTube-Feed enthält keine Videos");
        } catch (error) {
          console.warn("YouTube-Feed-Versuch " + (attempt + 1) + "/3 fehlgeschlagen:", error);
          if (attempt < 2) await new Promise((resolve) => setTimeout(resolve, 500 * (attempt + 1)));
        }
      }
    } else {
      console.warn("YouTube-Kanal-ID nicht gefunden; versuche Video-Metadaten aus der Kanalseite zu lesen.");
    }

    const fallbackVideos = parseChannelPage(channelHtml);
    if (fallbackVideos.length > 0) {
      console.warn("YouTube-RSS nicht verfügbar; verwende Video-Metadaten der Kanalseite als Fallback.");
      return fallbackVideos;
    }

    // Last-resort display fallback: keep the video section populated even if
    // YouTube blocks feed/page metadata during the static build. This is a
    // confirmed video link supplied by the channel owner; normal feeds still
    // take precedence whenever available.
    if (referenceVideo) {
      console.warn("Feed/Kanalseite nicht verfügbar; verwende echte Metadaten des Referenzvideos.");
      return [referenceVideo];
    }

    // Final metadata fallback: request YouTube's public oEmbed endpoint for the
    // exact title rather than displaying a made-up placeholder. oEmbed does not
    // provide a publication date; leave it blank if the watch-page date was blocked.
    try {
      const oembedResponse = await fetch(
        "https://www.youtube.com/oembed?format=json&url=" +
          encodeURIComponent("https://www.youtube.com/watch?v=wNVJkGzkfMg"),
        { headers: { "User-Agent": "Mozilla/5.0" }, signal: AbortSignal.timeout(10000), cache: "no-store" },
      );
      if (oembedResponse.ok) {
        const metadata = await oembedResponse.json();
        if (typeof metadata.title === "string" && metadata.title.trim()) {
          return [{
            id: "wNVJkGzkfMg",
            title: metadata.title,
            published: "",
            publishedLabel: "",
            thumbnail: "https://i.ytimg.com/vi/wNVJkGzkfMg/hqdefault.jpg",
            href: "https://www.youtube.com/watch?v=wNVJkGzkfMg",
          }];
        }
      }
    } catch (error) {
      console.warn("YouTube-oEmbed-Fallback fehlgeschlagen:", error);
    }

    console.warn("YouTube-Metadaten sind beim Build nicht erreichbar; kein Platzhaltertitel wird ausgegeben.");
    return [];
  } catch (error) {
    console.warn("YouTube-Videos konnten beim Build nicht geladen werden:", error);
    return [];
  }
}

const videos = await getLatestVideos();
