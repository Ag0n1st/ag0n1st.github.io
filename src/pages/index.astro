    <script>
      const statusPill = document.querySelector("#twitch-status");
      const statusText = statusPill?.querySelector(".live-text");

      async function refreshTwitchStatus() {
        if (!statusPill || !statusText) return;
        try {
          const response = await fetch("https://decapi.me/twitch/uptime/Ag0n1st?offline_msg=offline", { cache: "no-store" });
          if (!response.ok) throw new Error("Twitch-Status nicht verfügbar");
          const result = (await response.text()).trim().toLowerCase();
          const isLive = result.length > 0 && !result.includes("offline") && !result.includes("not live") && !result.includes("error");
          statusPill.dataset.state = isLive ? "live" : "offline";
          statusText.textContent = isLive ? "LIVE" : "OFFLINE";
        } catch {
          statusPill.dataset.state = "offline";
          statusText.textContent = "OFFLINE";
        }
      }

      refreshTwitchStatus();
      window.setInterval(refreshTwitchStatus, 60_000);

      const formatRelativeTime = (dateString) => {
        const seconds = Math.max(0, Math.floor((Date.now() - new Date(dateString).getTime()) / 1000));
        if (seconds < 60) return "vor wenigen Sek.";
        if (seconds < 3600) return `vor ${Math.floor(seconds / 60)} Min.`;
        if (seconds < 86400) return `vor ${Math.floor(seconds / 3600)} Std.`;
        if (seconds < 86400 * 30) return `vor ${Math.floor(seconds / 86400)} Tg.`;
        if (seconds < 86400 * 365) return `vor ${Math.floor(seconds / (86400 * 30))} Mon.`;
        return `vor ${Math.floor(seconds / (86400 * 365))} J.`;
      };
      document.querySelectorAll("[data-relative-time], [data-relative-label]").forEach((element) => {
        const published = element.getAttribute("data-relative-time");
        if (published && !Number.isNaN(new Date(published).getTime())) {
          const update = () => { element.textContent = formatRelativeTime(published); };
          update();
          window.setInterval(update, 60_000);
        } else {
          // Keep YouTube's relative label (e.g. "vor 2 Tagen") for HTML-fallback videos.
          const label = element.getAttribute("data-relative-label");
          if (label) element.textContent = label;
        }
      });
    </script>
