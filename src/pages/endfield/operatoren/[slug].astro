---
import { getCollection, render, type CollectionEntry } from "astro:content";
import EndfieldPlaceholder from "../../../layouts/EndfieldPlaceholder.astro";
import OperatorGuide from "../../../components/operator/OperatorGuide.astro";
import { getImportedOperator, getImportedOperatorExtras } from "../../../lib/endfield/operatorData";
import { getOperatorLocale } from "../../../lib/endfield/operatorLocale";
import "../../../styles/operator-guides.css";

export async function getStaticPaths() {
  const entries = await getCollection("operator-guides");
  // Show only published guides and explicitly marked layout previews.
  return entries
    .filter(entry => entry.data.status === "published" || entry.data.status === "preview")
    .map(entry => {
      if (entry.id.replace(/\.md$/i, "") !== entry.data.operator) {
        throw new Error('Operator-Guide-Datei "' + entry.id + '.md" muss denselben Slug wie "operator: ' + entry.data.operator + '" besitzen.');
      }
      return { params: { slug: entry.data.operator }, props: { entry } };
    });
}

interface Props { entry: CollectionEntry<"operator-guides">; }
const { entry } = Astro.props;
const guide = entry.data;
const gameData = getImportedOperator(guide.operator);
const extraData = getImportedOperatorExtras(guide.operator);
const localized = getOperatorLocale(guide.operator,gameData?.source.snapshot);
const operatorName = guide.displayName ?? guide.operator.split("-").map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(" ");
const { Content } = await render(entry);
const isPreview = guide.status === "preview";
---
<EndfieldPlaceholder
  title={operatorName + " Guide"}
  kicker="ARKNIGHTS: ENDFIELD · OPERATOREN"
  active="operators"
  noindex={isPreview}
  description={guide.overview.summary || operatorName + " – Guide, Skills, Waffen, Builds und Teams."}
>
  <OperatorGuide guide={guide} operatorName={operatorName} gameData={gameData} extraData={extraData} localized={localized} preview={isPreview}>
    <Content />
  </OperatorGuide>
</EndfieldPlaceholder>
