---
import { getCollection } from "astro:content";
import EndfieldPlaceholder from "../../../layouts/EndfieldPlaceholder.astro";
import "../../../styles/operator-guides.css";

// Every published guide is included automatically; Typhoeus is our one
// explicitly visible prototype, even though its editorial file is still a draft.
const entries = await getCollection("operator-guides", ({ data }) =>
  data.status === "published" || data.operator === "typhoeus"
);
const operators = entries.map(entry => ({
  name: entry.data.displayName ?? entry.data.operator.split("-").map(part => part[0].toUpperCase() + part.slice(1)).join(" "),
  slug: entry.data.operator,
  preview: entry.data.status === "draft",
})).sort((a,b) => a.name.localeCompare(b.name, "de"));

---
<EndfieldPlaceholder title="Operatoren" kicker="ARKNIGHTS: ENDFIELD · OPERATOREN" active="characters" description="Operatoren und meine Charakter-Guides auf einen Blick.">
  <main class="op-page section-wrap">
    <span class="op-eyebrow">ARKNIGHTS: ENDFIELD / GUIDES</span>
    <h1 class="op-page-heading">Operatoren<span class="title-period">.</span></h1>
    <p class="op-muted op-page-intro">Wähle einen Operator aus, um seinen Guide mit Builds, Fertigkeiten, Teams und Gameplay zu öffnen.</p>
    <div class="op-grid" aria-label="Operatoren">
      {operators.map((operator) => (
        <a class="op-card" href={`/endfield/operatoren/${operator.slug}/`} aria-label={`Guide für ${operator.name} öffnen`}>
          <div class="op-card-art"><span class="op-image-placeholder">[Operator-Grafik]<br />{operator.name}</span></div>
          <div class="op-card-info">
            <h2>{operator.name}</h2>
            <div class="op-chip-row">
              <span class="op-chip is-pink">{operator.slug === "typhoeus" ? "6★" : "[Seltenheit]"}</span>
              <span class="op-chip">[Klasse]</span>
              <span class="op-chip">[Element]</span>
              {operator.preview && <span class="op-chip is-accent">Layout-Vorschau</span>}
            </div>
            <div class="op-card-bottom"><span>Charakter-Guide ansehen</span><span aria-hidden="true">↗</span></div>
          </div>
        </a>
      ))}
    </div>
    {operators.length === 0 && <p class="op-muted">Noch keine veröffentlichten Operator-Guides vorhanden.</p>}
  </main>
</EndfieldPlaceholder>
