<script>
  function setupButtons(buttonAttribute: string, panelAttribute: string) {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-" + buttonAttribute + "]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-" + panelAttribute + "]"));
    function activate(id: string) {
      buttons.forEach(button => button.setAttribute("aria-pressed", String(button.dataset[buttonAttribute.replace(/-([a-z])/g,(_,c)=>c.toUpperCase())]===id)));
      panels.forEach(panel => panel.hidden = panel.dataset[panelAttribute.replace(/-([a-z])/g,(_,c)=>c.toUpperCase())]!==id);
    }
    buttons.forEach(button=>button.addEventListener("click",()=>activate(button.getAttribute("data-"+buttonAttribute)||"")));
    return activate;
  }
  setupButtons("weapon-button","weapon-panel");
  const showBuild = setupButtons("build-button","build-panel");
  setupButtons("potential-button","potential-panel");
  setupButtons("showcase-button","showcase-panel");
  document.querySelectorAll<HTMLButtonElement>("[data-team-filter]").forEach(button=>{
    button.addEventListener("click",()=>{
      const value=button.dataset.teamFilter||"all";
      document.querySelectorAll<HTMLButtonElement>("[data-team-filter]").forEach(b=>b.setAttribute("aria-pressed",String(b===button)));
      document.querySelectorAll<HTMLElement>("[data-team-role]").forEach(card=>card.hidden=value!=="all"&&card.dataset.teamRole!==value);
    });
  });
  document.querySelectorAll<HTMLAnchorElement>("[data-select-build]").forEach(link=>{
    link.addEventListener("click",()=>showBuild(link.dataset.selectBuild||"main"));
  });
  const level=document.querySelector<HTMLSelectElement>("#op-level");
  const factory=document.querySelector<HTMLSelectElement>("#op-factory");
  const config=document.querySelector<HTMLElement>("#op-build-config");
  function updateConfig(){if(config&&level&&factory){config.textContent="Lv. "+level.value+" · "+(factory.selectedOptions[0]?.textContent||"");}}
  level?.addEventListener("change",updateConfig);
  factory?.addEventListener("change",updateConfig);
</script>
