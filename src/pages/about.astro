---
import "../styles/global.css";
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090d" />
    <title>About Me — Ag0n1st</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Ag0n1st – Startseite">
        <img class="wordmark-logo" src="/images/ag0n1st-logo.svg" alt="" aria-hidden="true" />
        <span>Ag0n1st</span>
      </a>

      <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="main-navigation"><span></span><span></span><span></span></button>

      <nav class="main-nav" id="main-navigation" aria-label="Hauptnavigation">
        <a href="/endfield/">Arknights: Endfield</a>
        <a href="/nte/">Neverness to Everness</a>
        <a href="/about/">About Me</a>
      </nav>

      <a class="header-cta" href="https://twitch.tv/Ag0n1st" target="_blank" rel="noreferrer">
        Twitch <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main class="placeholder-page"><section class="placeholder-card"><span class="section-kicker">ABOUT ME</span><h1>Mehr über Ag0n1st<span class="title-period">.</span></h1><p>Diese Seite wird später mit Infos zu mir, meinen Projekten und Kooperationsmöglichkeiten ergänzt.</p><a class="back-home" href="/">← Zurück zur Startseite</a></section></main>
    <footer class="site-footer"><nav class="social-links" aria-label="Social Media"><a href="https://twitch.tv/Ag0n1st" aria-label="Twitch">TW</a><a href="https://youtube.com/@Ag0n1st" aria-label="YouTube">YT</a><a href="https://linktr.ee/Ag0n1st" aria-label="Alle Socials">↗</a></nav><a class="footer-wordmark" href="/">Ag0n1st<span class="title-period">.</span></a><span class="copyright">© 2025 Ag0n1st. All rights reserved.</span></footer>

    <script>
      const menuToggle = document.querySelector(".menu-toggle");
      const mainNav = document.querySelector("#main-navigation");
      function setMenuOpen(open) {
        if (!menuToggle || !mainNav) return;
        menuToggle.setAttribute("aria-expanded", String(open));
        menuToggle.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
        mainNav.classList.toggle("is-open", open);
      }
      menuToggle?.addEventListener("click", () => setMenuOpen(menuToggle.getAttribute("aria-expanded") !== "true"));
      mainNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));
    </script>
  </body>
</html>