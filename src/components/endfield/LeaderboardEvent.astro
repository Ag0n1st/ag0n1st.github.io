---
import type {loadLeaderboardContent} from "../../lib/endfield/leaderboardContent";
import {partitionLeaderboardEvents} from "../../lib/endfield/eventLifecycle.mjs";
import LeaderboardEventPanel from "./LeaderboardEventPanel.astro";
interface Props {lang?:"de"|"en";eventData:Awaited<ReturnType<typeof loadLeaderboardContent>>}
const {lang="de",eventData}=Astro.props;
const l=(de:string,english:string)=>lang==="en"?english:de;
const {active,archived,upcoming}=partitionLeaderboardEvents(eventData.events);
// Announced events stay previewable before their official start date.
const selectable=[...active,...upcoming];
const firstBackground=selectable[0]?.backgroundImage??"";
---
<section class="cl-container cl-event-container" aria-labelledby="cl-event-title" data-event-leaderboard style={'--cl-event-background: '+(firstBackground?'url("'+firstBackground+'")':"none")}>
  <div class="cl-section-head cl-event-head">
    <h2 id="cl-event-title">Event Leaderboard</h2>
    {selectable.map((event,index)=>event.achievement&&<span
      class="cl-event-achievement"
      data-event-achievement={event.id}
      data-achievement-tooltip={l(event.achievement.tooltipDe,event.achievement.tooltipEn)}
      role="img"
      tabindex="0"
      aria-label={l(event.achievement.tooltipDe,event.achievement.tooltipEn)}
      hidden={index!==0}>
      <img src={event.achievement.image} width="160" height="160" alt="" aria-hidden="true" decoding="async"/>
    </span>)}
  </div>
  {selectable.length>0 ? <>
    {selectable.length>1 && <div class="cl-event-choices" role="group" aria-label={l("Laufendes oder angekündigtes Event auswählen","Choose current or announced event")}>
      {selectable.map((event,index)=><button type="button" class="cl-event-choice" data-event-choice={event.id}
        aria-pressed={index===0?"true":"false"} aria-controls={`cl-event-panel-${event.id}`}>
        <span>{event.title}</span>
      </button>)}
    </div>}
    {selectable.map((event,index)=><LeaderboardEventPanel event={event} verifiedRuns={eventData.verifiedRuns} lang={lang} archived={false} upcoming={upcoming.some(item=>item.id===event.id)} hidden={index!==0}/>)}
  </> : <div class="cl-event-inactive" data-no-current-event>
    <p>{l("Derzeit läuft kein Community-Event.","There is no community event currently running.")}</p>
  </div>}
  <details class="cl-event-archive" data-event-archive>
    <summary class="cl-event-archive-toggle">
      <span class="cl-event-archive-title">{l("Event-Archiv","Event archive")}</span>
      <span class="cl-event-archive-count">{archived.length}</span>
      <span class="cl-event-archive-chevron" aria-hidden="true">⌄</span>
    </summary>
    <div class="cl-event-archive-content">
      {archived.length>0 ? <>
        <div class="cl-archive-selector cl-control">
          <label for="cl-archive-select">{l("Vergangenes Event auswählen","Select past event")}</label>
          <select id="cl-archive-select" data-archive-select>
            {archived.map((event,index)=><option value={event.id} selected={index===0}>{event.title} · {event.version}</option>)}
          </select>
        </div>
        {archived.map((event,index)=><LeaderboardEventPanel event={event} verifiedRuns={eventData.verifiedRuns} lang={lang} archived={true} hidden={index!==0}/>)}
      </> : <p class="cl-archive-empty">{l("Noch keine abgeschlossenen Events.","No completed events yet.")}</p>}
    </div>
  </details>
</section>
<script>
  import "./leaderboard-event-client";
</script>
