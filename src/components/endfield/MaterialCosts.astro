---
import type { ImportedItemCost } from "../../lib/endfield/operatorData";
import { getEndfieldItem } from "../../lib/endfield/itemCatalog";
interface Props {
  items: ImportedItemCost[];
  translatedNames?: Record<string,string>;
  fallbackNames?: Record<string,{name:string}>;
}
const {items,translatedNames={},fallbackNames={}}=Astro.props;
const entries=(items??[]).map(row=>{
  const official=getEndfieldItem(row.id);
  return {id:row.id,
    name:translatedNames[row.id]??official?.name??fallbackNames[row.id]?.name??("Item "+row.id),
    image:official?.iconPath??null,
    count:row.count};
});
---
{entries.length ?
  <span class="op-resource-list" aria-label="Materialien">
    {entries.map(item=>
      <span class="op-resource" title={item.name+" × "+item.count}
        aria-label={item.name+" mal "+item.count}>
        {item.image ?
          <img src={item.image} alt="" width="34" height="34" loading="lazy" decoding="async" /> :
          <span class="op-resource-fallback">{item.name}</span>}
        <span class="op-resource-count" aria-hidden="true">×{item.count.toLocaleString("de-DE")}</span>
      </span>
    )}
  </span> :
  <span class="op-muted">–</span>}
