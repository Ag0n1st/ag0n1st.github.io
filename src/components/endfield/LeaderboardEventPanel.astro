---
import leaderboard from "../../data/endfield/community-leaderboard.json";
import {getOperatorImageUrl} from "../../lib/endfield/operatorAssets";
import {rankVerifiedRuns,rankContingencyContractWeek,flagForCountry} from "../../lib/endfield/leaderboardRanking.mjs";
import {berlinDayKey} from "../../lib/endfield/eventLifecycle.mjs";
import type {loadLeaderboardContent} from "../../lib/endfield/leaderboardContent";
type Content=Awaited<ReturnType<typeof loadLeaderboardContent>>;
interface Props {lang?:"de"|"en";event:Content["events"][number];verifiedRuns:Content["verifiedRuns"];archived:boolean;hidden:boolean;upcoming?:boolean}
const {lang="de",event,verifiedRuns,archived,hidden,upcoming=false}=Astro.props;
const en=lang==="en";
const l=(de:string,english:string)=>en?english:de;
const isGermanFlag=(code?:string)=>code==="DEU"||code==="DE";
const countryName=(code?:string)=>isGermanFlag(code)?l("Deutschland","Germany"):(code||l("Keine Angabe","Not specified"));
const shortDate=(date:string)=>{const [year,month,day]=date.split("-");return year&&month&&day?day+"."+month+".":date;};
const isContract=event.kind==="contingency-contract";
const weekTwoAvailable=isContract&&Boolean(event.weekTwoStartsOn)&&berlinDayKey()>=event.weekTwoStartsOn!;
const defaultCcWeek=weekTwoAvailable?2:1;
const verified=isContract?[]:
  rankVerifiedRuns(verifiedRuns.filter(run=>run.eventId===event.id),{boss:event.boss,version:event.version});
const bossDemo=archived?undefined:leaderboard.demoRuns.find(run=>run.id===event.demoRunId&&run.status==="demo"&&run.boss===event.boss&&run.version===event.version);
const contractDemo=!archived&&isContract&&event.demoRun?{...event.demoRun,id:"demo-"+event.id,status:"demo",version:event.version,link:event.demoRun.video}:undefined;
const demo=contractDemo??bossDemo;
const groups=isContract ? ([1,2] as const).map(week=>{
  const ranks=rankContingencyContractWeek(verifiedRuns,{eventId:event.id,version:event.version,week});
  return {week,rows:ranks.length?ranks:demo?[{...demo,rank:1}]:[]};
}) : [{week:0,rows:verified.length?verified:demo?[{...demo,rank:1}]:[]}];
const defaultRows=groups.find(group=>group.week===(isContract?defaultCcWeek:0))?.rows??[];
const demoOnly=defaultRows.length>0&&defaultRows.every(run=>run.status==="demo");
---
<div id={`cl-event-panel-${event.id}${archived?"-archive":""}`} class:list={["cl-event-panel",{"cl-event-archive-panel":archived}]} data-event-panel={event.id} data-event-background={event.backgroundImage} hidden={hidden} data-event-archived={archived?"true":"false"} style={archived ? '--cl-archive-background:url("'+event.backgroundImage+'")' : undefined}>
      {archived && <p class="cl-archive-final-label">{l("Abgeschlossen · Endergebnisse","Finished · Final standings")}</p>}
      {upcoming && <p class="cl-event-upcoming-notice" role="status">{l("Bevorstehendes Event · Start am ","Upcoming event · Starts on ")}{shortDate(event.startsOn)}{event.startsOn.slice(0,4)}</p>}
      <div class="cl-event-feature">
        <img class="cl-event-banner" src={event.image} width="800" height="320" alt={l(`${event.title} – Event-Banner`,`${event.title} – event banner`)} loading="eager" decoding="async" />
      </div>
      <details class="cl-event-rules" data-event-rules>
        <summary class="cl-event-rules-toggle">
          <span class="cl-event-rules-title">{l("Regeln","Rules")}</span>
          <span class="cl-event-date">
            <span class="cl-event-date-label">{l("Zeitraum","Period")}</span>
            <strong>{shortDate(event.startsOn)} – {shortDate(event.endsOn)}</strong>
          </span>
          <span class="cl-event-rules-chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="cl-event-rules-grid">
          {event.rules.map((rule,i)=><article class="cl-event-rule" data-event-rule={rule.id}>
            <span class="cl-event-rule-index" aria-hidden="true">{String(i+1).padStart(2,"0")}</span>
            <p>{en?rule.en:rule.de}{event.id==="duality"&&rule.id==="damage-dealer"&&<> <button class="cl-rule-explanation-trigger" type="button" data-rule-explanation-open aria-haspopup="dialog" aria-controls={`cl-rule-explanation-${event.id}`}>{l("Erklärung","Explanation")}</button></>}{rule.id==="submission"&&<> <a href={event.rulebookUrl} target="_blank" rel="noopener noreferrer" aria-label={l("Regelwerk in der angepinnten Discord-Nachricht öffnen","Open the rules linked in the pinned Discord post")}>{l("Regelwerk öffnen ↗","Open rules ↗")}</a></>}</p>
          </article>)}
        </div>
      </details>
      {event.id==="duality"&&<dialog class="cl-rule-explanation-dialog" id={`cl-rule-explanation-${event.id}`} data-rule-explanation-dialog aria-labelledby={`cl-rule-explanation-title-${event.id}`}>
        <div class="cl-rule-explanation-header">
          <h3 id={`cl-rule-explanation-title-${event.id}`}>{l("Duality – Regel 3 erklärt","Duality – Rule 3 explained")}</h3>
          <form method="dialog"><button class="cl-rule-explanation-close" type="submit" aria-label={l("Erklärung schließen","Close explanation")}>×</button></form>
        </div>
        <p class="cl-rule-explanation-intro">{l("Entscheidend ist der Trait auf der Operator-Karte: Nur Si darf im Team „Schadensverurs.“ / „Damage Dealer“ besitzen.","The trait shown on the operator card is what matters: Si must be the only team member with the “Damage Dealer” trait.")}</p>
        <div class="cl-rule-explanation-columns">
          <section class="cl-rule-explanation-allowed" aria-label={l("Erlaubte Teammitglieder","Allowed team members")}>
            <h4>{l("✓ Erlaubt","✓ Allowed")}</h4>
            <div class="cl-rule-explanation-example">
              <p><strong>Si</strong> – {l("als einziger Operator mit dem Trait „Schadensverurs.“ / „Damage Dealer“.","as the only operator with the “Damage Dealer” trait.")}</p>
              <img src="/images/endfield/leaderboard/duality-rule-si.webp" width="350" height="153" loading="eager" decoding="async" alt={l("Si: Der Trait Schadensverurs. ist grün markiert und erlaubt.","Si: Damage Dealer trait highlighted in green, allowed.")}/>
            </div>
            <div class="cl-rule-explanation-example">
              <p><strong>{l("Weitere Teammitglieder","Other team members")}</strong> – {l("nur ohne den Trait „Schadensverurs.“ / „Damage Dealer“, beispielsweise Arkan.","only without the “Damage Dealer” trait, for example Arcane.")}</p>
              <img src="/images/endfield/leaderboard/duality-rule-arcane.webp" width="349" height="156" loading="eager" decoding="async" alt={l("Arkan: Kein Schadensverurs.-Trait, grün als erlaubt gekennzeichnet.","Arcane: No Damage Dealer trait, highlighted in green as allowed.")}/>
            </div>
          </section>
          <section class="cl-rule-explanation-forbidden" aria-label={l("Verbotene Teammitglieder","Forbidden team members")}>
            <h4>{l("✕ Verboten","✕ Forbidden")}</h4>
            <div class="cl-rule-explanation-example">
              <p><strong>{l("Alle anderen Operatoren","Any other operator")}</strong> – {l("mit dem Trait „Schadensverurs.“ / „Damage Dealer“, beispielsweise Yvonne.","with the “Damage Dealer” trait, for example Yvonne.")}</p>
              <img src="/images/endfield/leaderboard/duality-rule-yvonne.webp" width="351" height="158" loading="eager" decoding="async" alt={l("Yvonne: Schadensverurs.-Trait rot markiert und durchgestrichen, verboten.","Yvonne: Damage Dealer trait marked in red and crossed out, forbidden.")}/>
            </div>
          </section>
        </div>
      </dialog>}
      <div class="cl-event-results">
        <div class:list={["cl-results-head",{"cl-cc-results-head":isContract}]}>
          <div><span class="cl-results-kicker">{event.version.toUpperCase()} · {archived?"ARCHIV":"EVENT"}</span><h3>Top 10 – {event.title}</h3></div>
          {isContract&&<div class="cl-cc-week-switch" data-cc-week-switch data-week-two-start={event.weekTwoStartsOn} role="group" aria-label={l("Contingency-Contract-Woche auswählen","Choose Contingency Contract week")}>
            <button type="button" class="cl-cc-week-choice" data-cc-week-choice="1" aria-controls={`cl-cc-${event.id}-${archived?"archive":"active"}-week-1`} aria-pressed={defaultCcWeek===1?"true":"false"}>{l("Woche 1","Week 1")}</button>
            <button type="button" class="cl-cc-week-choice" data-cc-week-choice="2" aria-controls={`cl-cc-${event.id}-${archived?"archive":"active"}-week-2`} aria-pressed={defaultCcWeek===2?"true":"false"} disabled={!weekTwoAvailable} title={!weekTwoAvailable?l("Ab 15.11.2026","Available from 15 November 2026"):undefined}>{l("Woche 2","Week 2")}</button>
          </div>}
        </div>
        {demoOnly && <p class="cl-demo-disclaimer">{l("Platzhaltereintrag zur Darstellung – kein verifizierter Event-Rekord.","Placeholder entry for display purposes – not a verified event record.")}</p>}
        <table class:list={["cl-rank-table",{"cl-contract-table":isContract}]} aria-label={"Top 10 – "+event.title}>
          <thead><tr>
            <th scope="col">#</th>
            <th scope="col">{l("Name","Name")}</th>
            <th scope="col">{l("Land","Country")}</th>
            <th scope="col">Team</th>
            {isContract&&<th scope="col">{l("Punkte","Points")}</th>}
            <th scope="col">{l("Zeit","Time")}</th>
            <th scope="col">{l("Version","Version")}</th>
          </tr></thead>
          {groups.map(({week,rows})=><tbody id={isContract?`cl-cc-${event.id}-${archived?"archive":"active"}-week-${week}`:undefined} data-cc-week-rows={isContract?week:undefined} hidden={isContract&&week!==defaultCcWeek}>
            {rows.length ? rows.map(run=><tr class:list={["cl-rank-row",{"is-demo":run.status==="demo"}]} data-run-status={run.status}>
              <th class="cl-rank-number" scope="row"><span class:list={["cl-placement",{"is-first":run.rank===1,"is-second":run.rank===2,"is-third":run.rank===3}]}>{run.rank}</span></th>
              <td class="cl-player">{run.discordName}{run.status==="demo"&&<span class="cl-placeholder-label">{l("Platzhalter","Placeholder")}</span>}</td>
              <td class="cl-country">{isGermanFlag(run.countryCode) ? <span class="cl-country-flag cl-flag-de" role="img" aria-label={countryName(run.countryCode)} title={countryName(run.countryCode)}></span> : <span role="img" aria-label={countryName(run.countryCode)}>{flagForCountry(run.countryCode)}</span>}</td>
              <td class="cl-team"><span class="cl-team-items">{run.team.map(member=><span class="cl-team-operator" title={member.slug+" · P"+member.potential}>
                {getOperatorImageUrl(member.slug,"official-icon")&&<img src={getOperatorImageUrl(member.slug,"official-icon")} alt={member.slug} width="42" height="42" loading="lazy" decoding="async"/>}
                <span class:list={["cl-operator-potential",{"is-p5":member.potential===5}]}>P{member.potential}</span>
              </span>)}</span></td>
              {isContract&&<td class="cl-run-points"><span class="cl-cc-score" aria-label={l(`${run.points} Punkte`,`${run.points} points`)}><span class="cl-cc-score-value" aria-hidden="true">{run.points}</span><span class="cl-cc-score-mark" aria-hidden="true"></span></span></td>}
              <td class="cl-run-time">{run.link?<a href={run.link} target="_blank" rel="noopener noreferrer" aria-label={run.status==="demo"?l("Platzhaltervideo auf YouTube öffnen","Open placeholder video on YouTube"):l("Run-Video öffnen","Open run video")}>{run.time} <span aria-hidden="true">↗</span></a>:<span>{run.time}</span>}</td>
              <td class="cl-run-version">{run.version}</td>
            </tr>) : <tr class="cl-empty-row"><td colspan={isContract?7:6}>{l("Noch keine verifizierten Runs für dieses Event eingetragen.","No verified runs have been submitted for this event yet.")}</td></tr>}
          </tbody>)}
        </table>
        {isContract&&<p class="cl-ranking-note">{l("Wertung nach Punkten (absteigend); bei Punktgleichstand entscheidet die schnellere Ingame-Zeit (MM:SS). Pro Spieler zählt der beste gültige Run.","Ranked by points (highest first); the faster in-game time (MM:SS) breaks score ties. Each player’s best eligible run counts.")}</p>}
      </div>
    </div>
