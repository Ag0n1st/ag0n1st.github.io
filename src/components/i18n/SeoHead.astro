---
import {localizedUrl,alternateLinks} from "../../lib/i18n/site.mjs";
interface Props { path:string; description?:string; title?:string; noindex?:boolean; translated?:boolean }
const {path,description,title,noindex=false,translated=true}=Astro.props;
---
<link rel="canonical" href={localizedUrl(path)} />
{translated && alternateLinks(path).map(row=><link rel="alternate" hreflang={row.lang} href={row.href}/>)}
{title && <meta property="og:title" content={title} />}
{description && <><meta name="description" content={description}/><meta property="og:description" content={description}/></>}
<meta property="og:type" content="website" />
<meta property="og:url" content={localizedUrl(path)} />
{noindex && <meta name="robots" content="noindex,follow" />}
