---
import {elasticPeakRanges, elasticGoods} from "../../data/endfield/elasticGoodsPeaks.mjs";
import "../../styles/endfield-elastic-goods.css";
interface Props {lang?:"de"|"en"}
const {lang="de"}=Astro.props;
const en=lang==="en";
const l=(de:string,english:string)=>en?english:de;
const origins=[
  {id:"wuling",labelDe:"Wuling",labelEn:"Wuling",currencyIcon:"/images/endfield/currency/wuling.webp",currencyAltDe:"Wuling-Währung",currencyAltEn:"Wuling currency"},
  {id:"valley",labelDe:"Tal IV",labelEn:"Valley IV",currencyIcon:"/images/endfield/currency/valley.webp",currencyAltDe:"Tal-IV-Währung",currencyAltEn:"Valley IV currency"}
];
const defaultOrigin=origins[0].id;
const goodsFor=(peak:string,origin:string)=>elasticGoods.filter(good=>good.peak===peak&&good.region===origin);
const peakValue=(peak:typeof elasticPeakRanges[number],origin:string)=>{
  const custom=peak.regionOverrides.find(entry=>entry.region===origin);
  return (en?custom?.en:custom?.de)??(en?peak.valueEn:peak.valueDe);
};
---
<section id="elasticgoods" class="op-cardlet eg-feature" aria-labelledby="eg-title" data-elastic-goods>
  <div class="eg-heading">
    <img class="eg-stock-redistribution-art" src="/images/endfield/cheatsheets/stock-redistribution.webp" alt="" aria-hidden="true" width="118" height="118" decoding="async"/>
    <span class="section-kicker">ELASTIC GOODS · PRICE PEAKS</span>
    <h3 id="eg-title">{l("Elastische Waren - Preis Peaks","Elastic Goods – Price Peaks")}</h3>
    <p>{l("Wann kaufen, wann verkaufen? Die drei Kategorien ordnen Waren danach ein, wie hoch ihr höchster Preis-Peak ausfallen kann.","When should you buy or sell? The three categories group goods by how high their own maximum price peak can reach.")}</p>
    
  </div>

  <div class="eg-tldr" aria-labelledby="eg-tldr-heading">
    <h4 id="eg-tldr-heading">TL;DR</h4>
    <div class="eg-trade-grid">
      <div class="eg-trade-step eg-buy">
        <span class="eg-trade-label">{l("KAUFEN","BUY")}</span>
        <strong>&lt; {l("1.000","1,000")}</strong>
        <span>{l("Möglichst günstig einkaufen","Buy below this price")}</span>
      </div>
      <div class="eg-trade-arrow" aria-hidden="true">→</div>
      <div class="eg-trade-step eg-sell">
        <span class="eg-trade-label">{l("VERKAUFEN","SELL")}</span>
        <strong>{l("Am Peak","At a peak")}</strong>
        <span>{l("Entscheidend ist der individuelle Peak der Ware","Sell when that specific good reaches its own peak")}</span>
      </div>
    </div>
    <p class="eg-key-takeaway"><strong>{l("Wichtig:","Important:")}</strong> {l("Eine Ware aus der Low-Peak-Gruppe erreicht keinen Mid- oder High-Peak: Low ist bereits ihr eigener höchster Peak! High-Peak-Waren können dagegen zwischenzeitlich auch niedrige Peaks haben – ihre Kategorie beschreibt das mögliche Maximum.","Goods in the Low Peak group cannot reach a Mid or High Peak: Low is already their own highest peak! High Peak goods can still hit lower peaks along the way – their category describes the potential maximum.")}</p>
  </div>

  <div class="eg-region-tabs" role="tablist" aria-label={l("Gebiet auswählen","Select region")} data-eg-region-tabs>
    {origins.map((origin,index)=><button
      type="button"
      role="tab"
      id={`eg-region-tab-${origin.id}`}
      class:list={["eg-region-tab",origin.id==="valley"?"eg-valley":"eg-wuling"]}
      data-eg-region-tab={origin.id}
      aria-selected={index===0?"true":"false"}
      aria-controls="eg-region-panel"
      tabindex={index===0?0:-1}>{en?origin.labelEn:origin.labelDe}</button>)}
  </div>
  <p class="eg-peaks-note">{l("Die Preisbereiche basieren auf Beobachtungen der Community und zeigen den höchsten Peak der jeweiligen Waren.","The price ranges are based on community observations and show the highest peak of each good.")}</p>
  <div id="eg-region-panel" role="tabpanel" aria-labelledby={`eg-region-tab-${defaultOrigin}`} data-eg-region-panel tabindex="0">
  <div class="eg-peaks">
    {elasticPeakRanges.map((peak,index)=><section class:list={["eg-peak",`eg-peak-${peak.id}`]} aria-labelledby={`eg-peak-${peak.id}-title`} data-peak={peak.id}>
      <div class="eg-peak-heading">
        <span class="eg-peak-level">{String(index+1).padStart(2,"0")}</span>
        <div>
          <h5 id={`eg-peak-${peak.id}-title`}>{peak.label}</h5>
          <p>{en?peak.descriptionEn:peak.descriptionDe}</p>
        </div>
        <span class="eg-price" data-eg-price>
          {origins.map(origin=><img
            class="eg-currency-icon"
            data-eg-currency={origin.id}
            src={origin.currencyIcon}
            alt={en?origin.currencyAltEn:origin.currencyAltDe}
            width="56" height="36" loading="eager" decoding="async"
            hidden={origin.id!==defaultOrigin}/>)}
          <strong class="eg-range" data-eg-range data-eg-range-values={JSON.stringify(Object.fromEntries(origins.map(origin=>[origin.id,peakValue(peak,origin.id)])))}>{peakValue(peak,defaultOrigin)}</strong>
        </span>
      </div>
      <div class="eg-origin-columns">
        {origins.map(origin=><div class:list={["eg-origin-group",origin.id==="valley"?"eg-valley":"eg-wuling"]} data-origin={origin.id} hidden={origin.id!==defaultOrigin}>
          <div class="eg-item-grid">
            {goodsFor(peak.id,origin.id).map(good=><div class="eg-item" data-elastic-good={good.id} data-evidence={good.evidence}>
              {good.iconPath ?
                <img class="eg-item-icon" src={good.iconPath} alt="" width="68" height="68" loading="lazy" decoding="async"/> :
                <span class="eg-item-icon eg-item-icon-pending" aria-hidden="true">◇</span>}
              <span class="eg-item-name">{en?good.en:good.de}</span>
            </div>)}
          </div>
        </div>)}
      </div>
    </section>)}
  </div>

  </div>

  <details class="eg-tips">
    <summary id="eg-tips-heading">{l("So nutzt du die Peaks","How to use the peaks")}</summary>
    <div class="eg-tips-grid">
      <p><strong>{l("1. Günstig kaufen.","1. Buy low.")}</strong> {l("Unter 1.000 einkaufen und Vorräte aufbauen.","Buy below 1,000 and build a stockpile.")}</p>
      <p><strong>{l("2. Peak abwarten.","2. Wait for a peak.")}</strong> {l("Die Preise sind zu Wochenbeginn oft niedriger und steigen zum Wochenende hin. Beobachte die aktuelle Marktentwicklung.","Prices are often lower early in the week and rise towards the weekend. Watch the current market.")}</p>
      <p><strong>{l("3. Flexibel verkaufen.","3. Sell flexibly.")}</strong> {l("Low-Peak-Waren haben ihr Maximum bereits im Low-Bereich. Waren mit Mid-/High-Potenzial kannst du bei einem niedrigeren Peak verkaufen oder für ihren möglichen höheren Peak aufheben.","Low-tier goods already reach their maximum in the Low range. You can sell Mid/High-tier goods at a lower peak or hold them for their possible higher peak.")}</p>
      <p><strong>{l("4. Potenzial vergleichen.","4. Compare potential.")}</strong> {l("Sind mehrere Waren gleich günstig, priorisiere bei Bedarf die Waren mit einem höheren individuellen Maximal-Peak. Nicht jede Ware kann 5.500 erreichen.","If several goods are equally cheap, consider those with a higher individual maximum peak. Not every good can reach 5,500.")}</p>
    </div>
  </details>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-elastic-goods]").forEach(root=>{
    const tabs=[...root.querySelectorAll<HTMLButtonElement>("[data-eg-region-tab]")];
    const panel=root.querySelector<HTMLElement>("[data-eg-region-panel]");
    const groups=[...root.querySelectorAll<HTMLElement>("[data-origin]")];
    const currencyIcons=[...root.querySelectorAll<HTMLImageElement>("[data-eg-currency]")];
    const priceRanges=[...root.querySelectorAll<HTMLElement>("[data-eg-range]")];
    if(!panel||!tabs.length)return;
    const select=(tab:HTMLButtonElement,focus=false)=>{
      const region=tab.dataset.egRegionTab;
      if(!region)return;
      tabs.forEach(button=>{
        const selected=button===tab;
        button.setAttribute("aria-selected",String(selected));
        button.tabIndex=selected?0:-1;
      });
      groups.forEach(group=>{group.hidden=group.dataset.origin!==region;});
      currencyIcons.forEach(icon=>{icon.hidden=icon.dataset.egCurrency!==region;});
      priceRanges.forEach(range=>{
        const values=JSON.parse(range.dataset.egRangeValues??"{}") as Record<string,string>;
        if(values[region])range.textContent=values[region];
      });
      panel.setAttribute("aria-labelledby",tab.id);
      if(focus)tab.focus();
    };
    tabs.forEach((tab,index)=>{
      tab.addEventListener("click",()=>select(tab));
      tab.addEventListener("keydown",event=>{
        let target:number;
        if(event.key==="ArrowRight")target=(index+1)%tabs.length;
        else if(event.key==="ArrowLeft")target=(index-1+tabs.length)%tabs.length;
        else if(event.key==="Home")target=0;
        else if(event.key==="End")target=tabs.length-1;
        else return;
        event.preventDefault();
        select(tabs[target],true);
      });
    });
    select(tabs.find(tab=>tab.getAttribute("aria-selected")==="true")??tabs[0]);
  });
</script>
