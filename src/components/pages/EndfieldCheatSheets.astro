---
import EndfieldPlaceholder from "../../layouts/EndfieldPlaceholder.astro";
interface Props {lang?:"de"|"en"}
const {lang="de"}=Astro.props;
const en=lang==="en";
const l=(de:string,english:string)=>en?english:de;
const categories=[
 {id:"elasticgoods",tag:"#ElasticGoods",de:"Elastic Goods – Best Prices",en:"Elastic Goods – Best Prices",descriptionDe:"Die besten Verkaufspreise und Waren-Kombinationen für Elastic Goods, später als kompaktes Nachschlagewerk.",descriptionEn:"Best selling prices and combinations for Elastic Goods, in a compact reference sheet."},
 {id:"artificing",tag:"#Artificing",de:"Veredelungs-Matrix – Best Matches",en:"Refinement Matrix – Best Matches",descriptionDe:"Übersicht optimaler Veredelungszuordnungen und passender Materialkombinationen.",descriptionEn:"A quick comparison of recommended refinement matches and compatible material combinations."},
 {id:"bufffood",tag:"#Bufffood",de:"Buff Food – Matrix",en:"Buff Food – Matrix",descriptionDe:"Bufffood nach erhöhten Kampfwerten vergleichen, mit besonderem Fokus auf Speedruns, z. B. ANG und Ultimate-Energiegewinn.",descriptionEn:"Compare buff food by affected combat stats, particularly for speedruns, such as ATK and Ultimate energy gain."}
];
---
<EndfieldPlaceholder title="Cheat Sheets" kicker="ARKNIGHTS: ENDFIELD · CHEAT SHEETS" active="cheatsheets" lang={lang} description={l("Schnelle Nachschlagekarten für Spielmechaniken, Farming und Speedruns.","Quick-reference cards for mechanics, farming and speedruns.")}>
  <main class="endfield-utility-page section-wrap endfield-coming-tool">
    <span class="section-kicker">ARKNIGHTS: ENDFIELD · REFERENCE</span>
    <h1 class="endfield-stacked-title"><span>Cheat</span><span>Sheets<span class="title-period">.</span></span></h1>
    <p class="endfield-utility-intro">{l("Kompakte Nachschlagekarten statt langem Suchen. Die konkreten Tabellen und Werte folgen nach redaktioneller Prüfung.","Compact quick-reference sheets. Verified tables and values will follow.")}</p>
    <div class="endfield-coming-cards" aria-label={l("Geplante Cheat Sheets","Planned Cheat Sheets")}>
      {categories.map(category=><article id={category.id} class="op-cardlet endfield-coming-card">
        <span class="section-kicker">{category.tag}</span>
        <h2>{en?category.en:category.de}</h2>
        <p>{en?category.descriptionEn:category.descriptionDe}</p>
        <span class="op-chip">{l("In Vorbereitung","Coming soon")}</span>
      </article>)}
    </div>
  </main>
</EndfieldPlaceholder>
