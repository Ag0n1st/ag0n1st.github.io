---
import EndfieldPlaceholder from "../../layouts/EndfieldPlaceholder.astro";
import RefinementMatrix from "./RefinementMatrix.astro";
import EndfieldRecruitment from "./EndfieldRecruitment.astro";
import ElasticGoodsPeaks from "./ElasticGoodsPeaks.astro";
interface Props {lang?:"de"|"en"}
const {lang="de"}=Astro.props;
const en=lang==="en";
const l=(de:string,english:string)=>en?english:de;

// Available references render as full cards; only Essences and Buff Food remain in preparation.
const systems=[
 {id:"essences",tag:"#Essences",de:"Essenzen",en:"Essences",
  descriptionDe:"Hier entsteht eine übersichtliche Referenz zum Essenz-System, damit du wichtige Informationen schnell nachschlagen kannst.",
  descriptionEn:"An accessible breakdown of the Essence system, its mechanics and practical progression tips is coming soon."}
];
const categories=[
 {id:"bufffood",tag:"#Bufffood",de:"Buff Food – Matrix",en:"Buff Food – Matrix",descriptionDe:"Bufffood nach erhöhten Kampfwerten vergleichen, mit besonderem Fokus auf Speedruns, z. B. ANG und Ultimate-Energiegewinn.",descriptionEn:"Compare buff food by affected combat stats, particularly for speedruns, such as ATK and Ultimate energy gain."}
];
---
<EndfieldPlaceholder title="Cheat Sheets" kicker="ARKNIGHTS: ENDFIELD · CHEAT SHEETS" active="cheatsheets" lang={lang} description={l("Schnelle Nachschlagekarten für Rekrutierung, Veredelung, Essenzen, Spielmechaniken, Farming und Speedruns.","Quick-reference cards for recruitment, refinement, essences, mechanics, farming and speedruns.")}>
  <main class="endfield-utility-page section-wrap endfield-coming-tool">
    <span class="section-kicker">ARKNIGHTS: ENDFIELD · REFERENCE</span>
    <h1 class="endfield-cheatsheets-title">Cheat Sheets<span class="title-period">.</span></h1>
    <p class="endfield-utility-intro">{l("Kompakte Nachschlagekarten statt langem Suchen. Elastische Waren, Veredelung und Rekrutierung sind verfügbar; weitere Cheat Sheets folgen.","Compact quick-reference sheets. Elastic Goods, the refinement matrix and recruitment are available; more references will follow.")}</p>

    <ElasticGoodsPeaks lang={lang} />
    <RefinementMatrix lang={lang} />
    <EndfieldRecruitment lang={lang} />

    <div class="endfield-coming-cards endfield-cheatsheets-upcoming" aria-label={l("Weitere Cheat Sheets in Vorbereitung","More Cheat Sheets coming soon")}>
      {[...systems,...categories].map(category=><article id={category.id} class="op-cardlet endfield-coming-card">
        <span class="section-kicker">{category.tag}</span>
        <h3>{en?category.en:category.de}</h3>
        <p>{en?category.descriptionEn:category.descriptionDe}</p>
        <span class="op-chip">{l("In Vorbereitung","Coming soon")}</span>
      </article>)}
    </div>
  </main>
</EndfieldPlaceholder>
<style>
  .endfield-utility-page h1.endfield-cheatsheets-title{white-space:nowrap;font-size:clamp(30px,5vw,58px)}
  .endfield-cheatsheets-upcoming{margin:28px 0 42px}
  .endfield-cheatsheets-upcoming .endfield-coming-card{scroll-margin-top:94px}
  .endfield-cheatsheets-upcoming .endfield-coming-card h3{font-size:19px;margin:0;line-height:1.3;color:#f7f3fa}
</style>
