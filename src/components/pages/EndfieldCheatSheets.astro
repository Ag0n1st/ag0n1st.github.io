---
import EndfieldPlaceholder from "../../layouts/EndfieldPlaceholder.astro";
import RefinementMatrix from "./RefinementMatrix.astro";
import ElasticGoodsPeaks from "./ElasticGoodsPeaks.astro";
interface Props {lang?:"de"|"en"}
const {lang="de"}=Astro.props;
const en=lang==="en";
const l=(de:string,english:string)=>en?english:de;

// The three previous standalone menu pages are now reference sections here.
// Their editorial content remains pending; do not invent mechanics or values.
const systems=[
 {id:"recruitment",tag:"#Recruitment",de:"Rekrutierung",en:"Recruitment",
  descriptionDe:"Hier findest du künftig eine strukturierte Erklärung des Rekrutierungssystems und die wichtigsten Tipps aus meinem Video-Guide.",
  descriptionEn:"Here you will find an explanation of Arknights: Endfield recruitment, including the essentials and helpful strategies."},
 {id:"essences",tag:"#Essences",de:"Essenzen",en:"Essences",
  descriptionDe:"Hier entsteht eine übersichtliche Referenz zum Essenz-System, damit du wichtige Informationen schnell nachschlagen kannst.",
  descriptionEn:"An accessible breakdown of the Essence system, its mechanics and practical progression tips is coming soon."}
];
const categories=[
 {id:"bufffood",tag:"#Bufffood",de:"Buff Food – Matrix",en:"Buff Food – Matrix",descriptionDe:"Bufffood nach erhöhten Kampfwerten vergleichen, mit besonderem Fokus auf Speedruns, z. B. ANG und Ultimate-Energiegewinn.",descriptionEn:"Compare buff food by affected combat stats, particularly for speedruns, such as ATK and Ultimate energy gain."}
];
---
<EndfieldPlaceholder title="Cheat Sheets" kicker="ARKNIGHTS: ENDFIELD · CHEAT SHEETS" active="cheatsheets" lang={lang} description={l("Schnelle Nachschlagekarten für Rekrutierung, Veredelung, Essenzen, Spielmechaniken, Farming und Speedruns.","Quick-reference cards for recruitment, refinement, essences, mechanics, farming and speedruns.")}>
  <main class="endfield-utility-page section-wrap endfield-coming-tool">
    <span class="section-kicker">ARKNIGHTS: ENDFIELD · REFERENCE</span>
    <h1 class="endfield-cheatsheets-title">Cheat Sheets<span class="title-period">.</span></h1>
    <p class="endfield-utility-intro">{l("Kompakte Nachschlagekarten statt langem Suchen. Die Veredelungs-Matrix und Elastic Goods – Price Peaks sind verfügbar; weitere Cheat Sheets werden nach Prüfung ergänzt.","Compact quick-reference sheets. The refinement matrix and Elastic Goods – Price Peaks are available; more verified references will follow.")}</p>

    <RefinementMatrix lang={lang} />

    <section class="endfield-cheatsheets-group" aria-labelledby="cheatsheets-systems-heading" data-cheatsheets-group="systems">
      <h2 id="cheatsheets-systems-heading">{l("Spielsysteme","Game systems")}</h2>
      <div class="endfield-coming-cards" aria-label={l("Spielsysteme im Überblick","Game systems overview")}>
        {systems.map(category=><article id={category.id} class="op-cardlet endfield-coming-card">
          <span class="section-kicker">{category.tag}</span>
          <h3>{en?category.en:category.de}</h3>
          <p>{en?category.descriptionEn:category.descriptionDe}</p>
          <span class="op-chip">{l("In Vorbereitung","Coming soon")}</span>
        </article>)}
      </div>
    </section>

    <section class="endfield-cheatsheets-group" aria-labelledby="cheatsheets-reference-heading" data-cheatsheets-group="references">
      <h2 id="cheatsheets-reference-heading">{l("Referenzen & Matrizen","References & matrices")}</h2>
      <ElasticGoodsPeaks lang={lang} />
      <div class="endfield-coming-cards" aria-label={l("Geplante Cheat Sheets","Planned Cheat Sheets")}>
        {categories.map(category=><article id={category.id} class="op-cardlet endfield-coming-card">
          <span class="section-kicker">{category.tag}</span>
          <h3>{en?category.en:category.de}</h3>
          <p>{en?category.descriptionEn:category.descriptionDe}</p>
          <span class="op-chip">{l("In Vorbereitung","Coming soon")}</span>
        </article>)}
      </div>
    </section>
  </main>
</EndfieldPlaceholder>
<style>
  .endfield-utility-page h1.endfield-cheatsheets-title{white-space:nowrap;font-size:clamp(30px,5vw,58px)}
  .endfield-cheatsheets-group{margin:36px 0 42px;scroll-margin-top:90px}
  .endfield-cheatsheets-group h2{font-size:clamp(21px,2.5vw,28px);line-height:1.3;letter-spacing:-.025em;color:#f4edf7;margin:0 0 9px}
  .endfield-cheatsheets-group .endfield-coming-cards{margin:16px 0 0}
  .endfield-cheatsheets-group .endfield-coming-card{scroll-margin-top:94px}
  .endfield-cheatsheets-group .endfield-coming-card h3{font-size:19px;margin:0;line-height:1.3;color:#f7f3fa}
</style>
