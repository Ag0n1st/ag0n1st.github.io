---
import RecruitmentEvent from "./RecruitmentEvent.astro";
import RecruitmentRerun from "./RecruitmentRerun.astro";
import RecruitmentStandard from "./RecruitmentStandard.astro";
import "../../styles/endfield-recruitment.css";
interface Props {lang?:"de"|"en"}
const {lang="de"}=Astro.props;
const en=lang==="en";
const l=(de:string,english:string)=>en?english:de;
const tabs=[{id:"event",de:"Event Banner",en:"Event Banner"},{id:"rerun",de:"Re-Run Banner",en:"Re-Run Banner"},{id:"standard",de:"Standard Banner",en:"Standard Banner"}];
---
<section id="recruitment" class="op-cardlet rc-card" aria-labelledby="rc-title" data-rc-guide>
 <header class="rc-card-head">
  <div><span class="section-kicker">ARKNIGHTS: ENDFIELD · CHEAT SHEET</span>
   <h2 id="rc-title">Gacha System</h2>
   <p class="rc-card-summary">{l("Rekrutierung und Waffenausgabe verständlich erklärt – mit Pity-Fortschritt und konkreten Beispielen.","Operator recruitment and weapon issue explained through pity progress and practical examples.")}</p>
  </div>
  <span class="rc-pill">GACHA · 6★</span>
 </header>
 <div class="rc-mode-tabs" role="tablist" aria-label={l("Gacha-Bereich auswählen","Choose gacha section")}>
  <button type="button" class="rc-mode-tab" role="tab" id="rc-mode-operators" aria-controls="rc-mode-panel-operators"
   aria-selected="true" tabindex="0" data-rc-mode-tab="operators">{l("Operator Rekrutierung","Operator Recruitment")}</button>
  <button type="button" class="rc-mode-tab" role="tab" id="rc-mode-weapons" aria-controls="rc-mode-panel-weapons"
   aria-selected="false" tabindex="-1" data-rc-mode-tab="weapons">{l("Waffen Ausgabe","Weapon Issue")}</button>
 </div>
 <div id="rc-mode-panel-operators" role="tabpanel" aria-labelledby="rc-mode-operators" data-rc-mode-panel="operators">
  <div class="rc-operator-heading"><span class="section-kicker">{l("OPERATOR REKRUTIERUNG","OPERATOR RECRUITMENT")}</span>
   <h3>{l("Banner im Überblick","Banners at a glance")}</h3>
  </div>
  <div class="rc-tabs" role="tablist" aria-label={l("Rekrutierungsart auswählen","Choose banner type")}>
   {tabs.map((tab,index)=><button type="button" class="rc-tab" id={"rc-tab-"+tab.id} data-rc-tab={tab.id}
     role="tab" aria-controls={"rc-panel-"+tab.id} aria-selected={String(index===0)} tabindex={index===0?0:-1}>{en?tab.en:tab.de}</button>)}
  </div>
  <RecruitmentEvent lang={lang}/>
  <RecruitmentRerun lang={lang}/>
  <RecruitmentStandard lang={lang}/>
 </div>
 <div id="rc-mode-panel-weapons" class="rc-weapons-panel" role="tabpanel" aria-labelledby="rc-mode-weapons" data-rc-mode-panel="weapons" hidden>
  <span class="section-kicker">{l("WAFFEN AUSGABE","WEAPON ISSUE")}</span>
  <h3>{l("Waffen Ausgabe","Weapon Issue")}</h3>
  <p>{l("Der Waffen-Teil folgt. Die Operator-Rekrutierung ist bereits vollständig verfügbar.","The weapon section will follow. Operator Recruitment is already available.")}</p>
 </div>
</section>
<script>
 const root=document.querySelector<HTMLElement>("[data-rc-guide]");
 if(root){
  const register=(tabSelector:string,panelSelector:string,dataKey:string)=>{
   const tabs=Array.from(root.querySelectorAll<HTMLButtonElement>(tabSelector));
   const panels=Array.from(root.querySelectorAll<HTMLElement>(panelSelector));
   const select=(id:string,focus=false)=>{
    for(const tab of tabs){const active=tab.dataset[dataKey]===id;tab.setAttribute("aria-selected",String(active));tab.tabIndex=active?0:-1;if(active&&focus)tab.focus();}
    for(const panel of panels)panel.hidden=panel.dataset[dataKey.replace("Tab","Panel")]!==id;
   };
   tabs.forEach((tab,i)=>{
    tab.addEventListener("click",()=>select(tab.dataset[dataKey]??"",false));
    tab.addEventListener("keydown",event=>{
     const next=event.key==="ArrowRight"?(i+1)%tabs.length:event.key==="ArrowLeft"?(i-1+tabs.length)%tabs.length:event.key==="Home"?0:event.key==="End"?tabs.length-1:-1;
     if(next<0)return;event.preventDefault();select(tabs[next].dataset[dataKey]??"",true);
    });
   });
   return select;
  };
  const selectMode=register("[data-rc-mode-tab]","[data-rc-mode-panel]","rcModeTab");
  const selectBanner=register("[data-rc-tab]","[data-rc-panel]","rcTab");
  const hash=location.hash.slice(1);
  if(["event","rerun","standard"].includes(hash)){selectMode("operators");selectBanner(hash);}
 }
</script>
