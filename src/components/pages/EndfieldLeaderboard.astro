---
import EndfieldPlaceholder from "../../layouts/EndfieldPlaceholder.astro";
import {featuredBosses} from "../../lib/endfield/threatCatalog";
import {getOperatorImageUrl} from "../../lib/endfield/operatorAssets";
import {displayLeaderboardRows,flagForCountry} from "../../lib/endfield/leaderboardRanking.mjs";
import leaderboard from "../../data/endfield/community-leaderboard.json";
import {loadLeaderboardContent} from "../../lib/endfield/leaderboardContent";
import LeaderboardEvent from "../endfield/LeaderboardEvent.astro";
import "../../styles/endfield-leaderboard.css";

interface Props {lang?:"de"|"en"}
const {lang="de"}=Astro.props;
const en=lang==="en";
const l=(de:string,english:string)=>en?english:de;
// UI display order is newest boss first, independent of the SKPORT snapshot.
const bosses=[...featuredBosses].reverse();
const defaultBoss="si";
const eventData=await loadLeaderboardContent();
const versions=["all-time",...[...new Set([...leaderboard.versions,...eventData.verifiedRuns.map(run=>run.version),...eventData.events.map(event=>event.version)])].sort((a,b)=>Number(b.slice(1))-Number(a.slice(1)))];
const bossLabels=new Map(bosses.map(boss=>[boss.slug,boss.label]));
const isGermanFlag=(code?:string)=>code==="DEU"||code==="DE";
const countryName=(code?:string)=>isGermanFlag(code)?l("Deutschland","Germany"):(code||l("Keine Angabe","Not specified"));
// One authoritative submission: include event runs in general rankings only when
// individually approved for the permanent Community Leaderboard.
const generalRuns=[...leaderboard.verifiedRuns,...eventData.verifiedRuns.filter(run=>run.eventId&&run.eligibleForCommunity===true)];
const generalLeaderboard={...leaderboard,verifiedRuns:generalRuns};
---
<EndfieldPlaceholder title="Community Leaderboard" kicker="ARKNIGHTS: ENDFIELD · COMMUNITY LEADERBOARD" active="leaderboard" lang={lang} description={l("Verifizierte Boss-Speedruns, Bestenlisten und Community-Events in Arknights: Endfield.","Verified boss speedruns, rankings and community events in Arknights: Endfield.")}>
  <main class="endfield-utility-page section-wrap cl-page" data-community-leaderboard>
    <span class="section-kicker">ARKNIGHTS: ENDFIELD · SPEEDRUNS</span>
    <p class="cl-page-lead">{l("Boss-Speedruns aus der Community · RE-Krise · Höchster Schwierigkeitsgrad","Community boss speedruns · RE-Crisis · Highest difficulty")}</p>
    <div class="cl-update-notice" role="note"><strong>{l("Hinweis:","Note:")}</strong> {l("Das Community Leaderboard und das Event Leaderboard werden einmal pro Woche am Ende der Woche aktualisiert.","The Community Leaderboard and Event Leaderboard are updated once a week at the end of the week.")}</div>

    <LeaderboardEvent lang={lang} eventData={eventData} />

    <section class="cl-container cl-main-container" aria-labelledby="cl-community-title">
      <div class="cl-section-head cl-community-head">
        <div>
          <h1 id="cl-community-title">Community Leaderboard</h1>
        </div>
        <svg class="cl-trophy-art" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M38 18h44v18c0 25-9 37-22 41-13-4-22-16-22-41V18Z"/>
          <path d="M38 25H19v14c0 15 9 22 23 22m40-36h19v14c0 15-9 22-23 22M60 78v17m-16 1h32l6 9H38l6-9Zm11-52 5-12 5 12 13 1-10 8 4 12-12-7-12 7 4-12-10-8 13-1Z"/>
        </svg>
      </div>

      <div class="cl-filters">
        <div class="cl-control">
          <label for="cl-boss-select">{l("Boss auswählen","Select boss")}</label>
          <select id="cl-boss-select" data-boss-select>
            {bosses.map(boss=><option value={boss.slug} selected={boss.slug===defaultBoss}>{boss.label}</option>)}
          </select>
        </div>
        <div class="cl-control">
          <label for="cl-version-select">{l("Spielversion","Game version")}</label>
          <select id="cl-version-select" data-version-select>
            {versions.map(version=><option value={version} selected={version==="all-time"}>{version==="all-time"?"All-Time":version}</option>)}
          </select>
        </div>
      </div>

      <div class="cl-boss-choices-label">{l("Schnellauswahl","Quick select")}</div>
      <div class="cl-boss-choices" role="group" aria-label={l("Boss für die Rangliste auswählen","Choose ranking boss")}>
        {bosses.map(boss=><button class="cl-boss-choice" type="button" data-boss-choice={boss.slug} aria-pressed={boss.slug===defaultBoss?"true":"false"} title={boss.label}>
          <span class="cl-boss-art">{boss.image && <img src={boss.image} alt="" loading="lazy" decoding="async" width="96" height="96"/>}</span>
          <span class="cl-boss-name">{boss.label}</span>
        </button>)}
      </div>

      <div class="cl-results" aria-live="polite" aria-atomic="false">
        {bosses.flatMap(boss=>versions.map(version=>{
          const rows=displayLeaderboardRows(generalLeaderboard,boss.slug,version);
          const visible=boss.slug===defaultBoss&&version==="all-time";
          const demoOnly=rows.length>0&&rows.every(run=>run.status==="demo");
          return <section class="cl-results-panel" data-leaderboard-boss={boss.slug} data-leaderboard-version={version} hidden={!visible} aria-label={l("Rangliste für ","Ranking for ")+boss.label+" · "+(version==="all-time"?"All-Time":version)}>
            <div class="cl-results-head">
              <div>
                <span class="cl-results-kicker">{version==="all-time"?"ALL-TIME":version.toUpperCase()}</span>
                <h3>Top 10 – {boss.label}</h3>
              </div>
              {boss.image && <img class="cl-current-boss" src={boss.image} alt="" loading="lazy" decoding="async" width="76" height="76"/>}
            </div>
            {demoOnly && <p class="cl-demo-disclaimer">{l("Platzhaltereintrag zur Darstellung – kein verifizierter Community-Rekord.","Placeholder entry for display purposes – not a verified community record.")}</p>}
            <table class="cl-rank-table" aria-label={l("Top 10 für ","Top 10 for ")+boss.label}>
              <thead><tr>
                <th scope="col">#</th>
                <th scope="col">{l("Name","Name")}</th>
                <th scope="col">{l("Land","Country")}</th>
                <th scope="col">Team</th>
                <th scope="col">{l("Zeit","Time")}</th>
                <th scope="col">{l("Version","Version")}</th>
              </tr></thead>
              <tbody>
                {rows.length ? rows.map(run=><tr class:list={["cl-rank-row",{"is-demo":run.status==="demo"}]} data-run-status={run.status}>
                  <th class="cl-rank-number" scope="row"><span class:list={["cl-placement",{"is-first":run.rank===1,"is-second":run.rank===2,"is-third":run.rank===3}]}>{run.rank}</span></th>
                  <td class="cl-player">{run.discordName}{run.status==="demo"&&<span class="cl-placeholder-label">{l("Platzhalter","Placeholder")}</span>}</td>
                  <td class="cl-country">{isGermanFlag(run.countryCode)?<span class="cl-country-flag cl-flag-de" role="img" aria-label={countryName(run.countryCode)} title={countryName(run.countryCode)}></span>:<span role="img" aria-label={countryName(run.countryCode)} title={countryName(run.countryCode)}>{flagForCountry(run.countryCode)}</span>}</td>
                  <td class="cl-team">
                    <span class="cl-team-items">
                      {run.team.map(member=><span class="cl-team-operator" title={member.slug.charAt(0).toUpperCase()+member.slug.slice(1)+" · P"+member.potential} aria-label={member.slug+" P"+member.potential}>
                        {getOperatorImageUrl(member.slug,"official-icon") && <img src={getOperatorImageUrl(member.slug,"official-icon")} alt={member.slug} width="42" height="42" loading="lazy" decoding="async"/>}
                        <span class:list={["cl-operator-potential",{"is-p5":member.potential===5}]}>P{member.potential}</span>
                      </span>)}
                    </span>
                  </td>
                  <td class="cl-run-time">
                    <a href={run.link} target="_blank" rel="noopener noreferrer" aria-label={run.status==="demo"?l("Platzhaltervideo auf YouTube öffnen","Open placeholder video on YouTube"):l("Run-Video auf YouTube öffnen","Open run video on YouTube")}>{run.time}<span class="cl-external" aria-hidden="true">↗</span></a>
                  </td>
                  <td class="cl-run-version">{run.version}</td>
                </tr>) : <tr class="cl-empty-row"><td colspan="6">{l("Für diese Auswahl sind noch keine verifizierten Runs eingetragen.","No verified runs have been submitted for this selection yet.")}</td></tr>}
              </tbody>
            </table>
            <p class="cl-ranking-note">{l("Wertung nach Ingame-Zeit (MM:SS). Identische Zeiten teilen sich die Platzierung. Pro Spieler zählt die beste gültige Zeit für die gewählte Auswahl.","Ranked by the in-game timer (MM:SS). Identical times share the same placement. Only each player's best eligible run counts for this selection.")}</p>
          </section>;
        }))}
      </div>
      <div class="cl-footer">
        <p>{l("Runs werden auf Discord eingereicht und nach Video- und Ausrüstungsprüfung freigegeben. Ohne Buff Food oder taktische Mittel.","Runs are submitted on Discord and verified using the video and gear details. No buff food or tactical items.")}</p>
        <a href="https://discord.gg/v2h9KKT" target="_blank" rel="noopener noreferrer">{l("Run über Discord einreichen ↗","Submit a run via Discord ↗")}</a>
      </div>
    </section>
  </main>
</EndfieldPlaceholder>
<script>
  import "../endfield/leaderboard-client";
</script>
