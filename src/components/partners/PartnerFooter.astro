---
import registry from "../../data/partners.json";
import "../../styles/partners.css";
interface Props {lang?:"de"|"en"}
const {lang="de"}=Astro.props;
const en=lang==="en";
const l=(de:string,english:string)=>en?english:de;
const partners=registry.partners.filter(partner=>partner.active);
---
<nav class="partner-footer-icons" data-partner-footer aria-label={l("Werbung – Affiliate-Links zu meinen Partnern","Advertisement – affiliate links to my partners")}>
  {partners.map(partner=><a class="partner-footer-icon" data-partner-id={partner.id} href={partner.affiliateUrl}
    style={`--partner-accent:${partner.accent}`} target="_blank" rel="sponsored noopener noreferrer"
    aria-label={l(`${partner.name} – Werbung, Affiliate-Link`,`${partner.name} – advertisement, affiliate link`)} title={partner.name}>
    <img src={partner.logoIcon} alt="" aria-hidden="true" loading="lazy" decoding="async"/>
  </a>)}
  <small class="partner-footer-caption">{l("Werbung · Affiliate-Links","Advertisement · Affiliate links")}</small>
</nav>
