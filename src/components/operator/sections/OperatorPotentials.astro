---
import type { OperatorGuideModel } from "../../../lib/endfield/operatorGuideModel";

interface Props { model: OperatorGuideModel }
const { model } = Astro.props;
const translateUi=(value:string)=>guideText(model.lang,value);
const { guide, gameData, localized, trPotential, officialPotentials, potentialByLevel, getOperatorImageUrl } = model;
const wikiGalleryUrl="https://endfield.wiki.gg/wiki/"+encodeURIComponent(gameData?.operator.name??guide.displayName??guide.operator)+"/Gallery";
const alternatePotentialModels=guide.potentials.comparisons??[];
const percent=(value:number|undefined)=>value===undefined?"–":value.toLocaleString("de-DE",{minimumFractionDigits:1,maximumFractionDigits:1})+" %";
import { guideText } from "../../../lib/i18n/guideUi";
---
<section class="op-section" id="potenziale">
        <h2>{translateUi("Potenziale")}</h2>
        <div class="op-notice"><strong>Friendly Disclaimer:</strong>{translateUi("Potenziale sind nice to have, aber")}<strong>{translateUi("niemals ein Muss")}</strong>{translateUi(". Zusätzliche Kopien können teuer sein und sind in der Regel nicht nötig, um einen Operator sinnvoll zu spielen.")}</div>
        <div class="op-divided" style="margin-top:20px">
          <h3>{translateUi("Potenzialübersicht")}</h3>
          <div class="op-pills" aria-label="Potenzial auswählen">{[1,2,3,4,5].map((n,i)=><button type="button" class="op-pill-button" data-potential-button={n} aria-pressed={i===0?"true":"false"}>P{n}</button>)}</div>
          {[1,2,3,4,5].map((n,i)=>{
            const p=potentialByLevel.get(n);
            return <div class="op-weapon-panel op-cardlet" data-potential-panel={n} hidden={i!==0}>
              <h3>P{n} – {officialPotentials.get(n)?.name || "[Offizieller Potenzialname]"}</h3>
              <p class="op-body-copy">{trPotential(n, officialPotentials.get(n)?.effect || "[Offizieller Effekt aus Spieldaten]")}</p>
              {officialPotentials.has(n) && <p class="op-muted" style="font-size:11px">{model.lang==="en"?"SKPORT effect (original English). Percentages shown here are not total DPS comparisons.":"SKPORT-Wirkung"+(localized?" (deutsch übersetzt)":" (EN)")+". Prozentangaben im Effekt sind keine Gesamt-DPS-Vergleiche."}</p>}
              {(n===1||n===3||n===5) && (()=>{
                const snapshot=getOperatorImageUrl(guide.operator, ("potential-"+n) as "potential-1" | "potential-3" | "potential-5");
                return snapshot ? <figure class="op-potential-snapshot">
                  <img src={snapshot} width="960" height="540" loading="lazy" decoding="async" alt={"Operator-Snapshot "+guide.operator+" P"+n} />
                  <figcaption>Freischaltbarer Operator-Snapshot · P{n} · <a href={wikiGalleryUrl} target="_blank" rel="noopener noreferrer">Bildreferenz: Endfield Talos Wiki ↗</a></figcaption>
                </figure> : null;
              })()}
              {p?.evaluation && <p class="op-body-copy"><strong>Einordnung:</strong> {p.evaluation}</p>}
              <div class="op-info-field">
                <small>{translateUi("Zusatzgewinn durch")} P{n} {translateUi("gegenüber")} P{n-1}{alternatePotentialModels.length?model.lang==="en"?" · with Ultimate energy requirement":" · mit Ultimate-Energiebedarf":""}</small>
                <strong>{p?.increaseOverPreviousPercent === undefined ? "–" : p.increaseOverPreviousPercent.toLocaleString("de-DE",{minimumFractionDigits:1,maximumFractionDigits:1})+" %"}</strong>
              </div>
            </div>;
          })}
        </div>
        <details class="op-divided op-guide-accordion" data-guide-disclosure="potential-comparison">
          <summary class="op-guide-accordion-summary"><h3>{translateUi("Potenzialvergleich")}</h3><span class="op-guide-accordion-hint">{translateUi("Vergleich anzeigen")}</span></summary>
          <div class="op-guide-accordion-content">
          <div class="op-table-wrap"><table class="op-table op-potential-comparison-table">
            <thead><tr><th scope="col">{translateUi("Potenzial")}</th><th scope="col">{translateUi("Offizieller Effekt")}</th>
              <th scope="col">{alternatePotentialModels.length?"Mit Ultimate-Energiebedarf":"Zusatzgewinn zur Vorstufe"}</th>
              {alternatePotentialModels.map(scenario=><th scope="col">{scenario.title}</th>)}
            </tr></thead>
            <tbody>{[1,2,3,4,5].map(n=><tr>
              <th scope="row">P{n}</th>
              <td class="op-body-copy">{trPotential(n, officialPotentials.get(n)?.effect || "[Folgt]")}</td>
              <td>{percent(potentialByLevel.get(n)?.increaseOverPreviousPercent)}</td>
              {alternatePotentialModels.map(scenario=><td>{percent(scenario.entries.find(entry=>entry.level===n)?.increaseOverPreviousPercent)}</td>)}
            </tr>)}</tbody>
          </table></div>
          {guide.potentials.entries.some(p=>p.sourceNote && p.increaseOverPreviousPercent!==undefined) &&
            <small class="op-data-source-note">Quelle: {[...new Set(guide.potentials.entries.filter(p=>p.increaseOverPreviousPercent!==undefined).map(p=>p.sourceNote).filter(Boolean))].join(", ")} · {model.lang==="en"?"Incremental gain at each potential compared with the preceding stage":"Zuwachs je Potenzial zur unmittelbar vorherigen Stufe"}{alternatePotentialModels.length?model.lang==="en"?" · first value: with Ultimate energy requirement":" · erster Wert: mit Ultimate-Energiebedarf":""}.</small>}
          {alternatePotentialModels.map(scenario=><small class="op-data-source-note">{scenario.title}: {scenario.sourceNote} ({scenario.snapshotDate??"ohne Stichtag"}). Ebenfalls Werte gegenüber der jeweiligen Vorstufe; kein addierter P0-Vergleich.</small>)}
          </div>
        </details>
      </section>
