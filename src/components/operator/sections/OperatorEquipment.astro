---
import type { OperatorGuideModel } from "../../../lib/endfield/operatorGuideModel";
import ItemIcon from "../../endfield/ItemIcon.astro";
import MaterialCosts from "../../endfield/MaterialCosts.astro";
import {resolveOfficialItem} from "../../../lib/endfield/itemCatalog";
import {getOfficialGear} from "../../../lib/endfield/equipmentDetails";
import {getGearBlueprintResearch} from "../../../lib/endfield/gearBlueprintResearch";
import storyAreaRegistry from "../../../data/endfield/progression/story-areas.json";
import {FACTORY_COMPONENT_STAGES, DEFAULT_FACTORY_COMPONENT, FACTORY_LABELS, getBuildRequirements} from "../../../lib/endfield/buildFinder.mjs";

interface Props { model: OperatorGuideModel }
const { model } = Astro.props;
const { guide, missing, roleLabels, stageLabels, builds, preview } = model;
const officialBuilds=builds.map(build=>{
 const parts=build.items.map(reference=>{
   const catalog=resolveOfficialItem(reference,"Gear");
   return {reference,catalog,detail:catalog?getOfficialGear(catalog.id):undefined,blueprint:catalog?getGearBlueprintResearch(catalog.id):null};
 });
 const requirements=getBuildRequirements(parts.map(part=>part.detail),{
   availableFromLevel:build.availableFromLevel,
   storyUnlock:build.storyUnlock,
   locations:parts.map(part=>part.blueprint),
   preview
 });
 return {...build,parts,requirements};
});
---
<section class="op-section" id="ausruestung">
        <h2>Ausrüstung</h2>
        <div class="op-divided">
          <h3>Build-Finder</h3>
          <p class="op-section-intro">Wähle Level, höchste herstellbare Fabrikkomponente und die bereits freigeschalteten Gebiete. Der Finder prüft bei jedem Build alle vier Ausrüstungsteile einzeln – einschließlich des Blaupausenbesitzes.</p>
          <div class="op-two">
            <label class="op-cardlet" style="font-size:12px">Operator- / Ausrüstungslevel
              <select class="op-select" id="op-level">
                {[70,60,50,36,28,20,10].map(value=><option value={value} selected={value===70}>Level {value}</option>)}
              </select>
            </label>
            <label class="op-cardlet" style="font-size:12px">Fabrikfortschritt · höchste herstellbare Komponente
              <span class="op-factory-select-row">
                <img id="op-factory-icon" src={`/images/endfield/materials/${FACTORY_COMPONENT_STAGES.at(-1)?.itemId}.webp`} alt="" width="34" height="34" loading="lazy" />
                <select class="op-select" id="op-factory">
                  {["Early-Game","Mid-Game","End-Game"].map(phase=>
                    <optgroup label={phase}>
                      {FACTORY_COMPONENT_STAGES.filter(stage=>stage.phase===phase).map(stage=>
                        <option value={stage.id} selected={stage.id===DEFAULT_FACTORY_COMPONENT}>
                          {stage.label} · Level {stage.levels.join("/")}
                        </option>
                      )}
                    </optgroup>
                  )}
                </select>
              </span>
            </label>
          </div>
          <div class="op-story-filter">
            <div class="op-two">
              <label class="op-cardlet op-story-region-label">Story-Fortschritt · erreichte Region
                <select class="op-select" id="op-story-region">
                  <option value="">Nicht festgelegt</option>
                  {storyAreaRegistry.regions.map(region=>
                    <option value={region.id}>{region.displayNameDe}</option>)}
                </select>
              </label>
              <div class="op-cardlet op-story-help">
                <strong>Freigeschaltete Gebiete</strong>
                <p class="op-muted">Wähle nur Gebiete, die du im Spiel tatsächlich betreten kannst. Ein Gebiet der aktuellen Version wird nicht automatisch freigeschaltet.</p>
              </div>
            </div>
            <details class="op-details op-story-areas" id="op-story-areas-panel">
              <summary>Einzelne Gebiete auswählen <span id="op-story-area-counter">0 ausgewählt</span></summary>
              <div class="op-story-areas-body">
                {storyAreaRegistry.regions.map(region=>
                  <fieldset class="op-story-area-group" data-story-region-group={region.id}>
                    <legend>{region.displayNameDe}</legend>
                    <div class="op-story-area-options">
                      {storyAreaRegistry.areas.filter(area=>area.regionId===region.id).map(area=>
                        <label class="op-story-area-option">
                          <input type="checkbox" value={area.id} data-story-area={area.id} data-area-region={region.id} />
                          <span>{area.displayNameDe}</span>
                        </label>)}
                    </div>
                  </fieldset>)}
                <p class="op-muted">Die Auswahl bestätigt nur den Gebiets-Zugang, nicht das Einsammeln der dortigen Blaupausenkisten. Nebenmissionen können Gebiete unabhängig von der Hauptstory freischalten.</p>
              </div>
            </details>
            <details class="op-details op-story-extra">
              <summary>Weitere Fortschritte · Autoritätslevel und Wuling-Warenumverteilung</summary>
              <div class="op-two op-story-extra-fields">
                <label>Autoritätslevel
                  <input class="op-select" id="op-authority-level" type="number" min="0" max="200" step="1" placeholder="Nicht angegeben" inputmode="numeric" />
                </label>
                <label>Wuling-Warenumverteilung
                  <select class="op-select" id="op-stock-level">
                    <option value="">Nicht angegeben</option>
                    {[0,1,2,3].map(stage=><option value={stage}>Stufe {stage}</option>)}
                  </select>
                </label>
              </div>
              <p class="op-muted">Auch ein erreichtes Autoritätslevel oder eine Warenumverteilungsstufe bestätigt noch nicht, dass eine Vorlage abgeholt wurde.</p>
            </details>
          </div>
          <div class="op-notice" style="margin-top:12px">
            Ausgewählt: <strong id="op-build-config">Lv. 70 · Pyrrolit-Komponente · End-Game</strong>
            <p class="op-build-progress-status" id="op-build-results" role="status" aria-live="polite">Prüfe vorhandene Guide-Builds …</p>
            <label class="op-build-show-all">
              <input id="op-build-show-all" type="checkbox" checked />
              Auch noch gesperrte oder ungeprüfte Builds anzeigen
            </label>
          </div>
          <p class="op-muted">Die Komponentenstufe stammt aus offiziellen Standardrezepten; die Gebiets- und Einzelteilhinweise aus unserer gekennzeichneten Recherche. Reicht ein Fundortnachweis nicht aus, bleibt das Ergebnis ungeklärt. Deine Eingaben werden nur in diesem Browser gespeichert, ohne Login.</p>
          <div class="op-notice op-gear-disclaimer" style="margin-top:12px"><strong>Hinweis zur Ausrüstung:</strong> Achtet bei der Ausrüstung grundsätzlich darauf, Ausrüstungsteile zu nutzen, die das Haupt- und Sekundärattribut des jeweiligen Operators erhöhen. Das gilt besonders für Builds auf niedrigeren Leveln.</div>
          {guide.equipment.generalNotes && <p class="op-body-copy">{guide.equipment.generalNotes}</p>}
        </div>
        <div class="op-divided">
          <h3>Empfohlene Ausrüstung</h3>
          {officialBuilds.length ? <>
            <p id="op-build-empty" class="op-notice" hidden>Kein Build ist für deine bisherigen Angaben vollständig verfügbar. Ändere den Fortschritt, bestätige die eigenen Blaupausen oder aktiviere die Anzeige gesperrter Builds.</p>
            <div class="op-pills" aria-label="Build auswählen">{officialBuilds.map((b,i)=><button type="button" class="op-pill-button" data-build-button={b.id} data-build-requirements={JSON.stringify(b.requirements)} aria-pressed={i===0?"true":"false"}>{b.title}<span class="op-build-button-status" data-build-status-label></span></button>)}</div>
            {officialBuilds.map((b,i)=><div class="op-build-panel op-cardlet" data-build-panel={b.id} hidden={i!==0}>
              <div class="op-subtitle"><h3 style="margin:0">{b.title}</h3><span class="op-chip">{roleLabels[b.role]}</span></div>
              <div class="op-gear-parts">{b.parts.map(part=><div class="op-gear-part"><div class="op-mini-art"><ItemIcon id={part.catalog?.id??part.reference} /></div><small>{part.catalog?.name??part.reference}</small></div>)}</div>
              {b.availableFromLevel && <p><strong>Ab Level:</strong> {b.availableFromLevel}</p>}
              <p class="op-body-copy">
                <strong>Benötigte Komponente:</strong>{" "}
                {b.requirements.requiredComponent==="starter" ? "Grundmaterialien (vor Amethyst)" :
                  b.requirements.requiredComponent ? <>
                    <img class="op-factory-inline-icon" src={`/images/endfield/materials/${FACTORY_COMPONENT_STAGES.find(stage=>stage.id===b.requirements.requiredComponent)?.itemId}.webp`} alt="" width="26" height="26" loading="lazy" />
                    {FACTORY_LABELS[b.requirements.requiredComponent]}
                  </> : "Herstellungsrezept noch nicht zugeordnet"}
              </p>
              {b.storyUnlock && <p class="op-body-copy"><strong>Redaktioneller Story-Hinweis:</strong> {b.storyUnlock}</p>}
              <p class="op-body-copy" data-build-reason aria-live="polite">Story- und Blaupausenstatus wird geprüft …</p>
              <fieldset class="op-blueprint-checklist">
                <legend>Blaupausenbesitz bestätigen</legend>
                {b.parts.map(part=><label class="op-blueprint-check">
                  <input type="checkbox" data-blueprint-owned={part.catalog?.id??part.reference}
                    disabled={!part.catalog} />
                  <span>{part.catalog?.name??part.reference}</span>
                </label>)}
                <p class="op-muted">Markiere nur Blaupausen, die du bereits tatsächlich erhalten hast. Diese Angaben gelten für das jeweilige Ausrüstungsteil – auch in anderen Guides.</p>
              </fieldset>
              {b.teamContext && <p class="op-body-copy"><strong>Einsatzbereich:</strong> {b.teamContext}</p>}
              {b.setBonusNotes && <p class="op-body-copy"><strong>Seteffekte:</strong> {b.setBonusNotes}</p>}
              <p class="op-body-copy"><strong>Bewertung:</strong> {b.evaluation || missing}</p>
              <details class="op-details"><summary>Werte, Herstellung & Freischaltungen</summary><div class="op-details-body">
                <div class="op-table-wrap"><table class="op-table"><thead><tr><th>Ausrüstungsteil</th><th>Attribute</th><th>Materialien</th></tr></thead>
                  <tbody>{b.parts.map(part=><tr>
  <td>{part.catalog?.name??part.reference}</td>
  <td>{part.detail?.status==="verified" ? <>
    <div class="op-muted">Level {part.detail.level??"?"} · {part.detail.gearSlot??"Ausrüstung"}</div>
    {(part.detail.stats[0]?.tables[0]?.rows??[]).map(row=><div>{row.cells[0]}: {row.cells[1]}</div>)}
    {part.detail.setEffect&&<details class="op-details"><summary>{part.detail.setName} – Setbonus</summary><p class="op-body-copy">{part.detail.setEffect}</p></details>}
    {part.detail.acquisitionNotes?.length>0&&<p class="op-body-copy"><strong>Offizielle Blaupausen-Erwerbsart:</strong> {part.detail.acquisitionNotes.join(" · ")}</p>}
    {part.blueprint && (part.blueprint.kind==="template-crate" || part.blueprint.precision==="disputed") && <details class="op-details">
      <summary>Blaupausen-Fundort · {
        part.blueprint.precision==="verified"?"persönlich geprüft":
        part.blueprint.precision==="specific-item"?"einzelnes Rüstungsteil (Community)":
        part.blueprint.precision==="disputed"?"Quellen widersprechen sich":
        "Set-Hinweis (Community)"
      }</summary>
      <div class="op-details-body">
        {part.blueprint.areas.length>0 && <p class="op-body-copy">
          <strong>{part.blueprint.precision==="verified"?"Bestätigtes Gebiet":
            part.blueprint.precision==="specific-item"?"Recherchiertes Fundgebiet":
            "In den Quellen genannte Gebiete"}:</strong>{" "}
          {part.blueprint.areas.map(x=>x.name).join(", ")}
        </p>}
        {part.blueprint.precision==="disputed" &&
          <p class="op-muted"><strong>Quellenkonflikt:</strong> Die Community-Quellen oder die offizielle SKPORT-Erwerbsart weichen voneinander ab. Bitte beide Originalquellen prüfen; keine der Kisten ist für dieses Teil als endgültig bestätigt markiert.</p>}
        {part.blueprint.precision==="specific-item" &&
          <p class="op-muted">Die Fundortangabe bezieht sich ausdrücklich auf dieses Rüstungsteil, nicht lediglich auf sein Set. Die genaue SKPORT-Marker-ID und ob du die Blaupause bereits besitzt, sind noch nicht bestätigt.</p>}
        {part.blueprint.precision==="set-family" &&
          <p class="op-muted">Nur Set-Hinweis: Die Fundorte sind noch nicht den konkreten Rüstungsteilen zugeordnet.</p>}
        <p class="op-muted">{part.blueprint.note}</p>
        {part.blueprint.claims.map(x=><p class="op-body-copy">Quelle / Kiste: {x.landmark}</p>)}
        {part.blueprint.sources.length>0 && <p class="op-body-copy">
          <strong>Quellen:</strong>{" "}
          {part.blueprint.sources.map((x,i)=><span>{i>0?" · ":""}<a href={x.url} target="_blank" rel="noopener noreferrer">{x.title}</a></span>)}
        </p>}
        {part.blueprint.areas.length===0 && part.blueprint.sources.length===0 &&
          <p class="op-muted">Noch kein belastbarer Fundort; persönliche Überprüfung erforderlich.</p>}
      </div>
    </details>}
    {part.detail.artificing.length>0&&<details class="op-details"><summary>Veredelungswerte</summary>
      {part.detail.artificing.flatMap(tab=>tab.tables).map(table=><table class="op-table">
        <thead><tr>{table.columns.map(value=><th>{value}</th>)}</tr></thead>
        <tbody>{table.rows.map(row=><tr>{row.cells.map(v=><td>{v}</td>)}</tr>)}</tbody></table>)}
    </details>}
  </> : <span class="op-muted">Offizielle Werte noch nicht vollständig verfügbar</span>}</td>
  <td>{part.detail?.standardRecipe?.materials?.length ?
    <MaterialCosts items={part.detail.standardRecipe.materials} /> :
    <span class="op-muted">{part.detail?.recipeStatus==="needs-review"?"Rezept muss geprüft werden":"Standardrezept nicht dokumentiert"}</span>}
  </td>
</tr>)}</tbody>
                </table></div>
                {b.craftingNotes && <p class="op-body-copy">{b.craftingNotes}</p>}
              </div></details>
            </div>)}
          </> : <p class="op-placeholder">[Noch keine Ausrüstungs-Builds]</p>}
        </div>
        <div class="op-divided"><h3>Ausrüstungsprogression</h3>
          {guide.equipment.progression.length ?
            <div class="op-mini-list">{guide.equipment.progression.map((p,i)=><div class="op-cardlet"><strong>{i+1}. {stageLabels[p.stage]}</strong><p class="op-body-copy">{p.note}</p></div>)}</div> :
            <p class="op-placeholder">[Progressionsübersicht nach Story und Fabrik folgt]</p>}
        </div>
      </section>
