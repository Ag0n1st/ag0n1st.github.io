---
import type { OperatorGuideModel } from "../../../lib/endfield/operatorGuideModel";
import ItemIcon from "../../endfield/ItemIcon.astro";
import { resolveOfficialItem } from "../../../lib/endfield/itemCatalog";

interface Props { model: OperatorGuideModel }
const { model } = Astro.props;
const { guide, operatorName, preview, gameData, extraData, trTerm, skillImage, slotLabels, slotIcons, priority, priorityOrder, priorityComparisons, shownWeapons, featuredBuild, videoEmbed, profilePartners, ratingRows, ratingValues, getOperatorImageUrl } = model;
const overviewWeapons=shownWeapons.map(w=>({
  ...w,official:resolveOfficialItem(w.name,"Weapons"),
}));
const overviewGear=featuredBuild?.items.map(reference=>({
  reference,official:resolveOfficialItem(reference,"Gear"),
}))??[];
---
<section class="op-section" id="uebersicht" aria-label="Übersicht">
        <div class="op-divided">
          <h2>Operator-Profil</h2>
          <div class="op-two">
            <article class="op-cardlet op-profile-card">
              <div class="op-profile-art">
                {gameData?.operator.illustrationUrl
                  ? <img src={getOperatorImageUrl(guide.operator,"illustration",gameData.operator.illustrationUrl)} loading="lazy" decoding="async" alt={"Offizielles Operator-Artwork: "+operatorName} />
                  : <span>[Horizontales Operator-Artwork]</span>}
              </div>
              {gameData?.operator.illustrationUrl && <span class="op-media-credit">Artwork: SKPORT Wiki · Originalquelle</span>}
              <h3>{operatorName}</h3>
              <div class="op-chip-row">
                <span class="op-chip is-pink">{gameData ? gameData.operator.rarity + "★" : "[Seltenheit]"}</span>
                <span class="op-chip">{trTerm(gameData?.operator.class) || "[Klasse]"}</span>
                <span class="op-chip">{trTerm(gameData?.operator.element) || "[Element]"}</span>
                <span class="op-chip">{gameData?.operator.weaponType || "[Waffentyp]"}</span>
              </div>
              {(guide.overview.traits.length>0 || preview) && <>
                <p>Traits</p>
                <div class="op-chip-row">
                  {guide.overview.traits.length>0
                    ? guide.overview.traits.map(trait=><span class="op-chip">{trait}</span>)
                    : <span class="op-chip">[Traits noch nicht eingetragen]</span>}
                </div>
              </>}
              <p>Attribute</p>
              <div class="op-chip-row"><span class="op-chip">Haupt: {trTerm(extraData?.attributes.mainAttribute) || "[Attribut]"}</span><span class="op-chip">Sekundär: {trTerm(extraData?.attributes.secondaryAttribute) || "[Attribut]"}</span></div>
            </article>
            <article class="op-cardlet">
              {videoEmbed ?
                <iframe class="op-video-embed" loading="lazy" src={videoEmbed} title={guide.guideVideo.title || "Videoguide zu "+operatorName} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> :
                <div class="op-video-placeholder"><div><span aria-hidden="true">▶</span><br />[YouTube-Videoguide]</div></div>
              }
              <div class="op-video-meta">
                <strong>{guide.guideVideo.title || "[Video-Guide zu "+operatorName+"]"}</strong>
                <p class="op-muted">Ag0n1st</p>
              </div>
              {guide.guideVideo.url && <p><a class="op-link" href={guide.guideVideo.url} target="_blank" rel="noopener noreferrer">Video auf YouTube / extern öffnen ↗</a></p>}
            </article>
          </div>
          <div class="op-two" style="margin-top:14px">
            <div class="op-cardlet"><h3>✓ Stärken</h3>{guide.overview.strengths.length ? guide.overview.strengths.map(s=><p class="op-body-copy">{s}</p>) : <p class="op-placeholder">[Stärken noch nicht eingetragen]</p>}</div>
            <div class="op-cardlet"><h3>− Schwächen</h3>{guide.overview.weaknesses.length ? guide.overview.weaknesses.map(s=><p class="op-body-copy">{s}</p>) : <p class="op-placeholder">[Schwächen noch nicht eingetragen]</p>}</div>
          </div>
          {guide.overview.summary && <p class="op-body-copy">{guide.overview.summary}</p>}
        </div>
        <div class="op-divided">
          <h2>Build auf einen Blick</h2>
          <div class="op-two">
            <article class="op-cardlet">
              <h3>Waffen</h3>
              <div class="op-mini-list">{overviewWeapons.length ? overviewWeapons.map(w=><div class="op-line"><div class="op-mini-art">{w.official ? <ItemIcon id={w.official.id}/> : "[Icon]"}</div><div class="op-line-label"><span class="op-chip">{w.label}</span><strong>{w.official?.name??w.name}</strong></div></div>) : <p class="op-placeholder">[Noch keine Waffenempfehlungen]</p>}</div>
            </article>
            <article class="op-cardlet">
              <h3>Ausrüstung · {featuredBuild ? featuredBuild.title : "Meta-Set"}</h3>
              {featuredBuild ? <div class="op-gear-parts">{overviewGear.map(part=><div class="op-gear-part"><div class="op-mini-art"><ItemIcon id={part.official?.id??part.reference} /></div><small>{part.official?.name??part.reference}</small></div>)}</div> : <p class="op-placeholder">[Noch kein Ausrüstungs-Build]</p>}
            </article>
            <article class="op-cardlet">
              <h3>Skill-Priorität</h3>
              {(priority || preview) ? <div class="op-skill-row">{priorityOrder.map((key,i)=><>
                <div class="op-priority-skill"><div class="op-mini-art">{skillImage(key) ? <img class="op-skill-icon" src={skillImage(key)} loading="lazy" decoding="async" alt="" /> : slotIcons[key]}</div><small>{slotLabels[key]}</small><b>{priority?.targetLevels[key] || "–"}</b></div>
                {i<3 && <span class="op-priority-symbol">{priorityComparisons[i]}</span>}
              </>)}</div> : <p class="op-placeholder">[Skill-Priorität folgt]</p>}
            </article>
            <article class="op-cardlet">
              <h3>Partners</h3>
              {profilePartners.length ?
                <>
                  <div class="op-gear-parts op-partners-grid">{profilePartners.map(partner=>
                    <div class="op-gear-part">
                      <div class="op-mini-art op-partner-art">
                        {partner.image
                          ? <img src={partner.image} loading="lazy" decoding="async" alt="" />
                          : <span aria-hidden="true">{partner.initials}</span>}
                      </div>
                      <small>{partner.name}</small>
                    </div>)}
                  </div>
                  <p class="op-partners-note">Weitere Partner und Teamkombinationen findest du unter <a class="op-link" href="#teams">Teams</a>.</p>
                </> :
                <p class="op-placeholder">[Meta-Teams und passende Partner folgen]</p>
              }
            </article>
          </div>
        </div>
        <div class="op-divided">
          <h2>Einordnung</h2>
          {ratingRows.map(([label,key,description])=>{
            const score=ratingValues[key];
            return <div class="op-rating">
              <div class="op-rating-header"><span>{label}</span><span>{score === undefined ? "–" : score} / 5</span></div>
              <div class="op-meter">{[1,2,3,4,5].map(n=><i class:list={{active:score!==undefined && n<=score}}></i>)}</div>
              <p>{description}</p>
            </div>;
          })}
        </div>
      </section>
