---
import type { OperatorGuideModel } from "../../../lib/endfield/operatorGuideModel";

interface Props { model: OperatorGuideModel }
const { model } = Astro.props;
const { guide, missing, weapons, shownWeapons } = model;
---
<section class="op-section" id="waffen">
        <h2>Waffen</h2>
        <div class="op-divided">
          <h3>Waffenempfehlungen</h3>
          {shownWeapons.length ? <div class="op-two">{shownWeapons.map(w=><article class="op-cardlet">
            <div class="op-line"><div class="op-mini-art">[Icon]</div><div class="op-line-label"><span class="op-chip">{w.label}</span><strong>{w.name}</strong></div></div>
            <p class="op-body-copy">{w.evaluation || "[Bewertung folgt]"}</p>
          </article>)}</div> : <p class="op-placeholder">[Noch keine Waffenempfehlungen]</p>}
          {guide.weapons.generalNotes && <p class="op-body-copy">{guide.weapons.generalNotes}</p>}
        </div>
        <div class="op-divided">
          <h3>Waffendetails</h3>
          {shownWeapons.length ? <>
            <div class="op-pills" aria-label="Waffe auswählen">{shownWeapons.map((w,i)=><button class="op-pill-button" type="button" data-weapon-button={w.id} aria-pressed={i===0?"true":"false"}>{w.label} {shownWeapons.filter(x=>x.label===w.label).length>1 ? "· "+w.name : ""}</button>)}</div>
            {shownWeapons.map((w,i)=><div class="op-weapon-panel op-cardlet" data-weapon-panel={w.id} hidden={i!==0}>
              <div class="op-line"><div class="op-mini-art">[Icon]</div><div class="op-line-label"><strong>{w.name}</strong><span class="op-muted">{w.label}</span></div></div>
              <div class="op-info-grid" style="margin-top:13px">{["Basis-ATK","Hauptattribut","Sekundärattribut","Waffeneffekt"].map(label=><div class="op-info-field"><small>{label}</small><strong>[Spieldaten folgen]</strong></div>)}</div>
              {w.source && <p><strong>Bezugsquelle:</strong> {w.source}</p>}
              <p class="op-body-copy"><strong>Bewertung</strong><br />{w.evaluation || missing}</p>
              <details class="op-details"><summary>Level, Veredelung & Upgrade-Materialien</summary><div class="op-details-body">[Werte, Veredelungsstufen und Materialkosten folgen]</div></details>
            </div>)}
          </> : <p class="op-placeholder">[Waffendetails werden nach dem Datenimport angezeigt]</p>}
        </div>
        <div class="op-divided"><h3>Waffenvergleich</h3>
          <p class="op-section-intro">Nur auf Basis nachvollziehbarer Berechnungen und Vergleichsbedingungen.</p>
          {weapons.some(w=>w.performancePercent!==undefined) ?
            <div class="op-table-wrap"><table class="op-table">
              <thead><tr><th>Waffe</th><th>Relative Leistung</th><th>Vergleichsbedingungen</th></tr></thead>
              <tbody>{weapons.filter(w=>w.performancePercent!==undefined).map(w=><tr><td>{w.name}</td><td>{w.performancePercent} %</td><td>{w.comparisonConditions}</td></tr>)}</tbody>
            </table></div> :
            <p class="op-placeholder">[Noch keine belastbaren Vergleichswerte]</p>}
        </div>
      </section>
