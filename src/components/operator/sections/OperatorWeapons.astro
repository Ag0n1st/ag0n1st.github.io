---
import type { OperatorGuideModel } from "../../../lib/endfield/operatorGuideModel";
import ItemIcon from "../../endfield/ItemIcon.astro";
import MaterialCosts from "../../endfield/MaterialCosts.astro";
import { resolveOfficialItem } from "../../../lib/endfield/itemCatalog";
import { getOfficialWeapon } from "../../../lib/endfield/equipmentDetails";
import type { DetailTable } from "../../../lib/endfield/equipmentDetails";

interface Props { model: OperatorGuideModel }
const { model } = Astro.props;
const t=(value:string)=>guideText(model.lang,value);
const { guide, weapons, shownWeapons } = model;

const officialWeapons=shownWeapons.map(w=>{
  const item=resolveOfficialItem(w.name,"Weapons");
  const data=item?getOfficialWeapon(item.id):undefined;
  const preview=data?.attributes.flatMap(tab=>tab.tables)[0];
  const previewRows=preview?.rows??[];
  const effectRow=previewRows.length>3 ? previewRows[previewRows.length-1] : undefined;
  const attributeRows=effectRow ? previewRows.slice(0,-1) : previewRows;
  const tuningStages=(data?.tuning??[]).map((tab,index,all)=>{
    const rows=tab.tables.flatMap(table=>table.rows);
    return {
      label:index===0?"Ausgangswert":index===all.length-1?"Maximalwert":"Tuning "+index,
      rows,
      costs:rows.flatMap(row=>row.costs??[])
    };
  });
  return {...w,item,data,attributeRows,effectRow,tuningStages};
});

/** Preserve all official SKPORT values, while joining fragmented empty-header columns. */
function tuningValue(row:DetailTable["rows"][number]|undefined){
  if(!row)return "–";
  const cells=row.cells;
  const before=[cells[1],cells[2]].filter(value=>value && value!=="None").join(" · ");
  const after=[cells[3],cells[4]].filter(value=>value && value!=="None").join(" · ");
  return after ? before+" → "+after : before||"–";
}
import { guideText } from "../../../lib/i18n/guideUi";
---
<section class="op-section" id="waffen">
  <h2>{t("Waffen")}</h2>
  <div class="op-divided">
    <h3>{t("Waffenempfehlungen")}</h3>
    {officialWeapons.length ? <div class="op-two">{officialWeapons.map(w=><article class="op-cardlet">
      <div class="op-line">
        <div class="op-mini-art">{w.item ? <ItemIcon id={w.item.id}/> : <span aria-hidden="true">–</span>}</div>
        <div class="op-line-label"><span class="op-chip">{w.label}</span><strong>{w.item?.name??w.name}</strong></div>
      </div>
      {w.evaluation && <p class="op-body-copy">{w.evaluation}</p>}
    </article>)}</div> : <p class="op-muted">{t("Keine Waffenempfehlungen eingetragen.")}</p>}
    {guide.weapons.generalNotes && <p class="op-body-copy">{guide.weapons.generalNotes}</p>}
  </div>
  <details class="op-divided op-guide-accordion" data-guide-disclosure="weapon-details">
    <summary class="op-guide-accordion-summary"><h3>{t("Waffendetails")}</h3><span class="op-guide-accordion-hint">{t("Details anzeigen")}</span></summary>
    <div class="op-guide-accordion-content">
      {officialWeapons.length ? <>
        <div class="op-pills" aria-label="Waffe auswählen">
          {officialWeapons.map((w,i)=><button class="op-pill-button" type="button" data-weapon-button={w.id} aria-pressed={i===0?"true":"false"}>{w.label}{officialWeapons.filter(x=>x.label===w.label).length>1 ? " · "+(w.item?.name??w.name) : ""}</button>)}
        </div>
        {officialWeapons.map((w,i)=><article class="op-weapon-panel op-cardlet" data-weapon-panel={w.id} hidden={i!==0}>
          <div class="op-line op-weapon-panel-heading">
            <div class="op-mini-art">{w.item ? <ItemIcon id={w.item.id}/> : <span aria-hidden="true">–</span>}</div>
            <div class="op-line-label"><strong>{w.item?.name??w.name}</strong><span class="op-muted">{w.label}</span></div>
          </div>
          {w.data?.status==="verified" ? <>
            <h4 class="op-weapon-subtitle">{t("Basiswerte und maximale Werte")}</h4>
            {w.attributeRows.length>0 && <div class="op-table-wrap">
              <table class="op-table op-weapon-attributes-table">
                <thead><tr><th scope="col">{t("Attribut")}</th><th scope="col">{t("Startwert")}</th><th scope="col">{t("Maximalwert")}</th></tr></thead>
                <tbody>{w.attributeRows.map(row=><tr>
                  <th scope="row">{row.cells[0]}</th>
                  <td>{row.cells[1]}{row.cells[2] && <small class="op-weapon-rank">{row.cells[2]}</small>}</td>
                  <td>{row.cells[3]||row.cells[1]}{row.cells[4] && <small class="op-weapon-rank">{row.cells[4]}</small>}</td>
                </tr>)}</tbody>
              </table>
            </div>}
            {w.effectRow && <div class="op-weapon-effect-summary">
              <h4>{w.effectRow.cells[0]}</h4>
              <div class="op-weapon-effect-grid">
                <div class="op-weapon-effect-copy">
                  <strong>Startwert{w.effectRow.cells[2] ? " · "+w.effectRow.cells[2] : ""}</strong>
                  <p class="op-body-copy">{w.effectRow.cells[1]}</p>
                </div>
                <div class="op-weapon-effect-copy">
                  <strong>Maximalwert{w.effectRow.cells[4] ? " · "+w.effectRow.cells[4] : ""}</strong>
                  <p class="op-body-copy">{w.effectRow.cells[3]||w.effectRow.cells[1]}</p>
                </div>
              </div>
            </div>}
            {w.evaluation && <p class="op-body-copy op-weapon-evaluation"><strong>{t("Einordnung")}</strong><br />{w.evaluation}</p>}
            <details class="op-details op-weapon-detailed-stats">
              <summary>{t("Tuning-Stufen, Rangwerte und Waffenpotenziale")}</summary>
              <div class="op-details-body">
                {w.tuningStages.length>0 && <div class="op-weapon-data-group">
                  <h4>{t("Tuning-Stufen & Materialkosten")}</h4>
                  <div class="op-table-wrap">
                    <table class="op-table op-weapon-tuning-table">
                      <thead><tr>
                        <th scope="col">{t("Stufe")}</th>
                        <th scope="col">{t("Basis-ANG")}</th>
                        <th scope="col">{w.tuningStages[0]?.rows[1]?.cells[0]||"Attribut 1"}</th>
                        <th scope="col">{w.tuningStages[0]?.rows[2]?.cells[0]||"Attribut 2"}</th>
                        <th scope="col">{t("Materialien")}</th>
                      </tr></thead>
                      <tbody>{w.tuningStages.map(stage=><tr>
                        <th scope="row">{stage.label}</th>
                        <td>{tuningValue(stage.rows[0])}</td>
                        <td>{tuningValue(stage.rows[1])}</td>
                        <td>{tuningValue(stage.rows[2])}</td>
                        <td class="op-weapon-material-cell">
                          {stage.costs.length ? <MaterialCosts items={stage.costs}/> : <span class="op-muted">–</span>}
                        </td>
                      </tr>)}</tbody>
                    </table>
                  </div>
                  <p class="op-muted op-weapon-data-note">{t("Materialien gelten für den Übergang auf die jeweilige Tuning-Stufe. Die Anfangs- und Endwert-Zeilen haben keine separaten Tuning-Kosten.")}</p>
                </div>}
                {[
                  {title:"Waffenwerte nach Rang",tabs:w.data.details},
                  {title:"Waffenpotenziale",tabs:w.data.potentials}
                ].map(group=>group.tabs.some(tab=>tab.tables.length>0) && <div class="op-weapon-data-group">
                  <h4>{group.title}</h4>
                  {group.tabs.map(tab=>tab.tables.map(table=><div class="op-table-wrap">
                    <table class="op-table op-weapon-matrix-table">
                      <thead><tr>{table.columns.map((header,index)=><th scope="col">
                        {header|| (group.title==="Waffenwerte nach Rang"?"Waffenrang":"Potenzial")}
                      </th>)}</tr></thead>
                      <tbody>{table.rows.map(row=><tr>{row.cells.map((value,index)=>index===0 ?
                        <th scope="row">{value||"–"}</th>:
                        <td>{value || "–"}</td>)}</tr>)}</tbody>
                    </table>
                  </div>))}
                </div>)}
                <p class="op-muted op-weapon-source">Quelle: SKPORT-Wiki · Datenstand {w.data.source.snapshot}</p>
              </div>
            </details>
          </> : <p class="op-muted">{t("Für diese Waffe liegen noch keine vollständig geprüften SKPORT-Detailwerte vor.")}</p>}
        </article>)}
      </> : <p class="op-muted">Noch keine Waffendaten hinterlegt.</p>}
    </div>
  </details>
  <details class="op-divided op-guide-accordion" data-guide-disclosure="weapon-comparison">
    <summary class="op-guide-accordion-summary"><h3>{t("Waffenvergleich")}</h3><span class="op-guide-accordion-hint">{t("Vergleich anzeigen")}</span></summary>
    <div class="op-guide-accordion-content">
      {guide.weapons.comparisons.length>0 ?
        <div class="op-comparison-scenarios">
          {guide.weapons.comparisons.map(scenario=>
            <article class="op-cardlet op-comparison-scenario">
              <h4>{scenario.title}</h4>
              <p class="op-muted">Referenz: {resolveOfficialItem(scenario.referenceWeaponId,"Weapons")?.name??scenario.referenceWeaponId} R{scenario.referenceRank} = 100,0 %</p>
              <div class="op-table-wrap"><table class="op-table">
                <thead><tr><th>{t("Waffe")}</th><th>{t("Rang")}</th><th>{t("Relative Leistung")}</th></tr></thead>
                <tbody>{scenario.entries.map(entry=><tr>
                  <td>{resolveOfficialItem(entry.weaponId,"Weapons")?.name??entry.weaponId}</td>
                  <td>R{entry.rank}</td>
                  <td>{entry.performancePercent.toLocaleString("de-DE",{minimumFractionDigits:1,maximumFractionDigits:1})} %</td>
                </tr>)}</tbody>
              </table></div>
              <small class="op-data-source-note">Quelle: {scenario.sourceNote}</small>
            </article>)}
        </div> :
        weapons.some(w=>w.performancePercent!==undefined) ?
          <div class="op-table-wrap"><table class="op-table">
            <thead><tr><th>{t("Waffe")}</th><th>{t("Relative Leistung")}</th></tr></thead>
            <tbody>{weapons.filter(w=>w.performancePercent!==undefined).map(w=><tr>
              <td>{resolveOfficialItem(w.name,"Weapons")?.name??w.name}</td>
              <td>{w.performancePercent} %</td>
            </tr>)}</tbody>
          </table><small class="op-data-source-note">Quelle: {weapons.find(w=>w.source)?.source??"nicht angegeben"}</small></div> :
          <p class="op-muted">{t("Noch keine belastbaren Waffenvergleichswerte vorhanden.")}</p>}
    </div>
  </details>
</section>
