---
import type { OperatorGuideModel } from "../../../lib/endfield/operatorGuideModel";
import { getGuideThumbnailUrl } from "../../../lib/endfield/operatorAssets";

interface Props { model: OperatorGuideModel }
const { model } = Astro.props;
const { guide, showcaseTypeLabels, showcases, selectedShowcaseIndex, youtubeEmbed } = model;
---
<section class="op-section" id="gameplay">
        {guide.gameplay.pending ? <>
          <div class="op-gameplay-pending-header">
            <span class="op-gameplay-pending-label" aria-label="Gameplay-Videos folgen">FOLGT</span>
            <h2>Gameplay</h2>
          </div>
          <p class="op-muted op-body-copy">Gameplay-Videos und Showcases werden später ergänzt.</p>
        </> : <>
        <h2>Gameplay</h2>
        <p class="op-section-intro">Bestehende Gameplay-Runs mit optionalen Rotationshinweisen; jederzeit erweiterbar.</p>
        {showcases.length ? <>
          <div class="op-divided">
            {showcases.map((run,i)=>{
              const embed=youtubeEmbed(run.url);
              return <div class="op-showcase-panel op-cardlet" data-showcase-panel={run.id} hidden={i!==selectedShowcaseIndex}>
                <div class="op-subtitle"><h3 style="margin:0">{run.title}</h3><span class="op-chip">{showcaseTypeLabels[run.type]}</span></div>
                {embed ?
                  <iframe class="op-video-embed" loading="lazy" src={embed} title={run.title} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> :
                  <div class="op-notice" style="margin-top:12px">Zu diesem Eintrag ist kein eigenständiger Video-Link hinterlegt. Die schriftlichen Rotationshinweise sind unten verfügbar.</div>
                }
                {run.url && <p><a class="op-link" href={run.url} target="_blank" rel="noopener noreferrer">Run öffnen ↗</a></p>}
                {run.description && <p class="op-body-copy">{run.description}</p>}
                {run.rotationAndTips && <details class="op-details"><summary>Rotation & Tipps</summary><div class="op-details-body"><p class="op-body-copy">{run.rotationAndTips}</p></div></details>}
              </div>;
            })}
          </div>
          <div class="op-divided"><h3>Weitere Runs</h3>
            <div class="op-media-list">{showcases.map((run,i)=><button type="button" class="op-cardlet op-showcase-button" data-showcase-button={run.id} aria-pressed={i===selectedShowcaseIndex?"true":"false"} style="text-align:left;color:inherit;font:inherit;cursor:pointer"><div class="op-faux-thumb">{getGuideThumbnailUrl(run.url)
                  ? <img src={getGuideThumbnailUrl(run.url)} width="320" height="180" alt="" loading="lazy" decoding="async" />
                  : <span>{run.title}</span>}</div><strong style="display:block;font-size:12px;margin-top:10px">{run.title}</strong><span class="op-muted">{showcaseTypeLabels[run.type]}</span></button>)}</div>
          </div>
        </> : <p class="op-placeholder">[Noch keine Gameplay-Showcases hinterlegt]</p>}
        </>}
      </section>
