---
import type { CollectionEntry } from "astro:content";
import type { ImportedOperator, ImportedOperatorExtras, ImportedItemCost } from "../../lib/endfield/operatorData";
import type { OperatorLocale } from "../../lib/endfield/operatorLocale";
import { getOperatorImageUrl } from "../../lib/endfield/operatorAssets";

type GuideData = CollectionEntry<"operator-guides">["data"];
interface Props { guide: GuideData; operatorName: string; preview?: boolean; gameData?: ImportedOperator; extraData?: ImportedOperatorExtras; localized?: OperatorLocale; }
const { guide, operatorName, preview = false, gameData, extraData, localized } = Astro.props;
const trTerm = (word?: string) => word ? localized?.operatorTerms[word] ?? word : "";
const trMetric = (name:string) => localized?.metricLabels[name] ?? name;
const trReq = (req:string) => localized?.requirementLabels[req] ?? req;
const trTalent = (id:string,index:number,english:string) =>
  localized?.talents[id]?.levelEffects[index] ?? english;
const trPotential = (level:number,english:string) =>
  localized?.potentials[String(level)]?.effect ?? english;
const trPromotion = (name:string) => localized?.promotions[name];

const officialPotentials = new Map((extraData?.potentials ?? []).map(p => [p.level,p]));
const combatTalents = extraData?.talents.filter(t => t.category === "combat") ?? [];
const shipTalents = extraData?.talents.filter(t => t.category === "ship") ?? [];
const attributeNodes = extraData?.talents.filter(t => t.category === "attribute") ?? [];
const otherTalents = extraData?.talents.filter(t => t.category === "other") ?? [];
function formatCost(items: ImportedItemCost[]):string {
  if (!items?.length) return "–";
  return items.map(item => (localized?.materials[item.id] ?? extraData?.materials[item.id]?.name ?? "Item "+item.id) +
    " × " + item.count.toLocaleString("de-DE")).join(" · ");
}

const gameSkills = gameData?.skills ?? [];
const importedBySlot = new Map(gameSkills.map(skill => [skill.slot,skill]));
const skillImage = (slot: string) =>
  getOperatorImageUrl(guide.operator, ("skill-"+slot) as "skill-basic" | "skill-battle" | "skill-combo" | "skill-ultimate", importedBySlot.get(slot)?.iconUrl);
const defaultSkillRank = 8; // Rank 9, never a guide skill-priority recommendation.


const missing = "[Noch keine Angaben]";
const slotLabels: Record<string,string> = {
  basic: "Basis-Angriff", battle: "Kampffertigkeit",
  combo: "Kombofertigkeit", ultimate: "Ultimative Fertigkeit"
};
const slotIcons: Record<string,string> = {
  basic: "BA", battle: "KF", combo: "KO", ultimate: "ULT"
};
const priority = guide.skills.priority;
const priorityOrder = priority?.order ?? ["basic","battle","combo","ultimate"];
const priorityComparisons = priority?.comparisons ?? ["·","·","·"];
const weaponLabels: Record<string,string> = {
  bis:"Best in Slot",bp:"Battle Pass",f2p:"F2P",alternative:"Alternative"
};
const roleLabels: Record<string,string> = {
  "main-dps":"Main DPS","sub-dps":"Sub DPS",support:"Support",
  hybrid:"Hybrid",control:"Control",other:"Weitere Rolle"
};
const stageLabels: Record<string,string> = {
  early:"Early Game",mid:"Mid Game",late:"Late Game",endgame:"Endgame"
};
const showcaseTypeLabels: Record<string,string> = {
  trial:"Trial Run",boss:"Bosskampf",speedrun:"Speedrun",other:"Gameplay"
};
const pullLabels: Record<string,string> = {
  recommended:"Klare Empfehlung",conditional:"Situationsabhängig",
  optional:"Eher verzichtbar"
};

const weapons = guide.weapons.recommendations.map((w,i) => ({
  id:"weapon-"+i, label:weaponLabels[w.category], name:w.weaponId,
  source:w.sourceNote, evaluation:w.evaluation,
  comparisonConditions:w.comparisonConditions,
  performancePercent:w.performancePercent
}));
const demoWeapons = [
  {id:"demo-bis",label:"Best in Slot",name:"[BiS-Waffe]",source:"",evaluation:"",comparisonConditions:"",performancePercent:undefined},
  {id:"demo-bp",label:"Battle Pass",name:"[BP-Waffe]",source:"",evaluation:"",comparisonConditions:"",performancePercent:undefined},
  {id:"demo-f2p",label:"F2P",name:"[F2P-Waffe]",source:"",evaluation:"",comparisonConditions:"",performancePercent:undefined},
  {id:"demo-alt",label:"Alternative",name:"[Alternative Waffe]",source:"",evaluation:"",comparisonConditions:"",performancePercent:undefined}
];
const shownWeapons = weapons.length ? weapons : preview ? demoWeapons : [];

const demoBuilds = [
  {id:"demo-main",title:"[Build A – Main DPS]",role:"main-dps",items:["[Teil 1]","[Teil 2]","[Teil 3]","[Teil 4]"],evaluation:"",teamContext:"",factoryUnlock:"",craftingNotes:"",setBonusNotes:"",availableFromLevel:undefined},
  {id:"demo-support",title:"[Build B – Support]",role:"support",items:["[Teil 1]","[Teil 2]","[Teil 3]","[Teil 4]"],evaluation:"",teamContext:"",factoryUnlock:"",craftingNotes:"",setBonusNotes:"",availableFromLevel:undefined},
  {id:"demo-hybrid",title:"[Build C – Hybrid]",role:"hybrid",items:["[Teil 1]","[Teil 2]","[Teil 3]","[Teil 4]"],evaluation:"",teamContext:"",factoryUnlock:"",craftingNotes:"",setBonusNotes:"",availableFromLevel:undefined}
];
const builds = guide.equipment.builds.length ? guide.equipment.builds : preview ? demoBuilds : [];
const featuredBuild = builds.find(b => b.id === guide.overview.featuredBuildId) ?? builds[0];

const demoTeams = [
  {id:"demo-team-1",title:"[Main-DPS-Team]",role:"main-dps",members:[guide.operator,"[Op 2]","[Op 3]","[Op 4]"],buildId:"demo-main",note:"",evaluation:""},
  {id:"demo-team-2",title:"[Support-Team]",role:"support",members:[guide.operator,"[Op 2]","[Op 3]","[Op 4]"],buildId:"demo-support",note:"",evaluation:""}
];
const metaTeams = guide.teams.meta.length ? guide.teams.meta : preview ? demoTeams : [];
const extraTeams = guide.teams.more.length ? guide.teams.more : preview ?
  Array.from({length:8},(_,i)=>({
    id:"demo-extra-"+i,title:"[Teamoption "+(i+1)+"]",
    role:i%3===0?"main-dps":i%3===1?"support":"hybrid",
    members:[guide.operator,"[Op 2]","[Op 3]","[Op 4]"],
    buildId:i%3===0?"demo-main":i%3===1?"demo-support":"demo-hybrid",
    note:"",evaluation:""
  })) : [];
const teamRoles = [...new Set(extraTeams.map(team=>team.role))];

const demoShowcases = [
  {id:"demo-trial",title:"[Operator-Probe]",type:"trial",url:undefined,description:"[Trial Run mit einer repräsentativen Rotation]",rotationAndTips:"",featured:true},
  {id:"demo-boss",title:"[Boss-Showcase]",type:"boss",url:undefined,description:"[Zusätzlicher Bosskampf]",rotationAndTips:"",featured:false},
  {id:"demo-speed",title:"[Speedrun]",type:"speedrun",url:undefined,description:"[Optimierter Run]",rotationAndTips:"",featured:false},
];
const showcases = guide.gameplay.showcases.length ? guide.gameplay.showcases : preview ? demoShowcases : [];
const selectedShowcaseIndex = Math.max(0,showcases.findIndex(s=>s.featured));

function youtubeEmbed(url?:string):string|null {
  if (!url) return null;
  try {
    const parsed=new URL(url);
    const host=parsed.hostname.toLowerCase();
    let id:string|null=null;
    if(host==="youtu.be" || host==="www.youtu.be") id=parsed.pathname.slice(1).split("/")[0];
    else if(["youtube.com","www.youtube.com","m.youtube.com","youtube-nocookie.com","www.youtube-nocookie.com"].includes(host)) {
      if(parsed.pathname==="/watch") id=parsed.searchParams.get("v");
      else if(parsed.pathname.startsWith("/shorts/")||parsed.pathname.startsWith("/embed/")||parsed.pathname.startsWith("/live/")) id=parsed.pathname.split("/")[2];
    }
    return id && /^[a-zA-Z0-9_-]{11}$/.test(id) ? "https://www.youtube-nocookie.com/embed/"+id : null;
  }catch{return null;}
}
const videoEmbed=youtubeEmbed(guide.guideVideo.url);
const ratingRows = [
  ["Spielschwierigkeit","difficulty","Wie anspruchsvoll sind die Mechaniken?"],
  ["Flexibilität","flexibility","Wie leicht lässt sich der Operator in Teams einbauen?"],
  ["Zugänglichkeit","accessibility","Wie einfach kommt man an die benötigten Ressourcen?"]
] as const;
const potentialByLevel = new Map(guide.potentials.entries.map(p=>[p.level,p]));
---
<main class="op-page section-wrap">
  <nav class="op-breadcrumb" aria-label="Brotkrumennavigation">
    <a href="/endfield/">Endfield</a><span aria-hidden="true">›</span>
    <a href="/endfield/operatoren/">Operatoren</a><span aria-hidden="true">›</span>
    <span aria-current="page">{operatorName}</span>
  </nav>
  {preview && <div class="op-notice op-preview-banner" role="status">Layout-Vorschau: Für {operatorName} sind noch nicht alle Daten eingepflegt. Eckige Klammern kennzeichnen Platzhalter.</div>}
  {localized && <p class="op-muted op-locale-note">SKPORT-Datenstand: {localized.sourceSnapshot} · {localized.terminologyNote}</p>}
  <div class="op-guide">
    <div class="op-guide-content">
      <!-- 1. Übersicht -->
      <section class="op-section" id="uebersicht" aria-label="Übersicht">
        <div class="op-divided">
          <h2>Charakter-Profil</h2>
          <div class="op-two">
            <article class="op-cardlet op-profile-card">
              <div class="op-profile-art">
                {gameData?.operator.illustrationUrl
                  ? <img src={getOperatorImageUrl(guide.operator,"illustration",gameData.operator.illustrationUrl)} loading="lazy" decoding="async" alt={"Offizielles Operator-Artwork: "+operatorName} />
                  : <span>[Horizontales Operator-Artwork]</span>}
              </div>
              {gameData?.operator.illustrationUrl && <span class="op-media-credit">Artwork: SKPORT Wiki · Originalquelle</span>}
              <h3>{operatorName}</h3>
              <div class="op-chip-row">
                <span class="op-chip is-pink">{gameData ? gameData.operator.rarity + "★" : "[Seltenheit]"}</span>
                <span class="op-chip">{trTerm(gameData?.operator.class) || "[Klasse]"}</span>
                <span class="op-chip">{trTerm(gameData?.operator.element) || "[Element]"}</span>
                <span class="op-chip">{gameData?.operator.weaponType || "[Waffentyp]"}</span>
              </div>
              <p>Traits</p>
              <div class="op-chip-row"><span class="op-chip">[Trait 1]</span><span class="op-chip">[Trait 2]</span></div>
              <p>Attribute</p>
              <div class="op-chip-row"><span class="op-chip">Haupt: {trTerm(extraData?.attributes.mainAttribute) || "[Attribut]"}</span><span class="op-chip">Sekundär: {trTerm(extraData?.attributes.secondaryAttribute) || "[Attribut]"}</span></div>
            </article>
            <article class="op-cardlet">
              {videoEmbed ?
                <iframe class="op-video-embed" loading="lazy" src={videoEmbed} title={guide.guideVideo.title || "Videoguide zu "+operatorName} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> :
                <div class="op-video-placeholder"><div><span aria-hidden="true">▶</span><br />[YouTube-Videoguide]</div></div>
              }
              <div class="op-video-meta">
                <strong>{guide.guideVideo.title || "[Video-Guide zu "+operatorName+"]"}</strong>
                <p class="op-muted">Ag0n1st</p>
              </div>
              {guide.guideVideo.url && <p><a class="op-link" href={guide.guideVideo.url} target="_blank" rel="noopener noreferrer">Video auf YouTube / extern öffnen ↗</a></p>}
            </article>
          </div>
          <div class="op-two" style="margin-top:14px">
            <div class="op-cardlet"><h3>✓ Stärken</h3>{guide.overview.strengths.length ? guide.overview.strengths.map(s=><p class="op-body-copy">{s}</p>) : <p class="op-placeholder">[Stärken noch nicht eingetragen]</p>}</div>
            <div class="op-cardlet"><h3>− Schwächen</h3>{guide.overview.weaknesses.length ? guide.overview.weaknesses.map(s=><p class="op-body-copy">{s}</p>) : <p class="op-placeholder">[Schwächen noch nicht eingetragen]</p>}</div>
          </div>
          {guide.overview.summary && <p class="op-body-copy">{guide.overview.summary}</p>}
        </div>
        <div class="op-divided">
          <h2>Build auf einen Blick</h2>
          <div class="op-two">
            <article class="op-cardlet">
              <h3>Waffen</h3>
              <div class="op-mini-list">{shownWeapons.length ? shownWeapons.map(w=><div class="op-line"><div class="op-mini-art">[Icon]</div><div class="op-line-label"><span class="op-chip">{w.label}</span><strong>{w.name}</strong></div></div>) : <p class="op-placeholder">[Noch keine Waffenempfehlungen]</p>}</div>
            </article>
            <article class="op-cardlet">
              <h3>Ausrüstung · {featuredBuild ? featuredBuild.title : "Meta-Set"}</h3>
              {featuredBuild ? <div class="op-gear-parts">{featuredBuild.items.map(item=><div class="op-gear-part"><div class="op-mini-art">[Icon]</div><small>{item}</small></div>)}</div> : <p class="op-placeholder">[Noch kein Ausrüstungs-Build]</p>}
            </article>
            <article class="op-cardlet">
              <h3>Skill-Priorität</h3>
              {(priority || preview) ? <div class="op-skill-row">{priorityOrder.map((key,i)=><>
                <div class="op-priority-skill"><div class="op-mini-art">{skillImage(key) ? <img class="op-skill-icon" src={skillImage(key)} loading="lazy" decoding="async" alt="" /> : slotIcons[key]}</div><small>{slotLabels[key]}</small><b>{priority?.targetLevels[key] || "–"}</b></div>
                {i<3 && <span class="op-priority-symbol">{priorityComparisons[i]}</span>}
              </>)}</div> : <p class="op-placeholder">[Skill-Priorität folgt]</p>}
            </article>
            <article class="op-cardlet">
              <h3>Partners</h3>
              {guide.overview.partners.length ?
                <div class="op-gear-parts">{guide.overview.partners.map(name=><div class="op-gear-part"><div class="op-mini-art">[Op]</div><small>{name}</small></div>)}</div> :
                <p class="op-placeholder">[Empfohlene Operatoren folgen]</p>
              }
            </article>
          </div>
        </div>
        <div class="op-divided">
          <h2>Einordnung</h2>
          {ratingRows.map(([label,key,description])=>{
            const score=guide.overview.ratings[key];
            return <div class="op-rating">
              <div class="op-rating-header"><span>{label}</span><span>{score === undefined ? "–" : score} / 5</span></div>
              <div class="op-meter">{[1,2,3,4,5].map(n=><i class:list={{active:score!==undefined && n<=score}}></i>)}</div>
              <p>{description}</p>
            </div>;
          })}
        </div>
      </section>

      <!-- 2. Operator Kit -->
      <section class="op-section" id="operator-kit">
        <h2>Operator Kit</h2>
        <div class="op-divided">
          <h3>Operator-Profil & Spielweise</h3>
          <div class="op-info-grid">{[
              ["Klasse",trTerm(gameData?.operator.class)],["Element",trTerm(gameData?.operator.element)],
              ["Fraktion",gameData?.operator.faction],["Hauptattribut",trTerm(extraData?.attributes.mainAttribute)],
              ["Sekundärattribut",trTerm(extraData?.attributes.secondaryAttribute)],["Waffentyp",gameData?.operator.weaponType]
            ].map(([label,value])=><div class="op-info-field"><small>{label}</small><strong>{value || "[Spieldaten folgen]"}</strong></div>)}</div>
          <p class="op-muted op-body-copy">{guide.operatorKit.playstyle || "[Spielweise und Grundlagen folgen]"}</p>
        </div>
        <div class="op-divided">
          <h3>Attributentwicklung</h3>
          {extraData ? <>
            <p class="op-section-intro">Originalwerte der englischen SKPORT-Wiki für die dort angegebenen Levelstufen. Dies sind keine Ausrüstungslevel.</p>
            <div class="op-table-wrap"><table class="op-table op-progression-table">
              <thead><tr><th>Attribut</th>{extraData.attributes.levels.map(level=><th>{level}</th>)}</tr></thead>
              <tbody>{extraData.attributes.metrics.map(metric=><tr><th scope="row" title={metric.name}>{trMetric(metric.name.replace(/ \((Main|Secondary)\)/,""))}{metric.name.includes("(Main)") ? " ★" : metric.name.includes("(Secondary)") ? " ☆" : ""}</th>{metric.values.map(value=><td>{value}</td>)}</tr>)}</tbody>
            </table></div>
            <details class="op-details"><summary>Materialkosten nach Operator-Level</summary>
              <div class="op-details-body op-table-wrap"><table class="op-table">
                <thead><tr><th>Operator-Level</th><th>Materialien laut Wiki</th></tr></thead>
                <tbody>{extraData.attributes.levelCosts.map(row=><tr><td>{row.level}</td><td>{formatCost(row.items)}</td></tr>)}</tbody>
              </table></div>
            </details>
          </> : <p class="op-placeholder">[Attributwerte werden nach dem SKPORT-Import angezeigt]</p>}
        </div>
        <div class="op-divided">
          <h3>Operator-Aufstieg & Freischaltungen</h3>
          <p class="op-section-intro">Promotion und Outfitting sind unterschiedliche Freischaltungen. Die Levelangaben entsprechen den offiziellen Operator-Meilensteinen.</p>
          <div class="op-table-wrap"><table class="op-table op-progression-table">
            <thead><tr><th>Aufstieg</th><th>Freischaltung</th><th>Voraussetzung</th><th>Materialien</th></tr></thead>
            <tbody>{extraData ? extraData.promotions.map(p=><tr>
              <td><strong>{trPromotion(p.name)?.name ?? p.name}</strong></td><td>{trPromotion(p.name)?.effect ?? p.effect}</td><td>{trReq(p.requirement)}</td>
              <td>{formatCost(p.cost)}</td>
            </tr>) : [1,2,3,4,5].map(n=><tr><td>[Stufe {n}]</td><td>[Freischaltung]</td><td>[Level/Story]</td><td>[Materialien]</td></tr>)}</tbody>
          </table></div>
          {guide.operatorKit.progressionNotes && <p class="op-body-copy">{guide.operatorKit.progressionNotes}</p>}
        </div>
        <div class="op-divided">
          <h3>Ressourcen & Verfügbarkeit</h3>
          <div class="op-cardlet"><p class="op-body-copy">{guide.operatorKit.resourceNotes || "[Bezugsquellen und Freischaltbedingungen folgen]"}</p></div>
        </div>
      </section>

      <!-- 3. Fertigkeiten -->
      <section class="op-section" id="fertigkeiten">
        <h2>Fertigkeiten</h2>
        <div class="op-cardlet" style="margin-bottom:15px">
          <h3>Skill-Priorität</h3>
          {(priority || preview) ? <div class="op-skill-row">{priorityOrder.map((key,i)=><>
            <div class="op-priority-skill"><div class="op-mini-art">{skillImage(key) ? <img class="op-skill-icon" src={skillImage(key)} loading="lazy" decoding="async" alt="" /> : slotIcons[key]}</div><small>{slotLabels[key]}</small><b>{priority?.targetLevels[key] || "–"}</b></div>
            {i<3&&<span class="op-priority-symbol">{priorityComparisons[i]}</span>}
          </>)}</div> : <p class="op-placeholder">[Skill-Priorität folgt]</p>}
        </div>
        <div class="op-divided">
          <h3>Kampffertigkeiten</h3>
          <div class="op-mini-list">
            {(["basic","battle","combo","ultimate"] as const).map(key=>{
              const official = importedBySlot.get(key);
              return <article class="op-cardlet">
                <div class="op-line">
                  <div class="op-mini-art">{skillImage(key) ? <img class="op-skill-icon" src={skillImage(key)} loading="lazy" decoding="async" alt="" /> : slotIcons[key]}</div>
                  <div class="op-line-label"><span class="op-chip">{slotLabels[key]}</span><strong>{official?.name || "[Offizieller Skillname]"}</strong></div>
                </div>
                {official && <p class="op-muted" style="font-size:11px;margin:9px 0">SKPORT Wiki · Datenstand {gameData?.source.snapshot} · Original: {gameData?.source.language.toUpperCase()}{localized ? " · Deutsche redaktionelle Übersetzung" : ""}</p>}
                {(localized?.skills[key]?.description || official?.description) && <div class="op-skill-description op-body-copy">{localized?.skills[key]?.description || official?.description}</div>}
                {localized && official?.description && <details class="op-details"><summary>Englische Originalbeschreibung anzeigen</summary><div class="op-details-body op-body-copy">{official.description}</div></details>}
                {official && gameData ? <>
                  <div class="op-skill-selector">
                    <label for={"skill-rank-"+key}>Skillstufe</label>
                    <select id={"skill-rank-"+key} class="op-select" data-skill-rank={key}>
                      {gameData.ranks.map((rank,i)=><option value={i} selected={i===defaultSkillRank}>{rank}</option>)}
                    </select>
                  </div>
                  <div class="op-info-grid op-skill-stats">
                    {official.metrics.slice(0,4).map(metric=><div class="op-info-field">
                      <small title={metric[0]}>{trMetric(metric[0])}</small>
                      <strong data-skill-metric-value data-skill-values={JSON.stringify(metric.slice(1))}>{metric[defaultSkillRank+1]}</strong>
                    </div>)}
                  </div>
                </> : <p class="op-placeholder">[Offizielle Fertigkeitswerte folgen]</p>}
                <p class="op-body-copy"><strong>Bewertung</strong><br />{guide.skills.active[key] || "[Eigene Erklärung folgt]"}</p>
                <details class="op-details"><summary>Alle Skill-Levelwerte anzeigen</summary>
                  <div class="op-details-body">
                    {official && gameData ? <>
                      <div class="op-table-wrap">
                        <table class="op-table op-skill-matrix">
                          <thead><tr><th>Skillstufe</th>{official.metrics.map(metric=><th title={metric[0]}>{trMetric(metric[0])}</th>)}</tr></thead>
                          <tbody>{gameData.ranks.map((rank,i)=><tr><td>{rank}</td>{official.metrics.map(metric=><td>{metric[i+1]}</td>)}</tr>)}</tbody>
                        </table>
                      </div>
                      <p class="op-muted" style="font-size:11px;margin-top:10px">Die Materialkosten werden nach Zuordnung ihrer Item-IDs ergänzt.</p>
                    </> : <p class="op-placeholder">[Skilllevel und Aufstiegsmaterialien folgen]</p>}
                  </div>
                </details>
              </article>;
            })}
          </div>
        </div>
        {[
          {talentCategory:"attribute",title:"Attribut-Talent",talentLevels:attributeNodes},
          {talentCategory:"combat",title:"Combat Talents",talentLevels:combatTalents},
          {talentCategory:"ship",title:"Schiffstalente",talentLevels:shipTalents},
          {talentCategory:"other",title:"Weitere Talente (noch nicht kategorisiert)",talentLevels:otherTalents}
        ].map(({talentCategory,title,talentLevels})=><div class="op-divided">
          <h3>{title}</h3>
          {talentLevels.length ? <div class="op-two">
            {talentLevels.map(t=><article class="op-cardlet">
                <div class="op-line"><div class="op-mini-art">[Icon]</div><strong>{localized?.talents[t.id]?.name || t.name}</strong></div>
                <p class="op-muted" style="font-size:11px">{localized ? "SKPORT · deutsche Übersetzung" : "SKPORT Original · Englisch"}</p>
                <p class="op-body-copy">{trTalent(t.id,t.levels.length-1,t.levels.at(-1)?.effect || "")}</p>
                {(talentCategory === "combat" || talentCategory === "ship") && guide.skills[talentCategory === "combat" ? "combatTalents" : "shipTalents"].find(guideTalent => guideTalent.talentId === t.id)?.evaluation &&
                <p class="op-body-copy"><strong>Bewertung:</strong> {guide.skills[talentCategory === "combat" ? "combatTalents" : "shipTalents"].find(guideTalent => guideTalent.talentId === t.id)?.evaluation}</p>}
                <details class="op-details"><summary>Alle Talentstufen, Voraussetzungen & Materialien</summary>
                  <div class="op-details-body op-table-wrap"><table class="op-table">
                    <thead><tr><th>Stufe</th><th>Offizieller Effekt</th><th>Voraussetzungen</th><th>Materialien</th></tr></thead>
                    <tbody>{t.levels.map((level,i)=><tr>
                      <td>{level.name}</td><td class="op-body-copy">{trTalent(t.id,i,level.effect)}</td>
                      <td>{level.requirements.map(trReq).join(" · ") || "–"}</td><td>{formatCost(level.cost)}</td>
                    </tr>)}</tbody>
                  </table></div>
                </details>
              </article>)}
          </div> : <p class="op-placeholder">[Offizielle Talente folgen]</p>}
        </div>)}
      </section>

      <!-- 4. Waffen -->
      <section class="op-section" id="waffen">
        <h2>Waffen</h2>
        <div class="op-divided">
          <h3>Waffenempfehlungen</h3>
          {shownWeapons.length ? <div class="op-two">{shownWeapons.map(w=><article class="op-cardlet">
            <div class="op-line"><div class="op-mini-art">[Icon]</div><div class="op-line-label"><span class="op-chip">{w.label}</span><strong>{w.name}</strong></div></div>
            <p class="op-body-copy">{w.evaluation || "[Bewertung folgt]"}</p>
          </article>)}</div> : <p class="op-placeholder">[Noch keine Waffenempfehlungen]</p>}
          {guide.weapons.generalNotes && <p class="op-body-copy">{guide.weapons.generalNotes}</p>}
        </div>
        <div class="op-divided">
          <h3>Waffendetails</h3>
          {shownWeapons.length ? <>
            <div class="op-pills" aria-label="Waffe auswählen">{shownWeapons.map((w,i)=><button class="op-pill-button" type="button" data-weapon-button={w.id} aria-pressed={i===0?"true":"false"}>{w.label} {shownWeapons.filter(x=>x.label===w.label).length>1 ? "· "+w.name : ""}</button>)}</div>
            {shownWeapons.map((w,i)=><div class="op-weapon-panel op-cardlet" data-weapon-panel={w.id} hidden={i!==0}>
              <div class="op-line"><div class="op-mini-art">[Icon]</div><div class="op-line-label"><strong>{w.name}</strong><span class="op-muted">{w.label}</span></div></div>
              <div class="op-info-grid" style="margin-top:13px">{["Basis-ATK","Hauptattribut","Sekundärattribut","Waffeneffekt"].map(label=><div class="op-info-field"><small>{label}</small><strong>[Spieldaten folgen]</strong></div>)}</div>
              {w.source && <p><strong>Bezugsquelle:</strong> {w.source}</p>}
              <p class="op-body-copy"><strong>Bewertung</strong><br />{w.evaluation || missing}</p>
              <details class="op-details"><summary>Level, Veredelung & Upgrade-Materialien</summary><div class="op-details-body">[Werte, Veredelungsstufen und Materialkosten folgen]</div></details>
            </div>)}
          </> : <p class="op-placeholder">[Waffendetails werden nach dem Datenimport angezeigt]</p>}
        </div>
        <div class="op-divided"><h3>Waffenvergleich</h3>
          <p class="op-section-intro">Nur auf Basis nachvollziehbarer Berechnungen und Vergleichsbedingungen.</p>
          {weapons.some(w=>w.performancePercent!==undefined) ?
            <div class="op-table-wrap"><table class="op-table">
              <thead><tr><th>Waffe</th><th>Relative Leistung</th><th>Vergleichsbedingungen</th></tr></thead>
              <tbody>{weapons.filter(w=>w.performancePercent!==undefined).map(w=><tr><td>{w.name}</td><td>{w.performancePercent} %</td><td>{w.comparisonConditions}</td></tr>)}</tbody>
            </table></div> :
            <p class="op-placeholder">[Noch keine belastbaren Vergleichswerte]</p>}
        </div>
      </section>

      <!-- 5. Ausrüstung -->
      <section class="op-section" id="ausruestung">
        <h2>Ausrüstung</h2>
        <div class="op-divided">
          <h3>Build-Finder</h3>
          <p class="op-section-intro">Aktuell ein Layout-Prototyp. Automatische Empfehlungen nach Story- und Fabrikfortschritt folgen mit den Spieldaten.</p>
          <div class="op-two">
            <label class="op-cardlet" style="font-size:12px">Charakter- / Ausrüstungslevel
              <select class="op-select" id="op-level"><option>70</option><option>60</option><option>50</option></select>
            </label>
            <label class="op-cardlet" style="font-size:12px">Fabrikfortschritt
              <select class="op-select" id="op-factory"><option value="einstieg">Einstieg</option><option value="fortgeschritten" selected>Fortgeschritten</option><option value="maximal">Vollständig ausgebaut</option></select>
            </label>
          </div>
          <div class="op-notice" style="margin-top:12px">Ausgewählt: <strong id="op-build-config">Lv. 70 · Fortgeschritten</strong>. Freischaltungen werden später aus den Spieldaten ermittelt.</div>
          <div class="op-notice op-gear-disclaimer" style="margin-top:12px"><strong>Hinweis zur Ausrüstung:</strong> Achtet bei der Ausrüstung grundsätzlich darauf, Ausrüstungsteile zu nutzen, die das Haupt- und Sekundärattribut des jeweiligen Operators erhöhen. Das gilt besonders für Builds auf niedrigeren Leveln.</div>
          {guide.equipment.generalNotes && <p class="op-body-copy">{guide.equipment.generalNotes}</p>}
        </div>
        <div class="op-divided">
          <h3>Empfohlene Ausrüstung</h3>
          {builds.length ? <>
            <div class="op-pills" aria-label="Build auswählen">{builds.map((b,i)=><button type="button" class="op-pill-button" data-build-button={b.id} aria-pressed={i===0?"true":"false"}>{b.title}</button>)}</div>
            {builds.map((b,i)=><div class="op-build-panel op-cardlet" data-build-panel={b.id} hidden={i!==0}>
              <div class="op-subtitle"><h3 style="margin:0">{b.title}</h3><span class="op-chip">{roleLabels[b.role]}</span></div>
              <div class="op-gear-parts">{b.items.map(item=><div class="op-gear-part"><div class="op-mini-art">[Icon]</div><small>{item}</small></div>)}</div>
              {b.availableFromLevel && <p><strong>Ab Level:</strong> {b.availableFromLevel}</p>}
              {b.factoryUnlock && <p class="op-body-copy"><strong>Fabrik:</strong> {b.factoryUnlock}</p>}
              {b.teamContext && <p class="op-body-copy"><strong>Einsatzbereich:</strong> {b.teamContext}</p>}
              {b.setBonusNotes && <p class="op-body-copy"><strong>Seteffekte:</strong> {b.setBonusNotes}</p>}
              <p class="op-body-copy"><strong>Bewertung:</strong> {b.evaluation || missing}</p>
              <details class="op-details"><summary>Werte, Herstellung & Freischaltungen</summary><div class="op-details-body">
                <div class="op-table-wrap"><table class="op-table"><thead><tr><th>Ausrüstungsteil</th><th>Attribute</th><th>Materialien</th></tr></thead>
                  <tbody>{b.items.map(item=><tr><td>{item}</td><td>[Werte]</td><td>[Materialien]</td></tr>)}</tbody>
                </table></div>
                {b.craftingNotes && <p class="op-body-copy">{b.craftingNotes}</p>}
              </div></details>
            </div>)}
          </> : <p class="op-placeholder">[Noch keine Ausrüstungs-Builds]</p>}
        </div>
        <div class="op-divided"><h3>Ausrüstungsprogression</h3>
          {guide.equipment.progression.length ?
            <div class="op-mini-list">{guide.equipment.progression.map((p,i)=><div class="op-cardlet"><strong>{i+1}. {stageLabels[p.stage]}</strong><p class="op-body-copy">{p.note}</p></div>)}</div> :
            <p class="op-placeholder">[Progressionsübersicht nach Story und Fabrik folgt]</p>}
        </div>
      </section>

      <!-- 6. Potenziale -->
      <section class="op-section" id="potenziale">
        <h2>Potenziale</h2>
        <div class="op-notice"><strong>Friendly Disclaimer:</strong> Potenziale sind nice to have, aber <strong>niemals ein Muss</strong>. Zusätzliche Kopien können teuer sein und sind in der Regel nicht nötig, um einen Operator sinnvoll zu spielen.</div>
        <div class="op-divided" style="margin-top:20px">
          <h3>Potenzialübersicht</h3>
          <div class="op-pills" aria-label="Potenzial auswählen">{[1,2,3,4,5].map((n,i)=><button type="button" class="op-pill-button" data-potential-button={n} aria-pressed={i===0?"true":"false"}>P{n}</button>)}</div>
          {[1,2,3,4,5].map((n,i)=>{
            const p=potentialByLevel.get(n);
            return <div class="op-weapon-panel op-cardlet" data-potential-panel={n} hidden={i!==0}>
              <h3>P{n} – {officialPotentials.get(n)?.name || "[Offizieller Potenzialname]"}</h3>
              <p class="op-body-copy">{trPotential(n, officialPotentials.get(n)?.effect || "[Offizieller Effekt aus Spieldaten]")}</p>
              {officialPotentials.has(n) && <p class="op-muted" style="font-size:11px">SKPORT-Wirkung{localized ? " (deutsch übersetzt)" : " (EN)"}. Prozentangaben im Effekt sind keine Gesamt-DPS-Vergleiche.</p>}
              {(n===1||n===3||n===5) && <div class="op-line"><div class="op-mini-art">[Bild]</div><strong>{officialPotentials.has(n) ? "Operator-Snapshot – Grafik folgt" : "Freischaltbares Profilbild"}</strong></div>}
              <p class="op-body-copy"><strong>Bewertung:</strong> {p?.evaluation || missing}</p>
              <div class="op-two">
                <div class="op-info-field"><small>Gesamtgewinn vs. P0</small><strong>{p?.increaseOverP0Percent === undefined ? "–" : p.increaseOverP0Percent+" %"}</strong></div>
                <div class="op-info-field"><small>Zusatzgewinn durch P{n}</small><strong>{p?.increaseOverPreviousPercent === undefined ? "–" : p.increaseOverPreviousPercent+" %"}</strong></div>
              </div>
              {p?.comparisonConditions && <p class="op-muted op-body-copy">Vergleichsbedingungen: {p.comparisonConditions}</p>}
            </div>;
          })}
        </div>
        <div class="op-divided"><h3>Potenzialvergleich</h3>
          <div class="op-table-wrap"><table class="op-table"><thead><tr><th>Potenzial</th><th>Offizieller Effekt (EN)</th><th>Gemessener Gewinn vs. P0</th></tr></thead>
            <tbody>{[1,2,3,4,5].map(n=><tr><td>P{n}</td><td class="op-body-copy">{trPotential(n, officialPotentials.get(n)?.effect || "[Folgt]")}</td><td>{potentialByLevel.get(n)?.increaseOverP0Percent === undefined ? "–" : potentialByLevel.get(n)?.increaseOverP0Percent+" %"}</td></tr>)}</tbody>
          </table></div>
        </div>
        <div class="op-divided"><h3>Pull-Empfehlung</h3><p class="op-muted op-body-copy">{guide.potentials.pullAdvice || "[Empfohlener Stopp-Punkt und persönliche Einordnung folgen]"}</p></div>
      </section>

      <!-- 7. Teams -->
      <section class="op-section" id="teams">
        <h2>Teams</h2>
        <div class="op-divided">
          <h3>Teamrolle & Synergien</h3>
          {guide.teams.roles.length>0 && <div class="op-chip-row">{guide.teams.roles.map(r=><span class="op-chip">{roleLabels[r]}</span>)}</div>}
          <p class="op-muted op-body-copy">{guide.teams.introduction || "[Teamrollen und wichtige Synergien folgen]"}</p>
        </div>
        <div class="op-divided">
          <h3>Empfohlene Meta-Teams</h3>
          <p class="op-section-intro">Ausgewählte Teams mit kurzer Bewertung, ohne Pflicht-Rotationen.</p>
          {metaTeams.length ? <div class="op-two">{metaTeams.map(team=><article class="op-cardlet">
            <div class="op-subtitle"><h3 style="margin:0">{team.title}</h3><span class="op-chip">{roleLabels[team.role]}</span></div>
            <div class="op-team-operators">{team.members.map(member=><div class="op-team-slot">{member}</div>)}</div>
            <p class="op-body-copy"><strong>Bewertung:</strong> {team.evaluation || team.note || missing}</p>
            {team.buildId && <p><a class="op-link" href="#ausruestung" data-select-build={team.buildId}>Empfohlene Ausrüstung ansehen ↗</a></p>}
          </article>)}</div> : <p class="op-placeholder">[Noch keine Meta-Teams]</p>}
        </div>
        <div class="op-divided">
          <h3>Weitere Teamoptionen</h3>
          <p class="op-section-intro">Weitere Kombinationen zur Inspiration – beliebig erweiterbar.</p>
          {extraTeams.length ? <>
            {teamRoles.length > 1 && <div class="op-role-filter" aria-label="Teams nach Rolle filtern">
              <button type="button" class="op-pill-button" data-team-filter="all" aria-pressed="true">Alle</button>
              {teamRoles.map(role=><button type="button" class="op-pill-button" data-team-filter={role} aria-pressed="false">{roleLabels[role]}</button>)}
            </div>}
            <div class="op-team-scroll" style="margin-top:12px">{extraTeams.map(team=><article class="op-cardlet op-compact-team" data-team-role={team.role}>
              <div class="op-subtitle"><strong style="font-size:13px">{team.title}</strong><span class="op-chip">{roleLabels[team.role]}</span></div>
              <div class="op-team-operators">{team.members.map(member=><div class="op-team-slot">{member}</div>)}</div>
              {(team.note || team.buildId) && <p class="op-body-copy">{team.note || ""} {team.buildId && <a class="op-link" href="#ausruestung" data-select-build={team.buildId}>Ausrüstung ↗</a>}</p>}
            </article>)}</div>
          </> : <p class="op-placeholder">[Weitere Teamoptionen folgen]</p>}
        </div>
      </section>

      <!-- 8. Gameplay -->
      <section class="op-section" id="gameplay">
        <h2>Gameplay</h2>
        <p class="op-section-intro">Bestehende Gameplay-Runs mit optionalen Rotationshinweisen; jederzeit erweiterbar.</p>
        {showcases.length ? <>
          <div class="op-divided">
            {showcases.map((run,i)=>{
              const embed=youtubeEmbed(run.url);
              return <div class="op-showcase-panel op-cardlet" data-showcase-panel={run.id} hidden={i!==selectedShowcaseIndex}>
                <div class="op-subtitle"><h3 style="margin:0">{run.title}</h3><span class="op-chip">{showcaseTypeLabels[run.type]}</span></div>
                {embed ?
                  <iframe class="op-video-embed" loading="lazy" src={embed} title={run.title} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> :
                  <div class="op-video-placeholder" style="margin-top:12px"><div><span aria-hidden="true">▶</span><br />[Gameplay-Video / Clip]</div></div>
                }
                {run.url && <p><a class="op-link" href={run.url} target="_blank" rel="noopener noreferrer">Run öffnen ↗</a></p>}
                {run.description && <p class="op-body-copy">{run.description}</p>}
                {run.rotationAndTips && <details class="op-details"><summary>Rotation & Tipps</summary><div class="op-details-body"><p class="op-body-copy">{run.rotationAndTips}</p></div></details>}
              </div>;
            })}
          </div>
          <div class="op-divided"><h3>Weitere Runs</h3>
            <div class="op-media-list">{showcases.map((run,i)=><button type="button" class="op-cardlet op-showcase-button" data-showcase-button={run.id} aria-pressed={i===selectedShowcaseIndex?"true":"false"} style="text-align:left;color:inherit;font:inherit;cursor:pointer"><div class="op-faux-thumb">[Thumbnail]</div><strong style="display:block;font-size:12px;margin-top:10px">{run.title}</strong><span class="op-muted">{showcaseTypeLabels[run.type]}</span></button>)}</div>
          </div>
        </> : <p class="op-placeholder">[Noch keine Gameplay-Showcases hinterlegt]</p>}
      </section>

      <!-- 9. Fazit -->
      <section class="op-section" id="fazit">
        <h2>Fazit</h2>
        <div class="op-cardlet">
          <div class="op-line"><div class="op-mini-art">[Icon]</div><div class="op-line-label"><strong>{operatorName}</strong><span class="op-muted">{guide.conclusion.verdict || "[Gesamturteil folgt]"}</span></div></div>
          {guide.conclusion.verdict && <p class="op-body-copy">{guide.conclusion.verdict}</p>}
        </div>
        <div class="op-divided">
          <div class="op-cardlet">
            <div class="op-subtitle"><h3>Pull-Empfehlung</h3><span class="op-chip is-accent">{guide.conclusion.recommendation ? pullLabels[guide.conclusion.recommendation] : "[Empfehlung]"}</span></div>
            <p class="op-body-copy">{guide.conclusion.pullAdvice || "[Für wen lohnt sich ein Pull auf P0?]"}</p>
          </div>
          <div class="op-two" style="margin-top:13px">
            <div class="op-cardlet"><h3>✓ Für wen lohnt es sich?</h3>{guide.conclusion.recommendedFor.length ? guide.conclusion.recommendedFor.map(s=><p class="op-body-copy">{s}</p>) : <p class="op-placeholder">[Empfehlungen folgen]</p>}</div>
            <div class="op-cardlet"><h3>− Wer kann verzichten?</h3>{guide.conclusion.skipIf.length ? guide.conclusion.skipIf.map(s=><p class="op-body-copy">{s}</p>) : <p class="op-placeholder">[Einschätzung folgt]</p>}</div>
          </div>
        </div>
        {guide.conclusion.closingNote && <div class="op-divided"><h3>Abschließende Einschätzung</h3><p class="op-muted op-body-copy">{guide.conclusion.closingNote}</p></div>}
        <slot />
      </section>
    </div>

    <nav class="op-guide-toc" aria-label="Guide-Inhaltsverzeichnis">
      <strong>Guide-Inhalt</strong>
      <div class="op-guide-toc-links">{[
        ["uebersicht","1. Übersicht"],["operator-kit","2. Operator Kit"],["fertigkeiten","3. Fertigkeiten"],["waffen","4. Waffen"],
        ["ausruestung","5. Ausrüstung"],["potenziale","6. Potenziale"],["teams","7. Teams"],["gameplay","8. Gameplay"],["fazit","9. Fazit"]
      ].map(([id,label],i)=><a href={"#"+id} aria-current={i===0?"location":undefined}>{label}</a>)}</div>
    </nav>
  </div>
</main>
<script>
  // A single rank selector controls all displayed headline values in its skill.
  document.querySelectorAll<HTMLSelectElement>("[data-skill-rank]").forEach(select => {
    select.addEventListener("change", () => {
      const card = select.closest(".op-cardlet");
      const levelIndex = Number(select.value);
      card?.querySelectorAll<HTMLElement>("[data-skill-metric-value]").forEach(value => {
        const levels = JSON.parse(value.dataset.skillValues || "[]") as string[];
        value.textContent = levels[levelIndex] || "–";
      });
    });
  });
  // Keep the guide navigation in sync with the visible section.
  const toc = document.querySelector<HTMLElement>(".op-guide-toc");
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".op-guide-toc-links a[href^='#']"));
  const guideSections = tocLinks.map(link => document.getElementById(link.hash.slice(1))).filter((section): section is HTMLElement => Boolean(section));
  let scrollSpyPending = false;
  function updateGuideLocation() {
    scrollSpyPending = false;
    if (!toc || !guideSections.length) return;
    const compact = window.matchMedia("(max-width: 1050px)").matches;
    const threshold = compact ? toc.getBoundingClientRect().bottom + 16 : 175;
    let currentId = guideSections[0].id;
    for (const section of guideSections) {
      if (section.getBoundingClientRect().top <= threshold) currentId = section.id;
      else break;
    }
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 5) {
      currentId = guideSections[guideSections.length - 1].id;
    }
    tocLinks.forEach(link => {
      const active = link.hash === "#" + currentId;
      if (active) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  }
  function scheduleGuideLocation() {
    if (scrollSpyPending) return;
    scrollSpyPending = true;
    window.requestAnimationFrame(updateGuideLocation);
  }
  window.addEventListener("scroll", scheduleGuideLocation, { passive: true });
  window.addEventListener("resize", scheduleGuideLocation);
  window.addEventListener("load", scheduleGuideLocation);
  tocLinks.forEach(link => link.addEventListener("click", () => {
    tocLinks.forEach(item => item.removeAttribute("aria-current"));
    link.setAttribute("aria-current", "location");
  }));
  scheduleGuideLocation();

  function setupButtons(buttonAttribute: string, panelAttribute: string) {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-" + buttonAttribute + "]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-" + panelAttribute + "]"));
    function activate(id: string) {
      buttons.forEach(button => button.setAttribute("aria-pressed", String(button.dataset[buttonAttribute.replace(/-([a-z])/g,(_,c)=>c.toUpperCase())]===id)));
      panels.forEach(panel => panel.hidden = panel.dataset[panelAttribute.replace(/-([a-z])/g,(_,c)=>c.toUpperCase())]!==id);
    }
    buttons.forEach(button=>button.addEventListener("click",()=>activate(button.getAttribute("data-"+buttonAttribute)||"")));
    return activate;
  }
  setupButtons("weapon-button","weapon-panel");
  const showBuild = setupButtons("build-button","build-panel");
  setupButtons("potential-button","potential-panel");
  setupButtons("showcase-button","showcase-panel");
  document.querySelectorAll<HTMLButtonElement>("[data-team-filter]").forEach(button=>{
    button.addEventListener("click",()=>{
      const value=button.dataset.teamFilter||"all";
      document.querySelectorAll<HTMLButtonElement>("[data-team-filter]").forEach(b=>b.setAttribute("aria-pressed",String(b===button)));
      document.querySelectorAll<HTMLElement>("[data-team-role]").forEach(card=>card.hidden=value!=="all"&&card.dataset.teamRole!==value);
    });
  });
  document.querySelectorAll<HTMLAnchorElement>("[data-select-build]").forEach(link=>{
    link.addEventListener("click",()=>showBuild(link.dataset.selectBuild||"main"));
  });
  const level=document.querySelector<HTMLSelectElement>("#op-level");
  const factory=document.querySelector<HTMLSelectElement>("#op-factory");
  const config=document.querySelector<HTMLElement>("#op-build-config");
  function updateConfig(){if(config&&level&&factory){config.textContent="Lv. "+level.value+" · "+(factory.selectedOptions[0]?.textContent||"");}}
  level?.addEventListener("change",updateConfig);
  factory?.addEventListener("change",updateConfig);
</script>
