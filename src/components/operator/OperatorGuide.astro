---
import type { OperatorGuideProps } from "../../lib/endfield/operatorGuideModel";
import { createOperatorGuideModel } from "../../lib/endfield/operatorGuideModel";
import OperatorOverview from "./sections/OperatorOverview.astro";
import OperatorKit from "./sections/OperatorKit.astro";
import OperatorSkills from "./sections/OperatorSkills.astro";
import OperatorWeapons from "./sections/OperatorWeapons.astro";
import OperatorEquipment from "./sections/OperatorEquipment.astro";
import OperatorPotentials from "./sections/OperatorPotentials.astro";
import OperatorTeams from "./sections/OperatorTeams.astro";
import OperatorGameplay from "./sections/OperatorGameplay.astro";
import OperatorConclusion from "./sections/OperatorConclusion.astro";

interface Props extends OperatorGuideProps {}
const model = createOperatorGuideModel(Astro.props);
const translateUi=(value:string)=>guideText(model.lang,value);
const { guide, operatorName, preview, localized } = model;
const isEnglish=model.lang==="en";
import { guideText } from "../../lib/i18n/guideUi";
---
<main class="op-page section-wrap">
  <nav class="op-breadcrumb" aria-label={isEnglish?"Breadcrumb":"Brotkrumennavigation"}>
    <a href={isEnglish?"/en/endfield/":"/endfield/"}>Endfield</a><span aria-hidden="true">›</span>
    <a href={isEnglish?"/en/endfield/operators/":"/endfield/operatoren/"}>{translateUi("Operatoren")}</a><span aria-hidden="true">›</span>
    <span aria-current="page">{operatorName}</span>
  </nav>
  {preview && <div class="op-notice op-preview-banner" role="status">{isEnglish?"Layout preview: Some details for "+operatorName+" are still being added. Square brackets indicate placeholders.":"Layout-Vorschau: Für "+operatorName+" sind noch nicht alle Daten eingepflegt. Eckige Klammern kennzeichnen Platzhalter."}</div>}
  {localized && <p class="op-muted op-locale-note">{translateUi("SKPORT-Datenstand:")} {localized.sourceSnapshot}</p>}
  <div class="op-guide">
    <div class="op-guide-content">
      <OperatorOverview model={model} />
      <OperatorKit model={model} />
      <OperatorSkills model={model} />
      <OperatorWeapons model={model} />
      <OperatorEquipment model={model} />
      <OperatorPotentials model={model} />
      <OperatorTeams model={model} />
      <OperatorGameplay model={model} />
      <OperatorConclusion model={model} ><slot /></OperatorConclusion>
    </div>

    <nav class="op-guide-toc" aria-label="Guide-Inhaltsverzeichnis">
      <strong>{translateUi("Guide-Inhalt")}</strong>
      <div class="op-guide-toc-links">{[
        ["uebersicht",isEnglish?"1. Overview":"1. Übersicht"],["operator-kit","2. Operator Kit"],["fertigkeiten",isEnglish?"3. Skills":"3. Fertigkeiten"],["waffen",isEnglish?"4. Weapons":"4. Waffen"],
        ["ausruestung",isEnglish?"5. Equipment":"5. Ausrüstung"],["potenziale",isEnglish?"6. Potentials":"6. Potenziale"],["teams","7. Teams"],["gameplay","8. Gameplay"],["fazit",isEnglish?"9. Conclusion":"9. Fazit"]
      ].map(([id,label],i)=><a href={"#"+id} aria-current={i===0?"location":undefined}>{label}</a>)}</div>
    </nav>
  </div>
</main>
<script>
  import { evaluateBuildAvailability, FACTORY_COMPONENT_STAGES, DEFAULT_FACTORY_COMPONENT } from "../../lib/endfield/buildFinder.mjs";
  import { STORY_BUILD_STATUSES, MAX_AUTHORITY_LEVEL, validAuthorityLevel } from "../../lib/endfield/buildStoryProgress.mjs";
  import { getMaxBuildFinderPreset, getMinBuildFinderPreset } from "../../lib/endfield/buildFinderDefaults.mjs";
  const isEn=document.documentElement.lang==="en";
  const msg=(de:string,en:string)=>isEn?en:de;
  // A single rank selector controls all displayed headline values in its skill.
  document.querySelectorAll<HTMLSelectElement>("[data-skill-rank]").forEach(select => {
    select.addEventListener("change", () => {
      const card = select.closest(".op-cardlet");
      const levelIndex = Number(select.value);
      card?.querySelectorAll<HTMLElement>("[data-skill-metric-value]").forEach(value => {
        const levels = JSON.parse(value.dataset.skillValues || "[]") as string[];
        value.textContent = levels[levelIndex] || "–";
      });
    });
  });
  // Keep the guide navigation in sync with the visible section.
  const toc = document.querySelector<HTMLElement>(".op-guide-toc");
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".op-guide-toc-links a[href^='#']"));
  const guideSections = tocLinks.map(link => document.getElementById(link.hash.slice(1))).filter((section): section is HTMLElement => Boolean(section));
  // Short near-footer sections (e.g. Gameplay before Fazit) cannot always
  // reach the fixed scroll-margin position: the browser clamps at page bottom.
  // Preserve a *deliberately chosen* TOC anchor until the user scrolls again.
  // Otherwise scroll-spy incorrectly re-selects Teams after clicking Gameplay.
  let scrollSpyPending = false;
  let selectedByClick: string | null = null;
  function setGuideLocation(id: string) {
    tocLinks.forEach(link => {
      if (link.hash === "#" + id) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  }
  function updateGuideLocation() {
    scrollSpyPending = false;
    if (!toc || !guideSections.length) return;
    const compact = window.matchMedia("(max-width: 1050px)").matches;
    const threshold = compact ? toc.getBoundingClientRect().bottom + 16 : 175;
    let currentId = guideSections[0].id;
    for (const section of guideSections) {
      if (section.getBoundingClientRect().top <= threshold) currentId = section.id;
      else break;
    }
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 5) {
      currentId = guideSections[guideSections.length - 1].id;
    }
    if (selectedByClick) {
      const target = document.getElementById(selectedByClick);
      const bounds = target?.getBoundingClientRect();
      // A click-selected section that is visible remains selected, even when
      // clamped by the end of the document.
      if (bounds && bounds.bottom > threshold && bounds.top < window.innerHeight - 12) {
        currentId = selectedByClick;
      } else if (bounds && bounds.top < window.innerHeight && bounds.bottom > 0) {
        currentId = selectedByClick;
      } else {
        selectedByClick = null;
      }
    }
    setGuideLocation(currentId);
  }
  function scheduleGuideLocation() {
    if (scrollSpyPending) return;
    scrollSpyPending = true;
    window.requestAnimationFrame(updateGuideLocation);
  }
  window.addEventListener("scroll", scheduleGuideLocation, { passive: true });
  window.addEventListener("resize", scheduleGuideLocation);
  window.addEventListener("load", scheduleGuideLocation);
  for (const eventName of ["wheel", "touchstart", "pointerdown", "keydown"]) {
    window.addEventListener(eventName, () => { selectedByClick = null; }, { passive: true });
  }
  tocLinks.forEach(link => link.addEventListener("click", event => {
    const id = link.hash.slice(1);
    const destination = document.getElementById(id);
    if (!destination) return;
    event.preventDefault();
    selectedByClick = id;
    // Use the existing scroll-margin-top CSS to clear the sticky navigation.
    destination.scrollIntoView({ behavior: "auto", block: "start" });
    if (window.location.hash !== link.hash) window.history.pushState(null, "", link.hash);
    setGuideLocation(id);
    scheduleGuideLocation();
  }));
  scheduleGuideLocation();

  function setupButtons(buttonAttribute: string, panelAttribute: string) {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-" + buttonAttribute + "]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-" + panelAttribute + "]"));
    function activate(id: string) {
      buttons.forEach(button => button.setAttribute("aria-pressed", String(button.dataset[buttonAttribute.replace(/-([a-z])/g,(_,c)=>c.toUpperCase())]===id)));
      panels.forEach(panel => panel.hidden = panel.dataset[panelAttribute.replace(/-([a-z])/g,(_,c)=>c.toUpperCase())]!==id);
    }
    buttons.forEach(button=>button.addEventListener("click",()=>activate(button.getAttribute("data-"+buttonAttribute)||"")));
    return activate;
  }
  setupButtons("weapon-button","weapon-panel");
  const showBuild = setupButtons("build-button","build-panel");
  setupButtons("potential-button","potential-panel");
  setupButtons("showcase-button","showcase-panel");
  document.querySelectorAll<HTMLButtonElement>("[data-team-filter]").forEach(button=>{
    button.addEventListener("click",()=>{
      const value=button.dataset.teamFilter||"all";
      document.querySelectorAll<HTMLButtonElement>("[data-team-filter]").forEach(b=>b.setAttribute("aria-pressed",String(b===button)));
      document.querySelectorAll<HTMLElement>("[data-team-role]").forEach(card=>card.hidden=value!=="all"&&card.dataset.teamRole!==value);
    });
  });
  document.querySelectorAll<HTMLAnchorElement>("[data-select-build]").forEach(link=>{
    link.addEventListener("click",()=>{
      const id=link.dataset.selectBuild||"";
      const choice=Array.from(document.querySelectorAll<HTMLButtonElement>("[data-build-button]"))
        .find(button=>button.dataset.buildButton===id);
      if(!choice)return;
      // Meta cards and team links must reveal the native disclosure first.
      const finder=document.querySelector<HTMLDetailsElement>("#build-finder");
      if(finder&&!finder.open)finder.open=true;
      if(choice.hidden){
        const checkbox=document.querySelector<HTMLInputElement>("#op-build-show-all");
        if(checkbox)checkbox.checked=true;
        checkbox?.dispatchEvent(new Event("change"));
      }
      showBuild(id);
    });
  });
  const level=document.querySelector<HTMLSelectElement>("#op-level");
  const factory=document.querySelector<HTMLSelectElement>("#op-factory");
  const region=document.querySelector<HTMLSelectElement>("#op-story-region");
  const authority=document.querySelector<HTMLInputElement>("#op-authority-level");
  const stock=document.querySelector<HTMLSelectElement>("#op-stock-level");
  const areaCheckboxes=Array.from(document.querySelectorAll<HTMLInputElement>("[data-story-area]"));
  const blueprintCheckboxes=Array.from(document.querySelectorAll<HTMLInputElement>("[data-blueprint-owned]"));
  const areaCounter=document.querySelector<HTMLElement>("#op-story-area-counter");
  const regionGroups=Array.from(document.querySelectorAll<HTMLElement>("[data-story-region-group]"));
  const config=document.querySelector<HTMLElement>("#op-build-config");
  const showAllBuilds=document.querySelector<HTMLInputElement>("#op-build-show-all");
  const buildResult=document.querySelector<HTMLElement>("#op-build-results");
  const buildEmpty=document.querySelector<HTMLElement>("#op-build-empty");
  const buildButtons=Array.from(document.querySelectorAll<HTMLButtonElement>("[data-build-button]"));
  const factoryIcon=document.querySelector<HTMLImageElement>("#op-factory-icon");
  const savedKey="ag0n1st:endfield:build-story-progress:v2";
  const legacySavedKey="ag0n1st:endfield:build-story-progress:v1";
  const resetProgress=document.querySelector<HTMLButtonElement>("#op-progress-reset");
  const minProgress=document.querySelector<HTMLButtonElement>("#op-progress-min");
  let selectionMode:"max"|"min"="max";
  const ownedBlueprintIds=new Set<string>();
  // In min mode remember opt-ins from ALL operators, not just visible cards.
  const selectedBlueprintIds=new Set<string>();
  // v2 persists DESELECTED IDs. New Gear/areas in future guides therefore
  // default to available without overwriting a player's explicit opt-outs.
  const unselectedBlueprintIds=new Set<string>();
  const lockedAreaIds=new Set<string>();
  const statusText:Record<string,string>={
    available:msg("Passend","Available"), "level-locked":msg("Level zu niedrig","Level Too Low"),
    "component-locked":msg("Komponente fehlt","Missing Component"), ...STORY_BUILD_STATUSES,
    "region-locked":msg("Region fehlt","Region Locked"),
    "area-unconfirmed":msg("Gebiet nicht bestätigt","Area Unconfirmed"),
    "acquisition-locked":msg("Freischaltung fehlt","Not Unlocked"),
    "blueprint-unconfirmed":msg("Blaupause nicht bestätigt","Blueprint Unconfirmed"),
    "story-unverified":msg("Story/Fundort ungeklärt","Story/Location Unverified"),
    unverified:msg("Rezept/Daten ungeklärt","Recipe/Data Unverified")
  };
  const allGearIds=()=>[...new Set(blueprintCheckboxes
    .filter(input=>!input.disabled && /^\d+$/.test(input.dataset.blueprintOwned||""))
    .map(input=>input.dataset.blueprintOwned||""))];

  // This is a user-friendly MAXIMAL ASSUMPTION, NOT synced game ownership.
  function applyMaxPreset(){
    selectionMode="max";
    const defaults=getMaxBuildFinderPreset({
      regionIds:Array.from(region?.options||[]).map(option=>option.value).filter(Boolean),
      areaIds:areaCheckboxes.map(input=>input.value),
      blueprintIds:allGearIds(),
      stockLevels:Array.from(stock?.options||[]).map(option=>option.value).filter(Boolean)
    });
    if(level)level.value=String(defaults.level);
    if(factory)factory.value=defaults.factoryComponent;
    if(region)region.value=defaults.storyProgress.regionId;
    if(authority)authority.value=String(defaults.storyProgress.authorityLevel);
    if(stock)stock.value=defaults.storyProgress.stockRedistributionLevel===null
      ?"":String(defaults.storyProgress.stockRedistributionLevel);
    lockedAreaIds.clear();
    areaCheckboxes.forEach(input=>input.checked=true);
    unselectedBlueprintIds.clear();
    ownedBlueprintIds.clear();
    selectedBlueprintIds.clear();
    for(const id of defaults.storyProgress.acquiredGearBlueprintIds)ownedBlueprintIds.add(id);
    blueprintCheckboxes.forEach(input=>input.checked=ownedBlueprintIds.has(input.dataset.blueprintOwned||""));
  }

  function applyMinPreset(){
    selectionMode="min";
    const defaults=getMinBuildFinderPreset({
      levelOptions:Array.from(level?.options||[]).map(option=>option.value)
    });
    if(level)level.value=String(defaults.level);
    if(factory)factory.value=defaults.factoryComponent;
    if(region)region.value=defaults.storyProgress.regionId;
    if(authority)authority.value="";
    if(stock)stock.value="";
    lockedAreaIds.clear();
    unselectedBlueprintIds.clear();
    ownedBlueprintIds.clear();
    selectedBlueprintIds.clear();
    areaCheckboxes.forEach(input=>input.checked=false);
    blueprintCheckboxes.forEach(input=>input.checked=false);
  }

  function restoreStoryProgress(){
    applyMaxPreset();
    try{
      // Preserve explicit past choices when upgrading, including empty picks.
      const raw=window.localStorage.getItem(savedKey)??window.localStorage.getItem(legacySavedKey);
      if(!raw)return;
      const saved=JSON.parse(raw);
      if(!saved || ![1,2].includes(saved.version))return;
      const hasMinimalPreset=saved.version===2 && saved.selectionMode==="min";
      if(hasMinimalPreset)applyMinPreset();
      if(region && typeof saved.regionId==="string" &&
         Array.from(region.options).some(option=>option.value===saved.regionId))
        region.value=saved.regionId;
      lockedAreaIds.clear();
      if(hasMinimalPreset){
        const selectedAreas=new Set(Array.isArray(saved.selectedAreaIds)?saved.selectedAreaIds:[]);
        areaCheckboxes.forEach(input=>input.checked=selectedAreas.has(input.value));
      }else{
        if(saved.version===2){
          for(const id of Array.isArray(saved.lockedAreaIds)?saved.lockedAreaIds:[])
            if(typeof id==="string" && lockedAreaIds.size<500)lockedAreaIds.add(id);
        }else{
          const unlocked=new Set(Array.isArray(saved.unlockedAreaIds)?saved.unlockedAreaIds:[]);
          areaCheckboxes.forEach(input=>{
            if(!unlocked.has(input.value))lockedAreaIds.add(input.value);
          });
        }
        areaCheckboxes.forEach(input=>input.checked=!lockedAreaIds.has(input.value));
      }
      unselectedBlueprintIds.clear();
      ownedBlueprintIds.clear();
      if(hasMinimalPreset){
        selectedBlueprintIds.clear();
        for(const id of Array.isArray(saved.selectedGearBlueprintIds)?saved.selectedGearBlueprintIds:[])
          if(typeof id==="string" && /^\d+$/.test(id) && selectedBlueprintIds.size<500)
            selectedBlueprintIds.add(id);
        for(const id of allGearIds())
          if(selectedBlueprintIds.has(id))ownedBlueprintIds.add(id);
      }else{
        if(saved.version===2){
          for(const id of Array.isArray(saved.unselectedGearBlueprintIds)?saved.unselectedGearBlueprintIds:[])
            if(typeof id==="string" && /^\d+$/.test(id) && unselectedBlueprintIds.size<500)
              unselectedBlueprintIds.add(id);
        }else{
          const acquired=new Set(Array.isArray(saved.acquiredGearBlueprintIds)?saved.acquiredGearBlueprintIds:[]);
          for(const id of allGearIds())
            if(!acquired.has(id))unselectedBlueprintIds.add(id);
        }
        for(const id of allGearIds())
          if(!unselectedBlueprintIds.has(id))ownedBlueprintIds.add(id);
      }
      blueprintCheckboxes.forEach(input=>input.checked=ownedBlueprintIds.has(input.dataset.blueprintOwned||""));
      if(authority)
        authority.value=validAuthorityLevel(saved.authorityLevel)?String(saved.authorityLevel):"";
      if(stock)
        stock.value=Array.from(stock.options).some(x=>x.value===String(saved.stockRedistributionLevel))
          ?String(saved.stockRedistributionLevel):"";
      if(saved.version===2){
        if(level && Array.from(level.options).some(x=>x.value===String(saved.level)))
          level.value=String(saved.level);
        if(factory && FACTORY_COMPONENT_STAGES.some(stage=>stage.id===saved.factoryComponent))
          factory.value=saved.factoryComponent;
      }
    }catch{/* Damaged/unavailable localStorage: retain maximum preset. */}
  }
  function storySelection(){
    const number=authority?.value.trim()||"";
    const stockValue=stock?.value||"";
    return {
      regionId:region?.value||"",
      unlockedAreaIds:areaCheckboxes.filter(x=>x.checked).map(x=>x.value),
      acquiredGearBlueprintIds:[...ownedBlueprintIds],
      authorityLevel:number!==""&&validAuthorityLevel(Number(number))?Number(number):null,
      stockRedistributionLevel:stockValue!==""?Number(stockValue):null
    };
  }
  function saveStoryProgress(){
    try{
      window.localStorage.setItem(savedKey,JSON.stringify({
        version:2,
        selectionMode,
        // Max mode saves explicit opt-outs; min mode saves explicit opt-ins.
        // Thus NEW Gear and areas stay off in min mode across other guides.
        selectedAreaIds:selectionMode==="min"
          ?areaCheckboxes.filter(input=>input.checked).map(input=>input.value):[],
        selectedGearBlueprintIds:selectionMode==="min"?[...selectedBlueprintIds]:[],
        regionId:region?.value||"",
        lockedAreaIds:[...lockedAreaIds],
        unselectedGearBlueprintIds:[...unselectedBlueprintIds],
        authorityLevel:storySelection().authorityLevel,
        stockRedistributionLevel:storySelection().stockRedistributionLevel,
        level:level?Number(level.value):null,
        factoryComponent:factory?.value||DEFAULT_FACTORY_COMPONENT
      }));
      window.localStorage.removeItem(legacySavedKey);
    }catch{/* Local storage disabled: changes remain within this tab. */}
  }
  function updateConfig(){
    if(!level||!factory)return;
    const component=FACTORY_COMPONENT_STAGES.find(stage=>stage.id===factory.value)
      ??FACTORY_COMPONENT_STAGES.find(stage=>stage.id===DEFAULT_FACTORY_COMPONENT);
    if(factoryIcon&&component){
      factoryIcon.src="/images/endfield/materials/"+component.itemId+".webp";
      factoryIcon.alt=component.label;factoryIcon.title=component.label;
    }
    const progress=storySelection();
    const regionLabel=region?.selectedOptions[0]?.textContent?.trim()||msg("Nicht festgelegt","Not Set");
    const count=areaCheckboxes.filter(x=>x.checked && x.dataset.areaRegion===region?.value).length;
    if(areaCounter)areaCounter.textContent=count+msg(" freigeschaltet"," unlocked");
    regionGroups.forEach(group=>group.hidden=group.dataset.storyRegionGroup!==region?.value);
    if(config)config.textContent="Lv. "+level.value+" · "+(component?.label||"")+
      " · "+(component?.phase||"")+" · Story: "+regionLabel+" ("+count+msg(" Gebiete"," areas")+")";
    const statuses=buildButtons.map(button=>{
      let requirement=null;
      try{requirement=JSON.parse(button.dataset.buildRequirements||"null");}catch{}
      const result=evaluateBuildAvailability(requirement,{
        level:Number(level.value),factoryComponent:factory.value,
        storyProgress:progress
      });
      button.dataset.availability=result.status;
      button.title=result.reason;
      const status=button.querySelector<HTMLElement>("[data-build-status-label]");
      if(status)status.textContent=statusText[result.status]||result.reason;
      button.hidden=result.status!=="available"&&!showAllBuilds?.checked;
      const panel=Array.from(document.querySelectorAll<HTMLElement>("[data-build-panel]"))
        .find(p=>p.dataset.buildPanel===button.dataset.buildButton);
      const reason=panel?.querySelector<HTMLElement>("[data-build-reason]");
      if(reason){
        const checked=result.parts?.filter((part:{status:string})=>part.status==="available").length??0;
        reason.textContent=result.status==="available"
          ?msg("Alle vier Blaupausen sind in deiner Auswahl aktiviert; Level und Komponenten reichen aus. (Kein Kontonachweis.)","All four blueprints are selected; level and components are sufficient. (Not verified against your account.)")
          :(isEn?statusText[result.status]+" · "+checked+"/4 blueprints marked as owned.":result.reason+" · "+checked+"/4 Blaupausen als erhalten markiert.");
      }
      return result.status;
    });
    const available=statuses.filter(x=>x==="available").length;
    const uncertain=statuses.filter(x=>[
      "unverified","story-unverified","blueprint-unconfirmed","area-unconfirmed"
    ].includes(x)).length;
    const locked=statuses.length-available-uncertain;
    if(buildResult)buildResult.textContent=statuses.length
      ?available+msg(" passend · "," available · ")+locked+msg(" gesperrt · "," locked · ")+uncertain+msg(" noch nicht bestätigt"," unverified")
      :msg("Noch keine redaktionellen Ausrüstungs-Builds hinterlegt.","No Editorial Gear Builds Added Yet.");
    const visible=buildButtons.filter(button=>!button.hidden);
    if(buildEmpty)buildEmpty.hidden=visible.length>0;
    const previous=visible.find(button=>button.getAttribute("aria-pressed")==="true");
    const selected=previous??visible[0];
    if(selected)showBuild(selected.dataset.buildButton||"");
    else{
      buildButtons.forEach(button=>button.setAttribute("aria-pressed","false"));
      document.querySelectorAll<HTMLElement>("[data-build-panel]")
        .forEach(panel=>panel.hidden=true);
    }
  }

  // New visitors start with maximum assumptions; previously saved edits win.
  restoreStoryProgress();
  level?.addEventListener("change",()=>{saveStoryProgress();updateConfig();});
  factory?.addEventListener("change",()=>{saveStoryProgress();updateConfig();});
  showAllBuilds?.addEventListener("change",updateConfig);
  region?.addEventListener("change",()=>{saveStoryProgress();updateConfig();});
  authority?.addEventListener("change",()=>{
    if(authority.value.trim()!==""){
      const value=Number(authority.value);
      authority.value=Number.isFinite(value)
        ?String(Math.max(0,Math.min(MAX_AUTHORITY_LEVEL,Math.floor(value)))):"";
    }
    saveStoryProgress();updateConfig();
  });
  stock?.addEventListener("change",()=>{saveStoryProgress();updateConfig();});
  areaCheckboxes.forEach(input=>input.addEventListener("change",()=>{
    if(input.checked)lockedAreaIds.delete(input.value);
    else lockedAreaIds.add(input.value);
    saveStoryProgress();updateConfig();
  }));
  blueprintCheckboxes.forEach(input=>input.addEventListener("change",()=>{
    const gearId=input.dataset.blueprintOwned;
    blueprintCheckboxes.filter(other=>other.dataset.blueprintOwned===gearId)
      .forEach(other=>other.checked=input.checked);
    if(gearId && /^\d+$/.test(gearId)){
      if(selectionMode==="min"){
        if(input.checked)selectedBlueprintIds.add(gearId);
        else selectedBlueprintIds.delete(gearId);
      }
      if(input.checked){
        unselectedBlueprintIds.delete(gearId);
        ownedBlueprintIds.add(gearId);
      }else{
        unselectedBlueprintIds.add(gearId);
        ownedBlueprintIds.delete(gearId);
      }
    }
    saveStoryProgress();updateConfig();
  }));
  minProgress?.addEventListener("click",()=>{
    applyMinPreset();
    saveStoryProgress();
    updateConfig();
  });
  resetProgress?.addEventListener("click",()=>{
    try{
      window.localStorage.removeItem(savedKey);
      window.localStorage.removeItem(legacySavedKey);
    }catch{}
    applyMaxPreset();
    updateConfig();
  });
  updateConfig();
</script>

